---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PhysiologicalSighTimer from '../components/PhysiologicalSighTimer.astro';
import PhysiologicalSessionPresets from '../components/PhysiologicalSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: 'Physiological Sigh', url: '/physiological-sigh' },
];

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HarmonyBreath — Physiological Sigh & Cyclic Sighing Timer",
    "alternateName": "HarmonyBreath Physiological Sigh Guided Breathwork App",
    "description": "Free online guided Physiological Sigh timer. Practice cyclic sighing with double inhales and long exhales to quickly reduce stress, lower respiratory rate, and improve mood.",
    "url": "https://harmonybreath.com/physiological-sigh",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided Physiological Sigh timer with double inhale + extended exhale visual cues",
      "Customizable timing parameters (first inhale, top-up inhale, long exhale, and cycle counts)",
      "Evidence-backed cyclic sighing protocol for rapid stress relief",
      "Ambient soundscape player with real-time phase indicators",
      "Private browser-local session analytics with zero data tracking"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HarmonyBreath Physiological Sigh Timer",
    "description": "Free online physiological sigh timer for practicing cyclic sighing. A structured double-inhale and long-exhale pattern for immediate relaxation and mood enhancement.",
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the Huberman psychological sigh?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The physiological sigh (often called the psychological sigh) is a fast stress-relief breathing pattern consisting of two quick inhales and one long exhale, popularized by Stanford neuroscientist Dr. Andrew Huberman as the most effective real-time method to lower stress."
        }
      },
      {
        "@type": "Question",
        "name": "Does the physiological sigh actually work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, scientific research validates its effectiveness. A landmark study from Stanford Medicine demonstrated that practicing cyclic sighing for just 5 minutes a day rapidly reduces anxiety, lowers heart rate and respiratory rate, and improves mood better than mindfulness meditation."
        }
      },
      {
        "@type": "Question",
        "name": "How many physiological sighs should you do?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For immediate stress relief during acute anxiety, performing 1 to 3 physiological sighs is sufficient to quickly calm the nervous system. For sustained mood elevation and long-term stress resilience, practicing cyclic sighing for 5 minutes daily is recommended."
        }
      },
      {
        "@type": "Question",
        "name": "Why does it use a double inhale?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Taking a second, sharp \"sip\" of air pops open deflated lung air sacs (alveoli) and inflates the lungs completely, maximizing airway volume and gas exchange before initiating an extended, calming exhalation."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between a physiological sigh and cyclic sighing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A physiological sigh refers to the individual breath cycle of two inhales followed by one long exhale. Cyclic sighing means repeating that double-inhale pattern continuously for a period of time, such as 3 to 5 minutes."
        }
      },
      {
        "@type": "Question",
        "name": "Is physiological sighing safe?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Physiological sighing is a safe, natural exercise for most people. Take a gentle second sharp sip of air without forcing or straining. If you feel lightheaded, pause and return to normal breathing. Never practice breathwork while driving or operating machinery."
        }
      }
    ]
  }
];
---

<Layout
  title="Physiological Sigh & Cyclic Sighing Timer | HarmonyBreath"
  description="Master the Physiological Sigh (Cyclic Sighing) with our free guided timer. Double inhale followed by a long exhale for rapid stress relief and relaxation based on Stanford research."
  keywords="physiological sigh, cyclic sighing, physiological sigh timer, cyclic sighing timer, huberman sigh, double inhale breathing, stress relief breathing, free breathwork app"
  canonicalUrl="https://harmonybreath.com/physiological-sigh/"
  image="https://harmonybreath.com/og-image.png"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <!-- Top Navigation & Hero Header -->
    <section class="w-full max-w-4xl mx-auto pt-8 pb-6 px-4 text-center space-y-4">
      <div class="flex items-center justify-center gap-2 mb-2">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-neutral-800 bg-neutral-900/80 text-neutral-400 hover:text-white text-xs font-mono transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to All Techniques
        </a>
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-400/30 bg-emerald-400/10 text-emerald-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Physiological Sigh / Cyclic Sighing
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-normal text-white leading-tight">
        Physiological Sigh <br />
        <span class="gradient-text-develop">Free Guided Cyclic Sighing Timer</span>
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-neutral-400 leading-relaxed font-sans font-light">
        Reset your nervous system on demand with our free online <strong class="text-neutral-200 font-medium">Physiological Sigh timer</strong>. Featuring two consecutive inhales through the nose followed by a prolonged exhale through the mouth, <strong class="text-neutral-200 font-medium">cyclic sighing</strong> is an evidence-backed breathwork method for rapid stress reduction and mood elevation.
      </p>
    </section>

    <!-- Main Interactive Physiological Sigh Timer Component -->
    <PhysiologicalSighTimer />

    <!-- Session Presets -->
    <PhysiologicalSessionPresets />

    <!-- Analytics Stats Panel -->
    <AnalyticsPanel exerciseId="physiological-sigh" />

    <!-- Detailed Science & Technique Guide Section -->
    <section class="w-full max-w-4xl mx-auto px-4 py-8">
      <div class="bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-8 backdrop-blur-xl space-y-8 text-neutral-300 font-sans font-light text-sm sm:text-base leading-relaxed">
        
        <!-- Section Header -->
        <div class="flex items-center gap-3 border-b border-neutral-800 pb-4">
          <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-400 font-bold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Understanding the Physiological Sigh</h2>
            <p class="text-xs font-mono text-neutral-400">The science and practice of double-inhale breathing</p>
          </div>
        </div>

        <!-- 1. What is a Physiological Sigh? -->
        <div class="space-y-3">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            What is a Physiological Sigh?
          </h3>
          <p>
            A physiological sigh is a natural breathing pattern involving <strong>two consecutive inhales followed by a long exhale</strong>. The first inhale fills most of your lungs, followed by a second, sharp "sip" of air to inflate the lungs completely before a prolonged, slow exhalation.
          </p>
          <div class="p-4 rounded-2xl bg-neutral-900/60 border border-neutral-800 font-mono text-xs sm:text-sm text-center text-emerald-300">
            Inhale (Nose) &nbsp;→&nbsp; Sharp "Sip" Inhale (Nose) &nbsp;→&nbsp; Long Exhale (Mouth)
          </div>
          <p>
            This resembles the spontaneous sighs humans produce naturally throughout the day and during deep sleep. Modern breathwork protocol turns this automatic respiratory response into a deliberate, repeatable exercise known as <strong>cyclic sighing</strong>.
          </p>
        </div>

        <!-- 2. How to Perform it -->
        <div class="space-y-4 pt-4 border-t border-neutral-900">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            How to Perform Cyclic Sighing
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
              <div class="text-xs font-mono uppercase text-emerald-400 font-semibold">1. First Inhale</div>
              <p class="text-xs text-neutral-300">Take a comfortable, relatively deep inhale through your nose filling your lungs about 70-80%.</p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
              <div class="text-xs font-mono uppercase text-cyan-400 font-semibold">2. Second Inhale</div>
              <p class="text-xs text-neutral-300">Without exhaling first, take a second, sharp "sip" of air through your nose to inflate the lungs completely.</p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
              <div class="text-xs font-mono uppercase text-teal-400 font-semibold">3. Long Exhale</div>
              <p class="text-xs text-neutral-300">Slowly exhale completely through your mouth, letting your breath flow out longer than the inhalations combined.</p>
            </div>
          </div>
        </div>

        <!-- 3. Why the Double Inhale & Long Exhale? -->
        <div class="space-y-3 pt-4 border-t border-neutral-900">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            The Physiology Behind the Breath
          </h3>
          <p>
            The lungs contain millions of microscopic air sacs called <em>alveoli</em>. Throughout normal daily life, tiny alveoli can occasionally collapse or deflate. Taking a second, sharp "sip" of air right at the peak of the breath inflates the lungs completely, helping maintain airway stability and lung compliance.
          </p>
          <p>
            The defining feature of cyclic sighing is the <strong>prolonged exhalation</strong>. Slowing down your exhale signals your nervous system to ease physiological arousal, making it an ideal exhale-focused practice.
          </p>
        </div>

        <!-- 4. What Scientific Research Says -->
        <div class="space-y-3 pt-4 border-t border-neutral-900">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Evidence-Based Research (Stanford 2023 Study)
          </h3>
          <p>
            A 2023 randomized controlled study conducted by researchers at Stanford University compared 5-minute daily practices of cyclic sighing, box breathing, cyclic hyperventilation, and mindfulness meditation over one month.
          </p>
          <div class="p-4 rounded-2xl bg-emerald-950/20 border border-emerald-500/20 space-y-2">
            <h4 class="text-sm font-bold text-white">Key Findings from the Research:</h4>
            <ul class="list-disc list-inside space-y-1.5 text-xs sm:text-sm text-neutral-300 font-sans">
              <li>Cyclic sighing produced <strong>greater improvements in daily mood</strong> compared with mindfulness meditation.</li>
              <li>Practicing 5 minutes per day resulted in significant <strong>reductions in respiratory rate</strong> after one month.</li>
              <li>Exhale-emphasized breathwork was found to be particularly effective for lowering physiological arousal.</li>
            </ul>
          </div>
        </div>

        <!-- 5. Potential Benefits -->
        <div class="space-y-3 pt-4 border-t border-neutral-900">
          <h3 class="text-lg font-bold text-white flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Key Potential Benefits
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl border border-neutral-800/80 bg-neutral-900/40 space-y-1.5">
              <h4 class="text-sm font-bold text-white">1. On-Demand Stress Relief</h4>
              <p class="text-xs text-neutral-400">A quick 1-2 minute session helps settle tension before high-stakes tasks or after stressful events.</p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-800/80 bg-neutral-900/40 space-y-1.5">
              <h4 class="text-sm font-bold text-white">2. Enhanced Mood & Calm</h4>
              <p class="text-xs text-neutral-400">Daily practice supports positive mood shifts and a steady state of mental composure.</p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-800/80 bg-neutral-900/40 space-y-1.5">
              <h4 class="text-sm font-bold text-white">3. Steady Respiratory Rate</h4>
              <p class="text-xs text-neutral-400">Repeated prolonged exhales train your body toward slower, more efficient breathing habits.</p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-800/80 bg-neutral-900/40 space-y-1.5">
              <h4 class="text-sm font-bold text-white">4. Natural Airway Function</h4>
              <p class="text-xs text-neutral-400">Supports normal respiratory regulation and alveolar expansion through structured double inhales.</p>
            </div>
          </div>
        </div>

        <!-- 6. Safety & Practice Tips -->
        <div class="p-5 rounded-2xl bg-amber-500/10 border border-amber-500/20 space-y-3 text-xs sm:text-sm text-neutral-300">
          <h4 class="text-sm font-bold text-amber-400 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Safety & Best Practices
          </h4>
          <ul class="list-disc list-inside space-y-1 font-sans text-neutral-300">
            <li><strong>Sharp "sip" technique:</strong> Take a second, sharp "sip" of air through your nose to inflate the lungs completely without straining.</li>
            <li><strong>Listen to your body:</strong> If you feel lightheaded, dizzy, or short of breath, stop the session and return to normal breathing.</li>
            <li><strong>Safety first:</strong> Never practice breathwork while driving, swimming, bathing, or operating machinery.</li>
            <li><strong>Medical considerations:</strong> Breathwork is an educational wellness practice. Consult a healthcare provider if you have underlying respiratory or cardiac conditions.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Frequently Asked Questions (FAQ) Section -->
    <section class="w-full max-w-4xl mx-auto px-4 py-8">
      <div class="bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-8 backdrop-blur-xl space-y-6">
        <div class="flex items-center gap-3 border-b border-neutral-800 pb-4">
          <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-400 font-bold">
            ?
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Frequently Asked Questions</h2>
            <p class="text-xs font-mono text-neutral-400">Everything you need to know about the Physiological Sigh</p>
          </div>
        </div>

        <div class="space-y-4">
          <details class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              <span>What is the Huberman psychological sigh?</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:-rotate-180 text-emerald-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
              The physiological sigh—frequently called the psychological sigh—is a fast-acting stress reduction technique popularized by neuroscientist Dr. Andrew Huberman. It consists of two quick inhales through the nose followed by one long, relaxing exhale through the mouth to rapidly lower autonomic arousal.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              <span>Does the physiological sigh actually work?</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:-rotate-180 text-emerald-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
              Yes, scientific evidence confirms its efficacy. A landmark study from Stanford Medicine showed that practicing cyclic sighing for just 5 minutes a day rapidly reduces anxiety, lowers heart rate and respiratory rate, and improves overall mood more effectively than standard mindfulness meditation.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              <span>How many physiological sighs should you do?</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:-rotate-180 text-emerald-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
              For immediate, real-time stress relief during acute tension or anxiety, performing <strong>1 to 3 physiological sighs</strong> is enough to trigger a rapid relaxation response. For long-term stress resilience and sustained mood elevation, practice cyclic sighing for <strong>5 minutes daily</strong>.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              <span>Why does it use a double inhale?</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:-rotate-180 text-emerald-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
              Taking a second, sharp "sip" of air right after the initial inhalation pops open deflated or collapsed lung air sacs (alveoli). This fully inflates the lungs, expands surface area, and maximizes oxygenation and carbon dioxide offloading before the long exhale.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              <span>What is the difference between a physiological sigh and cyclic sighing?</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:-rotate-180 text-emerald-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
              A physiological sigh refers to a single double-inhale and long-exhale breath pattern. Cyclic sighing refers to repeating this double-inhale breathing pattern continuously over a set duration (typically 3 to 5 minutes).
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              <span>Is physiological sighing safe?</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:-rotate-180 text-emerald-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
              Yes, physiological sighing is a safe and natural breathwork technique. Gently take the second sharp sip without forcing or straining. If you feel lightheaded, pause and return to your natural rhythm. Never practice breathwork while driving or in water.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- Explore Other Techniques Component -->
    <ExploreOtherTechniques current="physiological-sigh" accent="emerald" />
  </main>

  <Footer />
</Layout>
