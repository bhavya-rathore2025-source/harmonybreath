---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="HarmonyBreath — Free Wim Hof Breathing Timer & Breathwork Techniques"
  description="Master the Wim Hof breathing technique and more with our free guided breathwork platform. Practice Wim Hof method breathing, Box Breathing, 4-7-8, and Coherent Breathing. 100% free & private."
  keywords="wim hof breathing, breathwork techniques, guided breathing timer, wim hof method, box breathing, 4-7-8 breathing, coherent breathing, free breathwork app"
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <!-- HERO SECTION -->
    <section class="w-full max-w-5xl mx-auto pt-14 pb-12 px-4 sm:px-6 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        The Universal Breathwork & Pranayama Platform
      </div>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-normal text-white leading-[1.15]">
        Master Every Breath, <br />
        <span class="gradient-text-develop">Elevate Mind & Body.</span>
      </h1>

      <p class="max-w-3xl mx-auto text-base sm:text-lg text-neutral-400 leading-relaxed font-sans font-light">
        HarmonyBreath is your open, privacy-first hub for conscious breathwork. Harness evidence-backed breathing techniques with dedicated timers, audio cues, and physiological analytics.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a 
          href="#techniques" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-neutral-800 bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white font-medium text-sm transition-all"
        >
          Explore Breathing Catalog ↓
        </a>
      </div>
    </section>

    <!-- TECHNIQUES CATALOG GRID -->
    <section id="techniques" class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-12 border-t border-neutral-900">
      <div class="text-center space-y-3 mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">
          Breathing Technique Catalog
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto text-sm sm:text-base font-sans font-light">
          Each breathwork method targets specific physiological responses. Select a technique to explore its dedicated guide and interactive timer.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- 1. WIM HOF METHOD (LIVE) -->
        <div class="rounded-2xl border border-cyan-500/40 bg-neutral-900/80 p-6 flex flex-col justify-between space-y-6 hover:border-cyan-400 transition-all duration-300 group shadow-lg shadow-cyan-500/5">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Hyperoxygenation</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors">
              Wim Hof Method
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              30 power inhales followed by breath retention after exhalation. Triggers adrenaline release, reduces inflammation, and enhances stress tolerance.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">30 Breaths + Retention</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-cyan-400">Energy & Immunity</span></div>
            </div>
          </div>

          <a 
            href="/wim-hof" 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-xs transition-colors"
          >
            Open Wim Hof Timer →
          </a>
        </div>

        <!-- 2. BOX BREATHING -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-amber-500/30 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Equal Cadence</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors">
              Box Breathing (4-4-4-4)
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Equal duration inhale, hold, exhale, and empty hold. Utilized by tactical operators and athletes to immediately reset composure under high stress.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">4s In | 4s Hold | 4s Out | 4s Hold</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-amber-400">Panic & Stress Reset</span></div>
            </div>
          </div>

          <a
            href="/box-breathing"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-semibold text-xs transition-colors"
          >
            Open Box Breathing Timer →
          </a>
        </div>

        <!-- 3. 4-7-8 RELAXING BREATH (PLANNED) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-neutral-700 transition-all duration-300">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">
                In Development
              </span>
              <span class="text-xs text-neutral-500 font-mono">Vagal Activation</span>
            </div>

            <h3 class="text-xl font-bold text-white">
              4-7-8 Relaxing Breath
            </h3>

            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              Extended exhalation protocol popularized by Dr. Andrew Weil. Rapidly shifts your nervous system into deep parasympathetic rest for sleep.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-500 pt-2 border-t border-neutral-800/80">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-neutral-300">4s In | 7s Hold | 8s Exhale</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-blue-400">Deep Sleep & Anxiety</span></div>
            </div>
          </div>

          <button 
            disabled 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-800 bg-neutral-900 text-neutral-500 font-semibold text-xs cursor-not-allowed"
          >
            Coming Soon
          </button>
        </div>

        <!-- 4. COHERENT BREATHING (PLANNED) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-neutral-700 transition-all duration-300">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-teal-500/10 text-teal-400 border border-teal-500/20">
                In Development
              </span>
              <span class="text-xs text-neutral-500 font-mono">HRV Optimization</span>
            </div>

            <h3 class="text-xl font-bold text-white">
              Coherent / Resonant Frequency
            </h3>

            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              Rhythmic 5.5-second inhales and exhales (5.5 breaths per minute) designed to align heart rate rhythm, blood pressure, and brainwaves.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-500 pt-2 border-t border-neutral-800/80">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-neutral-300">5.5s Inhale | 5.5s Exhale</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-teal-400">Heart Rate Variability</span></div>
            </div>
          </div>

          <button 
            disabled 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-800 bg-neutral-900 text-neutral-500 font-semibold text-xs cursor-not-allowed"
          >
            Coming Soon
          </button>
        </div>

        <!-- 5. NADI SHODHANA (PLANNED) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-neutral-700 transition-all duration-300">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                In Development
              </span>
              <span class="text-xs text-neutral-500 font-mono">Pranayama</span>
            </div>

            <h3 class="text-xl font-bold text-white">
              Nadi Shodhana (Alternate Nostril)
            </h3>

            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              Traditional yogic alternate nostril breathing. Harmonizes left and right brain hemispheres, clears subtle energetic channels, and calms thoughts.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-500 pt-2 border-t border-neutral-800/80">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-neutral-300">Alternating Airflow</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-emerald-400">Brain Balance & Focus</span></div>
            </div>
          </div>

          <button 
            disabled 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-800 bg-neutral-900 text-neutral-500 font-semibold text-xs cursor-not-allowed"
          >
            Coming Soon
          </button>
        </div>

        <!-- 6. TUMMO INNER FIRE (PLANNED) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-neutral-700 transition-all duration-300">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                In Development
              </span>
              <span class="text-xs text-neutral-500 font-mono">Inner Heat</span>
            </div>

            <h3 class="text-xl font-bold text-white">
              Tummo (Inner Fire Breathing)
            </h3>

            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              Ancient Himalayan meditative breathing protocol involving intense abdominal contractions and heat visualization for core vitality.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-500 pt-2 border-t border-neutral-800/80">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-neutral-300">Abdominal Retentions</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-amber-400">Thermogenesis & Vitality</span></div>
            </div>
          </div>

          <button 
            disabled 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-800 bg-neutral-900 text-neutral-500 font-semibold text-xs cursor-not-allowed"
          >
            Coming Soon
          </button>
        </div>
      </div>
    </section>

    <!-- SCIENCE & BENEFITS SECTION -->
    <section id="benefits" class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-neutral-900">
      <div class="text-center space-y-3 mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-400/20 bg-amber-400/10 text-amber-400 text-xs font-mono">
          Physiological Impact
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">
          The Science of Conscious Breathwork
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto text-sm sm:text-base font-sans font-light">
          Targeted breathing directly influences your autonomic nervous system, brain chemistry, and metabolic rate.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Benefit 1 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
            01
          </div>
          <h3 class="text-lg font-bold text-white">Autonomic Nervous System Regulation</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            By shifting between prolonged inhales (sympathetic stimulation) and extended exhales (parasympathetic activation), conscious breathing gives you direct voluntary control over your body's stress response.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold">
            02
          </div>
          <h3 class="text-lg font-bold text-white">Vagus Nerve Stimulation & HRV</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            Slow, controlled breathing at resonant frequencies (~5.5 breaths/min) stimulates the vagus nerve, improving Heart Rate Variability (HRV), lowering resting pulse, and stabilizing emotional balance.
          </p>
        </div>

        <!-- Benefit 3 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold">
            03
          </div>
          <h3 class="text-lg font-bold text-white">Oxygen Efficiency & CO2 Tolerance</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            Breath hold retentions condition chemoreceptors in the brainstem to tolerate higher carbon dioxide levels, expanding aerobic stamina and improving oxygen release into muscular tissues (Bohr Effect).
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
            04
          </div>
          <h3 class="text-lg font-bold text-white">Mental Focus & Default Mode Network</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            Rhythmic breath counting quietens the brain's Default Mode Network (associated with mind-wandering and anxiety), inducing acute focus, mental clarity, and meditative calm.
          </p>
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION BANNER -->
    <section class="w-full max-w-5xl mx-auto px-4 sm:px-6 my-16">
      <div class="rounded-3xl border border-neutral-800 bg-gradient-to-br from-neutral-900 via-neutral-950 to-neutral-950 p-8 sm:p-12 text-center space-y-6 relative overflow-hidden">
        <div class="max-w-2xl mx-auto space-y-4">
          <h2 class="text-3xl sm:text-4xl font-bold text-white">
            Ready to Start Your Breathwork Practice?
          </h2>
          <p class="text-neutral-400 text-sm sm:text-base font-sans font-light">
            Choose a technique from our catalog to launch a guided session with live audio cues, customizable timers, and local session tracking.
          </p>
        </div>

        <div>
          <a 
            href="#techniques" 
            class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-amber-400/90 text-neutral-950 font-bold text-sm hover:bg-amber-300 transition-all shadow-xl shadow-amber-500/10"
          >
            <span>Explore Technique Catalog</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 15l-7-7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- INFO PAGES GRID -->
    <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-16">
      <div class="text-center space-y-3 mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-400/20 bg-amber-400/10 text-amber-400 text-xs font-mono">
          More Information
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">
          Learn More About HarmonyBreath
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/about" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">About Us</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">Our mission to make breathwork accessible, private, and free for everyone.</p>
        </a>

        <a href="/contact" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Contact Us</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">Get in touch with questions, feedback, or suggestions.</p>
        </a>

        <a href="/privacy" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Privacy Policy</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">We take your privacy seriously. Learn about our zero-data-collection policy.</p>
        </a>

        <a href="/terms" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Terms & Conditions</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">Guidelines, disclaimers, and terms for using HarmonyBreath.</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
