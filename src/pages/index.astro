---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="HarmonyBreath — Free Guided Breathing Timers & Breathwork Techniques"
  description="Free online guided breathing timers for Wim Hof, Box Breathing, 4-7-8, and more. Practice breathwork with audio cues, customizable sessions, and local progress tracking. 100% free & private."
  keywords="guided breathing timer, breathing exercises, online breathwork timer, calming breathing exercises, breathing techniques app, free breathwork app"
>
  <Header />

  <main class="flex-1 bg-[#06080d] text-white relative selection:bg-amber-500/30 selection:text-amber-200">
    <!-- Fixed Persistent Atmospheric Background Image -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img 
        src="/Home-page.png" 
        alt="" 
        class="w-full h-full object-cover object-center filter brightness-[0.7] contrast-110 saturate-110 scale-105"
      />
      <!-- Page-wide Gradient & Radial Ambient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/85 via-neutral-950/55 to-[#06080d]/95"></div>
      <div class="absolute inset-0 bg-radial from-amber-500/15 via-transparent to-transparent"></div>
      <div class="absolute inset-0 noise-overlay opacity-15"></div>
    </div>

    <!-- Scrolling Page Content Container -->
    <div class="relative z-10 w-full">
      <!-- HERO SECTION -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col items-center">
        <!-- Floating Glass Nav Pill Bar -->
        <header class="w-full max-w-4xl mx-auto mb-10 sm:mb-14">
          <nav class="flex flex-wrap items-center justify-between gap-3 p-2 sm:px-4 sm:py-2.5 rounded-full border border-white/15 bg-neutral-950/80 backdrop-blur-2xl shadow-2xl shadow-amber-950/30">
            <!-- Brand Badge -->
            <div class="flex items-center gap-2.5 px-3 py-1">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse shadow-[0_0_12px_#fbbf24]"></span>
              <span class="text-xs sm:text-sm font-bold tracking-wider text-white uppercase font-mono">
                HARMONY<span class="text-amber-400">BREATH</span>
              </span>
            </div>

            <!-- Jump Links (Pills) -->
            <div class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-neutral-300">
              <a href="#techniques" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Catalog</a>
              <a href="#benefits" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Benefits</a>
              <a href="/quotes/" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Motivation</a>
              <a href="/about/" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">About</a>
              <a href="/contact/" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Contact</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
              <a 
                href="#techniques" 
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-neutral-950 bg-white hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)]"
              >
                <span>Explore Catalog</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
            </div>
          </nav>
        </header>

        <!-- Hero Headline & Subtitle -->
        <div class="text-center space-y-6 max-w-4xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-white text-xs font-mono tracking-wide">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>UNIVERSAL BREATHWORK & PRANAYAMA ENGINE</span>
          </div>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] text-balance drop-shadow-xl">
            Master Every Breath, <br />
            Elevate Mind & Body
          </h1>

          <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-300 font-light leading-relaxed text-pretty">
            HarmonyBreath is your peaceful companion for conscious breathing. Experience guided breathwork through beautifully crafted timers, calming guidance, and a private space designed for daily practice.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
            <a 
              href="#techniques" 
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-white text-neutral-950 hover:bg-neutral-200 font-semibold text-sm transition-all shadow-xl shadow-white/10"
            >
              Explore Breathing Catalog ↓
            </a>
            <a 
              href="/quotes/" 
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-white/20 bg-neutral-950/70 hover:bg-white/10 text-white font-medium text-sm backdrop-blur-md transition-all"
            >
              Quotes for Motivation & Peace →
            </a>
          </div>
        </div>
      </section>

      <!-- TECHNIQUES CATALOG GRID -->
      <section id="techniques" class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-16 scroll-mt-20">
        <div class="text-center space-y-3 mb-12">
          <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400">PRACTICE CATALOG</h2>
          <h3 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
            Breathing Technique Catalog
          </h3>
          <p class="text-neutral-300 max-w-2xl mx-auto text-sm sm:text-base font-light">
            Each breathwork method targets specific physiological responses. Select a technique to explore its dedicated guide and interactive timer.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- 1. WIM HOF METHOD -->
          <div class="rounded-3xl border border-white/15 bg-neutral-950/80 p-7 flex flex-col justify-between space-y-6 hover:border-cyan-400/50 backdrop-blur-2xl transition-all duration-300 group shadow-2xl shadow-cyan-950/20 hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                  Live & Available
                </span>
                <span class="text-xs text-neutral-400 font-mono">Hyperoxygenation</span>
              </div>

              <h3 class="text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors">
                Wim Hof Method
              </h3>

              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
                30 power inhales followed by a breath retention hold after the last exhale. A well-known energizing protocol for building focus and resilience.
              </p>

              <div class="space-y-2 text-xs font-mono text-neutral-400 pt-3 border-t border-white/10">
                <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">30 Breaths + Retention</span></div>
                <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-cyan-300 font-semibold">Energy & Focus</span></div>
              </div>
            </div>

            <a 
              href="/wim-hof/" 
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-black font-bold text-xs transition-all shadow-lg shadow-cyan-500/20"
            >
              Open Wim Hof Timer →
            </a>
          </div>

          <!-- 2. BOX BREATHING -->
          <div class="rounded-3xl border border-white/15 bg-neutral-950/80 p-7 flex flex-col justify-between space-y-6 hover:border-amber-400/50 backdrop-blur-2xl transition-all duration-300 group shadow-2xl shadow-amber-950/20 hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                  Live & Available
                </span>
                <span class="text-xs text-neutral-400 font-mono">Equal Cadence</span>
              </div>

              <h3 class="text-2xl font-bold text-white group-hover:text-amber-300 transition-colors">
                Box Breathing (4-4-4-4)
              </h3>

              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
                Equal duration inhale, hold, exhale, and empty hold. A simple, steady rhythm favored by tactical operators and athletes for keeping composure.
              </p>

              <div class="space-y-2 text-xs font-mono text-neutral-400 pt-3 border-t border-white/10">
                <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">4s In | 4s Hold | 4s Out | 4s Hold</span></div>
                <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-amber-300 font-semibold">Calm & Composure</span></div>
              </div>
            </div>

            <a
              href="/box-breathing/"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-bold text-xs transition-all shadow-lg shadow-amber-500/20"
            >
              Open Box Breathing Timer →
            </a>
          </div>

          <!-- 3. 4-7-8 RELAXING BREATH -->
          <div class="rounded-3xl border border-white/15 bg-neutral-950/80 p-7 flex flex-col justify-between space-y-6 hover:border-blue-400/50 backdrop-blur-2xl transition-all duration-300 group shadow-2xl shadow-blue-950/20 hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-blue-500/20 text-blue-300 border border-blue-500/30">
                  Live & Available
                </span>
                <span class="text-xs text-neutral-400 font-mono">Vagal Activation</span>
              </div>

              <h3 class="text-2xl font-bold text-white group-hover:text-blue-300 transition-colors">
                4-7-8 Relaxing Breath
              </h3>

              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
                An extended exhalation pattern popularized by Dr. Andrew Weil. A gentle, calming technique widely used to wind down and ease into rest.
              </p>

              <div class="space-y-2 text-xs font-mono text-neutral-400 pt-3 border-t border-white/10">
                <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">4s In | 7s Hold | 8s Exhale</span></div>
                <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-blue-300 font-semibold">Relaxation & Sleep</span></div>
              </div>
            </div>

            <a 
              href="/4-7-8-breathing/" 
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-blue-400 hover:bg-blue-300 text-black font-bold text-xs transition-all shadow-lg shadow-blue-500/20"
            >
              Open 4-7-8 Timer →
            </a>
          </div>

          <!-- 4. DIAPHRAGMATIC / BELLY BREATHING -->
          <div class="rounded-3xl border border-white/15 bg-neutral-950/80 p-7 flex flex-col justify-between space-y-6 hover:border-teal-400/50 backdrop-blur-2xl transition-all duration-300 group shadow-2xl shadow-teal-950/20 hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-teal-500/20 text-teal-300 border border-teal-500/30">
                  Live & Available
                </span>
                <span class="text-xs text-neutral-400 font-mono">Deep Breathing</span>
              </div>

              <h3 class="text-2xl font-bold text-white group-hover:text-teal-300 transition-colors">
                Diaphragmatic / Belly Breathing
              </h3>

              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
                Deep, slow breaths driven by the diaphragm — the belly rises on the inhale and gently falls on the exhale. Promotes full oxygen exchange.
              </p>

              <div class="space-y-2 text-xs font-mono text-neutral-400 pt-3 border-t border-white/10">
                <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">Abdominal Inhale | Relaxed Exhale</span></div>
                <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-teal-300 font-semibold">Relaxation & Grounding</span></div>
              </div>
            </div>

            <a 
              href="/diaphragmatic-breathing/" 
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-teal-400 hover:bg-teal-300 text-black font-bold text-xs transition-all shadow-lg shadow-teal-500/20"
            >
              Open Diaphragmatic Timer →
            </a>
          </div>

          <!-- 5. NADI SHODHANA -->
          <div class="rounded-3xl border border-white/15 bg-neutral-950/80 p-7 flex flex-col justify-between space-y-6 hover:border-purple-400/50 backdrop-blur-2xl transition-all duration-300 group shadow-2xl shadow-purple-950/20 hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/30">
                  Live & Available
                </span>
                <span class="text-xs text-neutral-400 font-mono">Pranayama</span>
              </div>

              <h3 class="text-2xl font-bold text-white group-hover:text-purple-300 transition-colors">
                Nadi Shodhana (Alternate Nostril)
              </h3>

              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
                Traditional yogic alternate nostril breathing. Alternates airflow between left and right nostrils to promote focus and mindful awareness.
              </p>

              <div class="space-y-2 text-xs font-mono text-neutral-400 pt-3 border-t border-white/10">
                <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">Left/Right Nostril Switch</span></div>
                <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-purple-300 font-semibold">Focus & Balance</span></div>
              </div>
            </div>

            <a 
              href="/nadi-shodhana/" 
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-purple-400 hover:bg-purple-300 text-black font-bold text-xs transition-all shadow-lg shadow-purple-500/20"
            >
              Open Nadi Shodhana Timer →
            </a>
          </div>

          <!-- 6. PHYSIOLOGICAL SIGH -->
          <div class="rounded-3xl border border-white/15 bg-neutral-950/80 p-7 flex flex-col justify-between space-y-6 hover:border-emerald-400/50 backdrop-blur-2xl transition-all duration-300 group shadow-2xl shadow-emerald-950/20 hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="px-3 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                  Live & Available
                </span>
                <span class="text-xs text-neutral-400 font-mono">Double Inhale</span>
              </div>

              <h3 class="text-2xl font-bold text-white group-hover:text-emerald-300 transition-colors">
                Physiological Sigh
              </h3>

              <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed font-light">
                Two consecutive nasal inhales followed by an extended exhalation through the mouth. An evidence-backed technique for rapid stress relief.
              </p>

              <div class="space-y-2 text-xs font-mono text-neutral-400 pt-3 border-t border-white/10">
                <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">3s In | 1s Sharp Sip | 6s Out</span></div>
                <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-emerald-300 font-semibold">Stress Reset & Mood</span></div>
              </div>
            </div>

            <a 
              href="/physiological-sigh/" 
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-black font-bold text-xs transition-all shadow-lg shadow-emerald-500/20"
            >
              Open Physiological Sigh Timer →
            </a>
          </div>
        </div>
      </section>

      <!-- WHY PRACTICE SECTION -->
      <section id="benefits" class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-16 scroll-mt-20">
        <div class="text-center space-y-3 mb-12">
          <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400">WHY HARMONYBREATH</h2>
          <h3 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
            Breathwork Made Simple
          </h3>
          <p class="text-neutral-300 max-w-2xl mx-auto text-sm sm:text-base font-light">
            A calm, structured breathing practice pairs a steady rhythm with focused attention — something everyone can enjoy anywhere, anytime.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Feature 1 -->
          <div class="p-8 rounded-3xl border border-white/15 bg-neutral-950/80 backdrop-blur-2xl space-y-4 shadow-2xl">
            <div class="w-12 h-12 rounded-2xl bg-cyan-500/20 border border-cyan-400/30 flex items-center justify-center text-cyan-300 font-bold font-mono text-lg">
              01
            </div>
            <h3 class="text-xl font-bold text-white">Guided Timers for Every Technique</h3>
            <p class="text-sm text-neutral-300 leading-relaxed font-light">
              From equal-phase box breathing to the extended exhale of 4-7-8, every technique follows its traditional rhythm so you can practice the correct pattern every time.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="p-8 rounded-3xl border border-white/15 bg-neutral-950/80 backdrop-blur-2xl space-y-4 shadow-2xl">
            <div class="w-12 h-12 rounded-2xl bg-purple-500/20 border border-purple-400/30 flex items-center justify-center text-purple-300 font-bold font-mono text-lg">
              02
            </div>
            <h3 class="text-xl font-bold text-white">Customizable Sessions</h3>
            <p class="text-sm text-neutral-300 leading-relaxed font-light">
              Adjust phase lengths, cycle counts, and session durations to match your comfort level and experience, from first-time practice to daily routine.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="p-8 rounded-3xl border border-white/15 bg-neutral-950/80 backdrop-blur-2xl space-y-4 shadow-2xl">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-300 font-bold font-mono text-lg">
              03
            </div>
            <h3 class="text-xl font-bold text-white">Audio Cues & Ambience</h3>
            <p class="text-sm text-neutral-300 leading-relaxed font-light">
              Phase chimes and ambient soundscapes keep you in rhythm with your eyes closed, so you can focus fully on your breath instead of counting.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="p-8 rounded-3xl border border-white/15 bg-neutral-950/80 backdrop-blur-2xl space-y-4 shadow-2xl">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300 font-bold font-mono text-lg">
              04
            </div>
            <h3 class="text-xl font-bold text-white">Private, Free & Always Accessible</h3>
            <p class="text-sm text-neutral-300 leading-relaxed font-light">
              All session data stays in your browser. No accounts, no tracking, no paywalls — just you and your breath, on any device.
            </p>
          </div>
        </div>
      </section>

      <!-- CALL TO ACTION BANNER -->
      <section class="w-full max-w-5xl mx-auto px-4 sm:px-6 my-16">
        <div class="rounded-3xl border border-white/15 bg-neutral-950/85 backdrop-blur-2xl p-8 sm:p-14 text-center space-y-6 relative overflow-hidden shadow-2xl shadow-amber-950/20">
          <div class="max-w-2xl mx-auto space-y-4">
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
              Ready to Start Your Breathwork Practice?
            </h2>
            <p class="text-neutral-300 text-sm sm:text-base font-light leading-relaxed">
              Choose a technique from our catalog to launch a guided session with live audio cues, customizable timers, and local session tracking.
            </p>
            <p class="text-neutral-400 text-sm sm:text-base font-light italic">
              Bookmark HarmonyBreath and return whenever you need a mindful breath.
            </p>
          </div>

          <div>
            <a 
              href="#techniques" 
              class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-white text-neutral-950 font-bold text-sm hover:bg-neutral-200 transition-all shadow-xl shadow-white/20"
            >
              <span>Explore Technique Catalog</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 15l-7-7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- INFO PAGES GRID -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-16">
        <div class="text-center space-y-3 mb-10">
          <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400">MORE INFORMATION</h2>
          <h3 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
            Learn More About HarmonyBreath
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <a href="/about/" class="group rounded-3xl border border-white/15 bg-neutral-950/80 p-6 hover:border-amber-400/50 backdrop-blur-2xl transition-all duration-300 space-y-3 shadow-xl">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-amber-300 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors">About Us</h3>
            <p class="text-xs text-neutral-400 leading-relaxed font-light">Our mission to make breathwork accessible, private, and free for everyone.</p>
          </a>

          <a href="/contact/" class="group rounded-3xl border border-white/15 bg-neutral-950/80 p-6 hover:border-amber-400/50 backdrop-blur-2xl transition-all duration-300 space-y-3 shadow-xl">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-amber-300 group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-amber-300 transition-colors">Contact Us</h3>
            <p class="text-xs text-neutral-400 leading-relaxed font-light">Get in touch with questions, feedback, or suggestions.</p>
          </a>

          <a href="/privacy/" class="group rounded-3xl border border-white/15 bg-neutral-950/80 p-6 hover:border-amber-400/50 backdrop-blur-2xl transition-all duration-300 space-y-3 shadow-xl">
