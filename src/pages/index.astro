---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="HarmonyBreath — Free Guided Breathing Timers & Breathwork Techniques"
  description="Free online guided breathing timers for Wim Hof, Box Breathing, 4-7-8, and more. Practice breathwork with audio cues, customizable sessions, and local progress tracking. 100% free & private."
  keywords="guided breathing timer, breathing exercises, breathwork timer, wim hof breathing, box breathing, 4-7-8 breathing, breathing techniques, free breathwork app"
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <!-- HERO SECTION -->
    <section class="w-full max-w-5xl mx-auto pt-14 pb-12 px-4 sm:px-6 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        The Universal Breathwork & Pranayama Platform
      </div>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-normal text-white leading-[1.15]">
        Master Every Breath, <br />
        <span class="gradient-text-develop">Elevate Mind & Body.</span>
      </h1>

      <p class="max-w-3xl mx-auto text-base sm:text-lg text-neutral-400 leading-relaxed font-sans font-light">
        HarmonyBreath is your peaceful companion for conscious breathing. Experience guided breathwork through beautifully crafted timers, calming guidance, and a private space designed for daily practice.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a 
          href="#techniques" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-neutral-800 bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white font-medium text-sm transition-all"
        >
          Explore Breathing Catalog ↓
        </a>
        <a 
          href="/quotes/" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full border border-neutral-800 bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white font-medium text-sm transition-all"
        >
          Quotes for Motivation & Peace →
        </a>
      </div>
    </section>

    <!-- TECHNIQUES CATALOG GRID -->
    <section id="techniques" class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-12 border-t border-neutral-900">
      <div class="text-center space-y-3 mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-white">
          Breathing Technique Catalog
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto text-sm sm:text-base font-sans font-light">
          Each breathwork method targets specific physiological responses. Select a technique to explore its dedicated guide and interactive timer.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- 1. WIM HOF METHOD (LIVE) -->
        <div class="rounded-2xl border border-cyan-500/40 bg-neutral-900/80 p-6 flex flex-col justify-between space-y-6 hover:border-cyan-400 transition-all duration-300 group shadow-lg shadow-cyan-500/5">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Hyperoxygenation</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors">
              Wim Hof Method
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              30 power inhales followed by a breath retention hold after the last exhale. A well-known energizing protocol for building focus and resilience through consistent practice.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">30 Breaths + Retention</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-cyan-400">Energy & Focus</span></div>
            </div>
          </div>

          <a 
            href="/wim-hof/" 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-black font-semibold text-xs transition-colors"
          >
            Open Wim Hof Timer →
          </a>
        </div>

        <!-- 2. BOX BREATHING -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-amber-500/30 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Equal Cadence</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-amber-400 transition-colors">
              Box Breathing (4-4-4-4)
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Equal duration inhale, hold, exhale, and empty hold. A simple, steady rhythm favored by tactical operators and athletes for keeping a clear head under pressure.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">4s In | 4s Hold | 4s Out | 4s Hold</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-amber-400">Calm & Composure</span></div>
            </div>
          </div>

          <a
            href="/box-breathing/"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-semibold text-xs transition-colors"
          >
            Open Box Breathing Timer →
          </a>
        </div>

        <!-- 3. 4-7-8 RELAXING BREATH (LIVE) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-blue-500/30 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-blue-500/20 text-blue-400 border border-blue-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Vagal Activation</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">
              4-7-8 Relaxing Breath
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              An extended exhalation pattern popularized by Dr. Andrew Weil. A gentle, calming technique widely used to wind down in the evening and ease into rest.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">4s In | 7s Hold | 8s Exhale</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-blue-400">Relaxation & Sleep</span></div>
            </div>
          </div>

          <a 
            href="/4-7-8-breathing/" 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-blue-500 hover:bg-blue-400 text-white font-semibold text-xs transition-colors"
          >
            Open 4-7-8 Timer →
          </a>
        </div>

        <!-- 4. DIAPHRAGMATIC / BELLY BREATHING (LIVE) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-teal-500/30 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-teal-500/20 text-teal-400 border border-teal-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Deep Breathing</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-teal-400 transition-colors">
              Diaphragmatic / Belly Breathing
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Deep, slow breaths driven by the diaphragm — the belly rises on the inhale and gently falls on the exhale with minimal chest movement. A gentle, grounding practice often recommended for relaxation and steadying the mind.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">Abdominal Inhale | Relaxed Exhale</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-teal-400">Relaxation & Grounding</span></div>
            </div>
          </div>

          <a 
            href="/diaphragmatic-breathing/" 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-teal-500 hover:bg-teal-400 text-black font-semibold text-xs transition-colors"
          >
            Open Diaphragmatic Timer →
          </a>
        </div>

        <!-- 5. NADI SHODHANA (LIVE) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-indigo-500/30 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-indigo-500/20 text-indigo-400 border border-indigo-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Pranayama</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-indigo-400 transition-colors">
              Nadi Shodhana (Alternate Nostril)
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Traditional yogic alternate nostril breathing. Alternates airflow between left and right nostrils to promote focus, relaxation, and mindful awareness.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">Left/Right Nostril Switch</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-indigo-400">Focus & Relaxation</span></div>
            </div>
          </div>

          <a 
            href="/nadi-shodhana/" 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white font-semibold text-xs transition-colors"
          >
            Open Nadi Shodhana Timer →
          </a>
        </div>

        <!-- 6. PHYSIOLOGICAL SIGH / CYCLIC SIGHING (LIVE) -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 flex flex-col justify-between space-y-6 hover:border-emerald-500/30 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-mono uppercase font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                Live & Available
              </span>
              <span class="text-xs text-neutral-500 font-mono">Double Inhale</span>
            </div>

            <h3 class="text-xl font-bold text-white group-hover:text-emerald-400 transition-colors">
              Physiological Sigh
            </h3>

            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Two consecutive nasal inhales followed by an extended exhalation through the mouth. An evidence-backed technique for rapid stress relief and mood regulation.
            </p>

            <div class="space-y-1.5 text-xs font-mono text-neutral-400 pt-2 border-t border-neutral-800">
              <div class="flex justify-between"><span>Cadence:</span> <span class="text-white">3s In | 1s Sharp Sip | 6s Out</span></div>
              <div class="flex justify-between"><span>Primary Goal:</span> <span class="text-emerald-400">Stress Relief & Mood</span></div>
            </div>
          </div>

          <a 
            href="/physiological-sigh/" 
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-semibold text-xs transition-colors"
          >
            Open Physiological Sigh Timer →
          </a>
        </div>
      </div>
    </section>

    <!-- WHY PRACTICE SECTION -->
    <section id="benefits" class="w-full max-w-6xl mx-auto px-4 sm:px-6 py-16 border-t border-neutral-900">
      <div class="text-center space-y-3 mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-400/20 bg-amber-400/10 text-amber-400 text-xs font-mono">
          Why HarmonyBreath
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">
          Breathwork Made Simple
        </h2>
        <p class="text-neutral-400 max-w-2xl mx-auto text-sm sm:text-base font-sans font-light">
          A calm, structured breathing practice pairs a steady rhythm with focused attention — something everyone can enjoy anywhere, anytime.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Feature 1 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
            01
          </div>
          <h3 class="text-lg font-bold text-white">Guided Timers for Every Technique</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            From equal-phase box breathing to the extended exhale of 4-7-8, every technique follows its traditional rhythm so you can practice the correct pattern every time.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold">
            02
          </div>
          <h3 class="text-lg font-bold text-white">Customizable Sessions</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            Adjust phase lengths, cycle counts, and session durations to match your comfort level and experience, from first-time practice to daily routine.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold">
            03
          </div>
          <h3 class="text-lg font-bold text-white">Audio Cues & Ambience</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            Phase chimes and ambient soundscapes keep you in rhythm with your eyes closed, so you can focus fully on your breath instead of counting.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="p-6 rounded-2xl border border-neutral-800/80 bg-neutral-900/50 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
            04
          </div>
          <h3 class="text-lg font-bold text-white">Private, Free & Always Accessible</h3>
          <p class="text-sm text-neutral-400 leading-relaxed font-sans">
            All session data stays in your browser. No accounts, no tracking, no paywalls — just you and your breath, on any device.
          </p>
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION BANNER -->
    <section class="w-full max-w-5xl mx-auto px-4 sm:px-6 my-16">
      <div class="rounded-3xl border border-neutral-800 bg-gradient-to-br from-neutral-900 via-neutral-950 to-neutral-950 p-8 sm:p-12 text-center space-y-6 relative overflow-hidden">
        <div class="max-w-2xl mx-auto space-y-4">
          <h2 class="text-3xl sm:text-4xl font-bold text-white">
            Ready to Start Your Breathwork Practice?
          </h2>
          <p class="text-neutral-400 text-sm sm:text-base font-sans font-light">
            Choose a technique from our catalog to launch a guided session with live audio cues, customizable timers, and local session tracking.
          </p>
          <p class="text-neutral-500 text-sm sm:text-base font-sans font-light italic">
            Bookmark HarmonyBreath and return whenever you need a mindful breath.
          </p>
        </div>

        <div>
          <a 
            href="#techniques" 
            class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-amber-400/90 text-neutral-950 font-bold text-sm hover:bg-amber-300 transition-all shadow-xl shadow-amber-500/10"
          >
            <span>Explore Technique Catalog</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 15l-7-7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- INFO PAGES GRID -->
    <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pb-16">
      <div class="text-center space-y-3 mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-400/20 bg-amber-400/10 text-amber-400 text-xs font-mono">
          More Information
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-white">
          Learn More About HarmonyBreath
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/about/" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">About Us</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">Our mission to make breathwork accessible, private, and free for everyone.</p>
        </a>

        <a href="/contact/" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Contact Us</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">Get in touch with questions, feedback, or suggestions.</p>
        </a>

        <a href="/privacy/" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Privacy Policy</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">We take your privacy seriously. Learn about our zero-data-collection policy.</p>
        </a>

        <a href="/terms/" class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 hover:border-amber-400/30 hover:bg-neutral-900/80 transition-all duration-300 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Terms & Conditions</h3>
          <p class="text-xs text-neutral-400 leading-relaxed font-sans">Guidelines, disclaimers, and terms for using HarmonyBreath.</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
