---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BoxBreathingTimer from '../components/BoxBreathingTimer.astro';
import BoxSessionPresets from '../components/BoxSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import Footer from '../components/Footer.astro';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: 'Box Breathing', url: '/box-breathing' },
];

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HarmonyBreath — Box Breathing Timer",
    "alternateName": "HarmonyBreath Box Breathing Guided App",
    "description": "Free guided box breathing timer with customizable phase durations, audio cues, and session tracking. Practice the box breathing method online with adjustable 2s to 10s per phase.",
    "url": "https://harmonybreath.com/box-breathing",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided box breathing 4-phase sessions",
      "Customizable phase duration 2–10 seconds",
      "Session presets and custom mode",
      "Audio cue support and silent fallbacks",
      "Local progress tracking with analytics",
      "100% free, privacy-first, no registration"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HarmonyBreath Box Breathing Timer",
    "description": "Free online box breathing timer with guided 4-4-4-4 sessions, adjustable phase durations, and session analytics. Practice box breathing safely.",
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is a box breathing method?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Box breathing, also known as square breathing or 4-4-4-4 breathing, is a structured breathing technique where you inhale, hold, exhale, and hold empty for equal counts. This balanced square-shaped pattern helps calm the nervous system, reduce stress, and improve focus. Each of the four phases lasts the same duration, typically 4 seconds, creating a predictable rhythm that makes it one of the most accessible and effective breathwork techniques."
        }
      },
      {
        "@type": "Question",
        "name": "Is box breathing good or bad for you?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Box breathing is generally safe and beneficial for most people when practiced correctly. It helps reduce stress, improve focus, lower heart rate, and regulate the nervous system. However, individuals with epilepsy, high blood pressure, heart conditions, or who are pregnant should consult a doctor before practicing. Always practice in a safe environment — never while driving, in water, or operating machinery. Stop immediately if you experience chest pain or severe dizziness."
        }
      },
      {
        "@type": "Question",
        "name": "How to do box breathing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sit comfortably in a safe space and set a timer. Inhale slowly through your nose for 4 seconds, filling your lungs completely. Hold your breath gently for 4 seconds without straining. Exhale steadily through your mouth for 4 seconds, emptying fully. Hold with lungs empty for 4 seconds. Repeat this cycle for 3–5 minutes. Beginners can start with 2–3 seconds per phase and gradually increase. Use our free guided box breathing timer to follow each phase without counting mentally."
        }
      },
      {
        "@type": "Question",
        "name": "Who invented box breathing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The underlying technique traces back thousands of years to ancient yoga traditions known as sama vritti pranayama, or equal breathing. The modern structured version with four equal phases was popularized by Navy SEALs and tactical breathing programs for stress regulation under pressure. Today it is used by first responders, elite athletes, and corporate executives to maintain composure in high-stakes situations."
        }
      }
    ]
  }
];
---

<Layout
  title="Box Breathing — Free Guided 4-4-4-4 Timer & Exercise Tool | HarmonyBreath"
  description="What is box breathing? Master the box breathing method with our free guided box breathing timer. Practice the box breathing exercise for anxiety relief with equal inhale, hold, exhale, and empty hold phases. Customizable 2s–10s per phase. Free & private."
  keywords="box breathing, box breathing timer, box breathing exercise, box breathing meaning, what is box breathing, box breathing for anxiety, box breathing method, square breathing, 4-4-4-4 breathing, stress relief breathing, guided breathing timer"
  canonicalUrl="https://harmonybreath.com/box-breathing"
  image="https://harmonybreath.com/og-image.png"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <section class="w-full max-w-4xl mx-auto pt-8 pb-6 px-4 text-center space-y-4">
      <div class="flex items-center justify-center gap-2 mb-2">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-neutral-800 bg-neutral-900/80 text-neutral-400 hover:text-white text-xs font-mono transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to All Techniques
        </a>
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          Box Breathing
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-normal text-white leading-tight">
        Box Breathing <br />
        <span class="gradient-text-develop">Free Guided 4-4-4-4 Timer</span>
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-neutral-400 leading-relaxed font-sans font-light">
        Master box breathing (square breathing) with our free guided timer. Equal inhale, hold, exhale, and empty hold — customizable from 2 to 10 seconds per phase. Used by tactical operators and athletes to reset composure under stress. 100% free and private.
      </p>
    </section>

    <BoxSessionPresets />
    <BoxBreathingTimer />
    <AnalyticsPanel exerciseId="box-breathing" />

    <!-- Technique Guide -->
    <section id="box-technique-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400">How It Works</h2>
        <h3 class="text-3xl font-bold text-white sm:text-4xl">
          The Four Phases of Box Breathing
        </h3>
        <p class="text-sm text-neutral-400">
          Four equal parts. One calm rhythm. Box breathing uses equal duration for each phase, creating a balanced, square-shaped breathing pattern.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-12">
        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md group hover:border-amber-500/40 transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono font-bold flex items-center justify-center mb-4 text-sm">01</div>
          <h4 class="text-lg font-bold text-white mb-2">Inhale</h4>
          <p class="text-xs text-neutral-400 leading-relaxed mb-4">
            Breathe in slowly and deeply through your nose. Fill your lungs completely over the full duration.
          </p>
          <ul class="text-xs font-mono text-neutral-500 space-y-1">
            <li>• Equal to all phases</li>
            <li>• Deep belly breath</li>
            <li>• Smooth & controlled</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md group hover:border-cyan-500/40 transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono font-bold flex items-center justify-center mb-4 text-sm">02</div>
          <h4 class="text-lg font-bold text-white mb-2">Hold (Full)</h4>
          <p class="text-xs text-neutral-400 leading-relaxed mb-4">
            Hold your breath gently after the inhale. Keep your lungs full without straining or tensing up.
          </p>
          <ul class="text-xs font-mono text-neutral-500 space-y-1">
            <li>• Relaxed retention</li>
            <li>• No tension</li>
            <li>• Mindful pause</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md group hover:border-blue-500/40 transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 font-mono font-bold flex items-center justify-center mb-4 text-sm">03</div>
          <h4 class="text-lg font-bold text-white mb-2">Exhale</h4>
          <p class="text-xs text-neutral-400 leading-relaxed mb-4">
            Exhale slowly and completely through your mouth. Empty your lungs over the full duration.
          </p>
          <ul class="text-xs font-mono text-neutral-500 space-y-1">
            <li>• Slow & steady</li>
            <li>• Complete exhale</li>
            <li>• Release tension</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md group hover:border-purple-500/40 transition-all duration-300">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 font-mono font-bold flex items-center justify-center mb-4 text-sm">04</div>
          <h4 class="text-lg font-bold text-white mb-2">Hold (Empty)</h4>
          <p class="text-xs text-neutral-400 leading-relaxed mb-4">
            Hold your breath after the exhale with lungs empty. Stay calm and relaxed before beginning the next inhale.
          </p>
          <ul class="text-xs font-mono text-neutral-500 space-y-1">
            <li>• Empty retention</li>
            <li>• Complete cycle</li>
            <li>• Prepare to repeat</li>
          </ul>
        </div>
      </div>

      <div class="p-8 rounded-2xl border border-neutral-800 bg-gradient-to-r from-neutral-950 via-neutral-900 to-neutral-950">
        <h4 class="text-sm font-mono text-amber-400 uppercase tracking-widest mb-4">Benefits</h4>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-medium text-neutral-300">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            Stress & Panic Reset
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            Improved Focus
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
            Calm Nervous System
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
            Emotional Control
          </div>
        </div>
      </div>
    </section>

    <!-- About Section: SEO Content -->
    <section id="box-about-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400">About Box Breathing</h2>
        <h3 class="text-3xl font-bold text-white sm:text-4xl">
          What Is Box Breathing? Understanding the Box Breathing Meaning
        </h3>
        <p class="text-sm text-neutral-400">
          Everything you need to know about the box breathing technique — from its origins to how our guided tool helps you practice effectively.
        </p>
      </div>

      <div class="space-y-8 text-sm text-neutral-300 leading-relaxed">
        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <p class="mb-4">
            <strong class="text-white">What is box breathing?</strong> Box breathing, also known as square breathing or 4-4-4-4 breathing, is a structured breathwork technique where each phase of the breath cycle — inhale, hold, exhale, and hold empty — lasts for an equal duration. The <strong class="text-white">box breathing meaning</strong> comes from the visual representation: four equal sides forming a perfect square. This balanced structure makes it one of the most accessible breathing exercises for both beginners and experienced practitioners.
          </p>
          <p class="mb-4">
            The <strong class="text-white">box breathing method</strong> has been used for decades by Navy SEALs, first responders, elite athletes, and corporate executives to maintain composure under pressure. By forcing a slow, rhythmic pattern, you directly influence your autonomic nervous system, shifting from fight-or-flight to a state of calm and control.
          </p>
          <p>
            Our free <strong class="text-white">box breathing timer</strong> removes the guesswork. Instead of counting seconds, you focus entirely on your breath while the timer guides each phase with visual progress rings, phase indicators, and optional audio cues. Customize phase durations from 2 to 10 seconds to match your comfort level and experience.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">The Box Breathing Exercise: How to Practice</h4>
          <p class="mb-4">
            The <strong class="text-white">box breathing exercise</strong> follows a simple cycle. Sit comfortably, set your timer, and begin. Breathe in slowly through your nose, filling your lungs completely. Hold gently without strain. Exhale steadily through your mouth, emptying fully. Hold with lungs empty, staying calm before the next cycle.
          </p>
          <p class="mb-4">
            Our timer makes each phase visually distinct with color-coded indicators: amber for inhale, cyan for full hold, blue for exhale, and purple for empty hold. The progress ring shows your position in each phase, eliminating the need to count mentally and allowing you to sink deeper into the practice.
          </p>
          <p>
            Beginners should start with 3 to 5 minutes using the Standard 4-second preset. As comfort grows, increase session length or experiment with different durations using Custom mode. Consistency matters most — even five minutes of daily practice yields measurable stress management and emotional regulation benefits.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">Box Breathing for Anxiety: A Natural Stress Reset</h4>
          <p class="mb-4">
            <strong class="text-white">Box breathing for anxiety</strong> is one of the most recommended techniques in clinical and performance settings. When anxiety strikes, breathing becomes shallow and rapid, activating the sympathetic nervous system. Box breathing interrupts this cycle by forcing a slow, deep, equal pattern that engages the vagus nerve and activates the parasympathetic relaxation response.
          </p>
          <p class="mb-4">
            Three minutes of box breathing can significantly reduce heart rate and produce a measurable sense of calm. The technique works anywhere, anytime — before a presentation, during a difficult conversation, or when anxiety feels overwhelming. Our <strong class="text-white">box breathing timer</strong> is especially helpful because it removes the cognitive load of counting when you are already stressed.
          </p>
          <p>
            Session analytics let you track your practice over time, reinforcing the habit and showing tangible progress. The combination of guided timing and progress tracking makes this one of the most effective tools for building a sustainable <strong class="text-white">box breathing for anxiety</strong> practice.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">Why Our Box Breathing Timer Stands Out</h4>
          <p class="mb-4">
            Our <strong class="text-white">box breathing exercise</strong> tool is purpose-built for this technique. The interface is minimal and distraction-free, honoring the meditative nature of the practice while providing the guidance you need. Features include customizable durations from 2 to 10 seconds, preset and custom modes, integrated ambient audio tracks, detailed session analytics, and complete privacy — everything runs locally with no registration or data collection.
          </p>
          <p>
            The tool is 100% free with no paywalls and no account required. It works on any device with a modern browser, making <strong class="text-white">what is box breathing</strong> knowledge and practice accessible to everyone. We believe effective breathwork tools should never be hidden behind a paywall.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">Box Breathing Method: Tips for Best Results</h4>
          <p class="mb-4">
            Focus on smooth, controlled breaths rather than forcing the rhythm. If 4 seconds per phase feels challenging, start at 2 or 3 seconds using Custom mode and gradually increase. The goal is finding a sustainable rhythm, not pushing your limits.
          </p>
          <p>
            Daily consistency beats occasional long sessions. A five-minute daily <strong class="text-white">box breathing exercise</strong> produces better long-term results than 20 minutes once a week. Use our timer to build the habit, and you will notice improved focus, better stress resilience, and greater emotional balance over time.
          </p>
        </div>
      </div>
    </section>

    <!-- Explore Other Techniques -->
    <section class="w-full max-w-4xl mx-auto px-4 pb-4">
      <div class="max-w-3xl mx-auto space-y-5 text-sm sm:text-base text-neutral-400 leading-relaxed font-sans font-light">
        <h2 class="text-xl sm:text-2xl font-bold text-white">Explore Other Breathing Techniques</h2>
        <p>
          For a more energizing practice, explore our <a href="/wim-hof" class="text-amber-400 hover:text-amber-300 underline underline-offset-2">Wim Hof breathing timer</a> — a guided hyperoxygenation technique with breath retention holds designed to boost energy, improve immune function, and build mental resilience. Unlike the steady cadence of box breathing, the Wim Hof method uses controlled hyperventilation followed by breath-out holds.
        </p>
        <p>
          Learn more about <a href="/about" class="text-amber-400 hover:text-amber-300 underline underline-offset-2">HarmonyBreath's mission</a> to make evidence-based breathwork free and accessible for everyone.
        </p>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="box-faq-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-widest text-amber-400">FAQ</h2>
        <h3 class="text-3xl font-bold text-white sm:text-4xl">
          Frequently Asked Questions About Box Breathing
        </h3>
        <p class="text-sm text-neutral-400">
          Everything you need to know about the box breathing method, its benefits, and how to practice safely.
        </p>
      </div>

      <div class="space-y-4" itemscope itemtype="https://schema.org/FAQPage">
        <details class="group p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md open:border-amber-500/30 transition-all duration-300" open>
          <summary class="flex items-center justify-between cursor-pointer list-none text-white font-bold text-base">
            <span itemprop="name">What is a box breathing method?</span>
            <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-neutral-300 leading-relaxed" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">
              <p>Box breathing, also known as square breathing or 4-4-4-4 breathing, is a structured breathing technique where you inhale, hold, exhale, and hold empty for equal counts. This balanced square-shaped pattern helps calm the nervous system, reduce stress, and improve focus. Each of the four phases lasts the same duration, typically 4 seconds, creating a predictable rhythm that makes it one of the most accessible and effective breathwork techniques.</p>
            </div>
          </div>
        </details>

        <details class="group p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md open:border-cyan-500/30 transition-all duration-300">
          <summary class="flex items-center justify-between cursor-pointer list-none text-white font-bold text-base">
            <span itemprop="name">Is box breathing good or bad for you?</span>
            <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-neutral-300 leading-relaxed" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">
              <p>Box breathing is generally safe and beneficial for most people when practiced correctly. It helps reduce stress, improve focus, lower heart rate, and regulate the nervous system. However, individuals with epilepsy, high blood pressure, heart conditions, or who are pregnant should consult a doctor before practicing. Always practice in a safe environment — never while driving, in water, or operating machinery. Stop immediately if you experience chest pain or severe dizziness.</p>
            </div>
          </div>
        </details>

        <details class="group p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md open:border-blue-500/30 transition-all duration-300">
          <summary class="flex items-center justify-between cursor-pointer list-none text-white font-bold text-base">
            <span itemprop="name">How to do box breathing?</span>
            <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-neutral-300 leading-relaxed" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">
              <p>Sit comfortably in a safe space and set a timer. Inhale slowly through your nose for 4 seconds, filling your lungs completely. Hold your breath gently for 4 seconds without straining. Exhale steadily through your mouth for 4 seconds, emptying fully. Hold with lungs empty for 4 seconds. Repeat this cycle for 3–5 minutes. Beginners can start with 2–3 seconds per phase and gradually increase. Use our free guided box breathing timer above to follow each phase without counting mentally.</p>
            </div>
          </div>
        </details>

        <details class="group p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md open:border-purple-500/30 transition-all duration-300">
          <summary class="flex items-center justify-between cursor-pointer list-none text-white font-bold text-base">
            <span itemprop="name">Who invented box breathing?</span>
            <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="mt-4 text-sm text-neutral-300 leading-relaxed" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
            <div itemprop="text">
              <p>The underlying technique traces back thousands of years to ancient yoga traditions known as <em>sama vritti pranayama</em>, or equal breathing. The modern structured version with four equal phases was popularized by Navy SEALs and tactical breathing programs for stress regulation under pressure. Today it is used by first responders, elite athletes, and corporate executives to maintain composure in high-stakes situations.</p>
            </div>
          </div>
        </details>
      </div>
    </section>

    <!-- Safety Section -->
    <section id="box-safety-section" class="w-full max-w-4xl mx-auto py-12 px-4 border-t border-neutral-900">
      <div class="bg-red-950/20 border border-red-500/30 rounded-2xl p-6 sm:p-8 backdrop-blur-md">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-lg bg-red-500/20 border border-red-500/30 text-red-400 flex items-center justify-center font-bold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">Essential Safety Guidelines</h3>
            <p class="text-xs text-neutral-400">Please read carefully before starting any breathing session.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-neutral-300">
          <div>
            <h4 class="font-bold text-red-400 uppercase tracking-wider mb-2 font-mono">NEVER Practice Box Breathing:</h4>
            <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
              <li>While driving or operating any vehicle</li>
              <li>While swimming, bathing, or in water</li>
              <li>While operating machinery</li>
              <li>In any situation where dizziness could cause harm</li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-emerald-400 uppercase tracking-wider mb-2 font-mono">ALWAYS Practice:</h4>
            <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
              <li>Sitting comfortably or lying down in a safe environment</li>
              <li>Listening to your body — never force breath holds</li>
              <li>Starting with shorter durations if 4s feels too long (use Custom mode)</li>
