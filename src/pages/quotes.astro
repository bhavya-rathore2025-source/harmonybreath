---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Quotes for Motivation & Peace — HarmonyBreath"
  description="A collection of motivational quotes for peace, calm, and mindfulness. Read and share quotes that inspire inner peace."
  keywords="motivational quotes, peace quotes, calm quotes, mindfulness quotes, inspiration"
  canonicalUrl="https://harmonybreath.com/quotes/"
  robots="noindex, follow"
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <section class="w-full max-w-3xl mx-auto pt-14 pb-12 px-4 sm:px-6 text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs font-mono">
        Words of Wisdom
      </div>

      <h1 class="text-4xl sm:text-5xl font-bold tracking-normal text-white leading-[1.15]">
        Quotes for <span class="gradient-text-develop">Motivation & Peace</span>
      </h1>

      <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-400 leading-relaxed font-sans font-light">
        A growing collection of words that inspire calm, resilience, and inner stillness.
      </p>
    </section>

    <section class="w-full max-w-3xl mx-auto px-4 sm:px-6 pb-16 space-y-6">
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-8 space-y-4 hover:border-amber-400/20 transition-all duration-300">
        <blockquote class="text-xl sm:text-2xl text-white leading-relaxed font-light italic">
          "Nothing can bring you peace but yourself."
        </blockquote>
        <p class="text-sm text-neutral-400 font-mono">— Ralph Waldo Emerson</p>
      </div>

      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-8 space-y-4 hover:border-amber-400/20 transition-all duration-300">
        <blockquote class="text-xl sm:text-2xl text-white leading-relaxed font-light italic">
          "The greatest weapon against stress is our ability to choose one thought over another."
        </blockquote>
        <p class="text-sm text-neutral-400 font-mono">— William James</p>
      </div>
    </section>

    <section class="w-full max-w-3xl mx-auto px-4 sm:px-6 pb-24">
      <div class="rounded-3xl border border-neutral-800 bg-gradient-to-br from-neutral-900 via-neutral-950 to-neutral-950 p-8 sm:p-12 text-center space-y-4">
        <h2 class="text-2xl font-bold text-white">Share a Quote</h2>
        <p class="text-neutral-400 text-sm sm:text-base font-sans font-light max-w-lg mx-auto">
          Have a quote that brings you peace? Send your quote to happyharmonybreath@gmail.com, along with the author's name (or your own).
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
