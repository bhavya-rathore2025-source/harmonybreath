---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="500 — Server Error | HarmonyBreath"
  description="Something went wrong on our end. Please try again shortly."
  canonicalUrl="https://harmonybreath.com/500/"
  robots="noindex"
>
  <Header />

  <main class="flex-1 flex items-center justify-center px-4 py-24">
    <section class="text-center space-y-8 max-w-lg">
      <div class="space-y-2">
        <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-neutral-500">Error 500</p>
        <div class="text-8xl sm:text-9xl font-bold text-transparent bg-clip-text bg-gradient-to-br from-amber-400 to-amber-700 leading-none">
          500
        </div>
      </div>

      <div class="space-y-3">
        <h1 class="text-2xl sm:text-3xl font-bold text-white">
          Internal Disbalance
        </h1>
        <p class="text-sm text-neutral-400 font-sans leading-relaxed">
          Our servers are out of rhythm. We're working on restoring the flow.<br />
          Please try again in a moment.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-amber-400/90 text-neutral-950 font-bold text-sm hover:bg-amber-300 transition-all shadow-xl shadow-amber-500/10"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Return Home
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-neutral-800 bg-neutral-900/80 hover:bg-neutral-800 text-neutral-300 hover:text-white font-medium text-sm transition-all"
        >
          Contact Support
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
