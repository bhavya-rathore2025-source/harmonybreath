---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import NadiShodhanaTimer from '../components/NadiShodhanaTimer.astro';
import NadiSessionPresets from '../components/NadiSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: 'Nadi Shodhana', url: '/nadi-shodhana/' },
];

const datePublished = '2026-07-25';
const dateModified = '2026-08-15';

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HarmonyBreath — Nadi Shodhana (Alternate Nostril Breathing) Timer",
    "alternateName": "HarmonyBreath Nadi Shodhana Pranayama App",
    "description": "Free guided Nadi Shodhana (Alternate Nostril Breathing) timer with visual nostril indicators, customizable rhythms, ambient soundscapes, and local progress tracking.",
    "url": "https://harmonybreath.com/nadi-shodhana/",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided alternate nostril breathing timer with active nostril state indicators",
      "Customizable Nadi Shodhana rhythms (Beginner 4–4, Relaxed 5–5, Equal 6–6, Retention 4-4-4)",
      "Vishnu Mudra hand positioning guidance and step-by-step nostril cues",
      "Ambient soundscape player and real-time phase indicators",
      "Private browser-local session analytics with zero data tracking"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Nadi Shodhana (Alternate Nostril Breathing): Guided Timer & Science Guide",
    "description": "Master Nadi Shodhana (Alternate Nostril Breathing) with our free online timer. Learn the physiological mechanisms, ultradian nasal cycle science, and clinical references.",
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "mainEntityOfPage": "https://harmonybreath.com/nadi-shodhana/",
    "citation": [
      "https://pubmed.ncbi.nlm.nih.gov/24381831/",
      "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3681046/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HarmonyBreath Nadi Shodhana Timer",
    "description": "Free online Nadi Shodhana timer for practicing Alternate Nostril Breathing. A traditional yogic pranayama pattern for focus, stress reduction, and relaxation.",
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Nadi Shodhana good for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nadi Shodhana, or alternate nostril breathing, is a yogic breath control practice that clears and calms the mind, lowers stress and anxiety, balances the autonomic nervous system, and improves lung function and mental focus by alternating airflow through each nostril."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between Anulom Vilom and Nadi Shodhan?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The main difference between Anulom Vilom and Nadi Shodhan is breath retention (Kumbhaka). Anulom Vilom is a gentle, continuous alternate nostril breathing exercise without holding the breath, making it ideal for beginners. Nadi Shodhan is a more advanced practice that adds controlled breath retention and specific ratios to deeply purify the body's energy channels."
        }
      },
      {
        "@type": "Question",
        "name": "How many times should I do Nadi Shodhana?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Beginners should practice 5 to 10 rounds per session (or 5 to 15 minutes by time). Experienced practitioners often scale up to 15 to 20 rounds per session. For optimal, consistent results, perform alternate nostril breathing 1 to 2 times daily on an empty stomach."
        }
      },
      {
        "@type": "Question",
        "name": "Is Nadi Shodhan safe for everyone?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Gentle alternate nostril breathing without holding your breath is safe for most individuals. However, advanced Nadi Shodhana involving breath retention or forced breathing is not safe for everyone, specifically people with high blood pressure, heart conditions, or recent surgeries. Always practice without forcing the breath and listen to your body."
        }
      },
      {
        "@type": "Question",
        "name": "Can I do Nadi Shodhana if I have a blocked nose or cold?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If your nasal passages are heavily congested from a cold or allergies, do not force alternate nostril breathing. Switch to standard diaphragmatic breathing or wait until your nasal passages clear naturally."
        }
      },
      {
        "@type": "Question",
        "name": "Which hand position (mudra) should I use?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In traditional practice (Vishnu Mudra), bring your right hand toward your nose. Use your right thumb to control your right nostril and your right ring finger to control your left nostril."
        }
      }
    ]
  }
];
---

<Layout
  title="Free Nadi Shodhana Breathing Timer | HarmonyBreath"
  description="Nadi Shodhana, or Alternate Nostril Breathing, is a traditional yogic breathing practice that alternates airflow between the left and right nostrils. Use our free guided timer with visual nostril cues, customizable rhythms, and soundscapes for relaxation, concentration, and mindful awareness."
  keywords="nadi shodhana, alternate nostril breathing, anulom vilom, pranayama timer, breathing exercise for focus, balanced breathing, guided alternate nostril breathing, vishnu mudra, channel purification breathing, nadi shodhana benefits"
  canonicalUrl="https://harmonybreath.com/nadi-shodhana/"
  image="https://harmonybreath.com/og-image.png"
  imageAlt="HarmonyBreath Nadi Shodhana (Alternate Nostril Breathing) guided breathing timer"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
  ogType="website"
>

  <Header />

  <main class="flex-1 bg-[#06080d] text-white relative selection:bg-purple-500/30 selection:text-purple-200">
    <!-- Fixed Persistent Atmospheric Background Image -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img 
        src="/nadi-shoudhana.png" 
        alt="" 
        class="w-full h-full object-cover object-center filter brightness-[0.7] contrast-110 saturate-110 scale-105"
      />
      <!-- Page-wide Gradient & Radial Ambient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/50 to-[#06080d]/95"></div>
      <div class="absolute inset-0 bg-radial from-purple-500/15 via-transparent to-transparent"></div>
      <div class="absolute inset-0 noise-overlay opacity-15"></div>
    </div>

    <!-- Scrolling Page Content Container -->
    <div class="relative z-10 w-full">
      <!-- Hero Header Section -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col items-center">
        <!-- Floating Glass Nav Pill Bar -->
        <header class="w-full max-w-4xl mx-auto mb-10 sm:mb-14">
          <nav class="flex flex-wrap items-center justify-between gap-3 p-2 sm:px-4 sm:py-2.5 rounded-full border border-white/15 bg-neutral-950/80 backdrop-blur-2xl shadow-2xl shadow-purple-950/30">
            <!-- Brand Badge -->
            <div class="flex items-center gap-2.5 px-3 py-1">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse shadow-[0_0_12px_#c084fc]"></span>
              <span class="text-xs sm:text-sm font-bold tracking-wider text-white uppercase font-mono">
                NADI <span class="text-purple-400">SHODHANA</span>
              </span>
            </div>

            <!-- Jump Links (Pills) -->
            <div class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-neutral-300">
              <a href="#nadi-timer-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Timer</a>
              <a href="#presets" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Presets</a>
              <a href="#analytics" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Stats</a>
              <a href="#how-to" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Guide</a>
              <a href="#about-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">About</a>
              <a href="#faq-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">FAQ</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
              <a 
                href="/" 
                class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono text-neutral-400 hover:text-white bg-neutral-900/80 border border-white/10 hover:border-white/20 transition-all"
              >
                ← All Techniques
              </a>
              <a 
                href="#nadi-timer-section" 
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-neutral-950 bg-white hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)]"
              >
                <span>Start Practice</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l7-7m7-7H3" />
                </svg>
              </a>
            </div>
          </nav>
        </header>

        <!-- Hero Headline & Subtitle -->
        <div class="text-center space-y-6 max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-white text-xs font-mono tracking-wide">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>TRADITIONAL YOGIC PRANAYAMA ENGINE</span>
          </div>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] text-balance drop-shadow-xl">
            Nadi Shodhana <br />
            Alternate Nostril Breath
          </h1>

          <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-300 font-light leading-relaxed text-pretty">
            Nadi Shodhana is a traditional yogic breathing practice that alternates airflow between the left and right nostrils. Its slow, rhythmic pattern encourages focused attention and calm awareness.
          </p>

          <!-- Authorship & Quick Metadata -->
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-neutral-400 pt-2">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              100% Free & Private
            </span>
            <span class="text-neutral-600">•</span>
            <span>By HarmonyBreath Editorial</span>
            <span class="text-neutral-600">•</span>
            <span>Published {datePublished} · Updated {dateModified}</span>
          </div>
        </div>
      </section>

      <!-- PRESETS SELECTOR -->
      <div id="presets" class="scroll-mt-20">
        <NadiSessionPresets />
      </div>

      <!-- TIMER INTERFACE -->
      <div id="nadi-timer-section" class="scroll-mt-20">
        <NadiShodhanaTimer />
      </div>

      <!-- ANALYTICS PANEL -->
      <div id="analytics" class="scroll-mt-20">
        <AnalyticsPanel exerciseId="nadi-shodhana" />
      </div>

    <!-- DETAILED EDUCATIONAL & TECHNIQUE GUIDE -->
    <section class="w-full max-w-4xl mx-auto py-12 px-4 border-t border-neutral-900 space-y-12">
      <!-- 1. Technique Overview -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-indigo-500/20 text-indigo-400 text-sm font-mono font-bold border border-indigo-500/30">1</span>
          Understanding Nadi Shodhana
        </h2>
        <div class="prose prose-invert max-w-none text-neutral-300 text-sm sm:text-base leading-relaxed space-y-3">
          <p>
            In Sanskrit, <strong class="text-white">Nadi Shodhana</strong> is often translated as <em>"channel purification"</em> or <em>"channel cleansing."</em> In traditional yogic philosophy, nadis are described as subtle energy channels, and alternate nostril breathing is practiced to promote systemic balance.
          </p>
          <p>
            In modern wellness, the practice is straightforward and accessible to anyone: you use your hand to selectively close one nostril at a time while maintaining a smooth, quiet breathing rhythm.
          </p>
        </div>
      </div>

      <!-- 2. Step-by-Step Cycle Guide -->
      <div class="space-y-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-purple-500/20 text-purple-400 text-sm font-mono font-bold border border-purple-500/30">2</span>
          How the Alternate Nostril Sequence Works
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
            <div class="text-xs font-mono text-indigo-400 uppercase tracking-wider font-semibold">Phase A — Left to Right</div>
            <div class="text-lg font-bold text-white">Step 1 & Step 2</div>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Close your right nostril with your thumb and <strong class="text-neutral-200">inhale through your left nostril</strong>. Next, close your left nostril with your ring finger, release your right nostril, and <strong class="text-neutral-200">exhale through your right nostril</strong>.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
            <div class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold">Phase B — Right to Left</div>
            <div class="text-lg font-bold text-white">Step 3 & Step 4</div>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Keep your left nostril closed and <strong class="text-neutral-200">inhale through your right nostril</strong>. Then close your right nostril with your thumb, release your left nostril, and <strong class="text-neutral-200">exhale through your left nostril</strong>.
            </p>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-neutral-900/60 border border-neutral-800 text-xs font-mono text-neutral-300 flex items-center justify-between">
          <span>Complete Cycle Pattern:</span>
          <span class="text-indigo-400 font-bold">Inhale L → Exhale R → Inhale R → Exhale L</span>
        </div>
      </div>

      <!-- 3. Vishnu Mudra Hand Position -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-pink-500/20 text-pink-400 text-sm font-mono font-bold border border-pink-500/30">3</span>
          Hand Position (Vishnu Mudra)
        </h2>
        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/80 space-y-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
          <p>
            To easily alternate nostril closure without straining your hand:
          </p>
          <ul class="list-disc list-inside space-y-2 text-neutral-300 pl-2">
            <li><strong class="text-white">Right Thumb:</strong> Used to close the right nostril during left inhales and left exhales.</li>
            <li><strong class="text-white">Right Ring Finger:</strong> Used to close the left nostril during right exhales and right inhales.</li>
            <li><strong class="text-white">Index & Middle Fingers:</strong> Can rest gently tucked into your palm or resting on your forehead between your eyebrows.</li>
          </ul>
        </div>
      </div>

      <!-- 4. Potential Benefits & Science -->
      <div class="space-y-4">
        <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/60 text-xs text-neutral-300 font-sans flex items-start gap-3">
          <span class="text-indigo-400 font-bold text-base leading-none">🔬</span>
          <div>
            <strong class="text-white font-medium">Scientific Research & Editorial Disclosure:</strong> Content on this page is compiled from peer-reviewed physiological research, autonomic nervous system literature, and clinical studies on alternate nostril respiration. Our goal is to explain the biological mechanisms behind Nadi Shodhana while providing free, interactive guided timers.
          </div>
        </div>

        <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3">
          <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 text-sm font-mono font-bold border border-cyan-500/30">4</span>
          The Physiology & Science Behind Nadi Shodhana
        </h2>
        
        <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/80 space-y-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
          <p>
            While traditional yoga describes Nadi Shodhana as a practice for purifying subtle energy channels (<em class="text-neutral-200">nadis</em>), modern neurophysiology explains its benefits through the <strong class="text-white">ultradian nasal cycle</strong> and autonomic tone regulation:
          </p>
          <ul class="space-y-2 list-disc list-inside text-neutral-400">
            <li><strong class="text-white">The Ultradian Nasal Cycle:</strong> Humans experience a natural physiological rhythm where erectile tissue in the nasal passages alternates dominance between left and right nostrils every 90 to 120 minutes. Selective airflow through the left nostril selectively activates the contralateral right cerebral hemisphere and increases parasympathetic tone, while right nostril airflow activates the left hemisphere and sympathetic tone.</li>
            <li><strong class="text-white">Autonomic Nervous System Sync:</strong> Systematically alternating inhalations and exhalations between nostrils forces a balanced activation of both sympathetic and parasympathetic pathways, lowering resting heart rate and systolic blood pressure.</li>
            <li><strong class="text-white">Mental Anchoring & EEG Synchronization:</strong> Requiring strict tactile coordination (Vishnu Mudra) and tracking sequence order (Left → Right → Right → Left) acts as an active cognitive anchor. Clinical EEG studies show increased alpha and theta brainwave power during and after practice, reflecting calm alertness.</li>
          </ul>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-900/40 space-y-2">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
              Stress Reduction & Calm
            </h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Alternate nostril breathing encourages a slow, rhythmic respiration rate. Clinical studies note that alternate nostril breathing helps reduce autonomic stress markers and induce deep relaxation.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-900/40 space-y-2">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-purple-400"></span>
              Enhanced Focus & Concentration
            </h3>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Because Nadi Shodhana requires tracking nostril transitions (Left → Right → Right → Left), it serves as a natural anchor for sustained mental focus before work or meditation.
            </p>
          </div>
        </div>

        <div class="pt-6 border-t border-neutral-800">
          <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono mb-3">Scientific References & Cited Studies</h3>
          <ol class="space-y-1.5 text-xs text-neutral-500 font-mono list-decimal list-inside">
            <li>Telles, S., et al. (2013). Immediate autonomic and respiratory effects of alternate nostril breathing. <em class="text-neutral-400">Medical Science Monitor Basic Research</em>, 19, 67-72. <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3681046/" target="_blank" rel="noopener" class="text-indigo-400 hover:underline">[PubMed / PMC]</a></li>
            <li>Sinha, A. N., et al. (2013). Assessment of the immediate effect of alternate nostril breathing on autonomic functions in healthy volunteers. <em class="text-neutral-400">Journal of Clinical and Diagnostic Research</em>. <a href="https://pubmed.ncbi.nlm.nih.gov/24381831/" target="_blank" rel="noopener" class="text-indigo-400 hover:underline">[PubMed]</a></li>
          </ol>
        </div>
      </div>

      <!-- Editorial Team Bio -->
      <div class="rounded-3xl border border-neutral-800 bg-neutral-950/80 p-6 sm:p-8 font-sans backdrop-blur-xl">
        <div class="flex items-start gap-4">
          <div class="flex-shrink-0 w-12 h-12 rounded-full border border-indigo-400/30 bg-indigo-400/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div class="space-y-2">
            <h2 class="text-sm sm:text-base font-bold text-white">Written by the HarmonyBreath Editorial Team</h2>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              This guide was created by our in-house editorial team of breathwork practitioners and wellness writers, the same people who build and use the HarmonyBreath timers in their daily practice. We research each technique carefully against published physiological literature and keep every article clear, honest, and free of medical overreach.
            </p>
            <p class="text-xs font-mono text-neutral-500">
              This content is for educational purposes only and is not a substitute for professional medical advice.
            </p>
            <a href="/about/" class="inline-flex items-center gap-1.5 text-xs font-mono text-indigo-400 hover:text-indigo-300 transition-colors">
              Learn more about our team
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- 5. Safety & Disclaimers -->
      <div class="p-6 rounded-2xl border border-amber-500/30 bg-amber-500/5 space-y-4">
        <h3 class="text-base font-bold text-amber-300 flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          Important Safety & Practice Guidelines
        </h3>
        <ul class="text-xs text-neutral-300 space-y-2 leading-relaxed list-disc list-inside">
          <li>Always practice seated comfortably upright in a quiet, safe space.</li>
          <li><strong class="text-white">Never force or hold your breath beyond comfort:</strong> Retention holds are optional and not necessary for beginners.</li>
          <li><strong class="text-white">Do not practice while driving or operating machinery:</strong> Breathwork exercises should only be done when fully seated and stationary.</li>
          <li>Stop immediately if you experience dizziness, lightheadedness, chest tightness, or shortness of breath.</li>
        </ul>
      </div>

      <!-- 6. FAQ Accordion Section -->
      <div id="faq-section" class="space-y-6">
        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Frequently Asked Questions</h2>
          <p class="text-xs sm:text-sm text-neutral-400">Everything you need to know about Nadi Shodhana, its benefits, frequency, and safe practice.</p>
        </div>
        <div class="space-y-4">
          <details class="group rounded-2xl border border-neutral-800 bg-neutral-950/60 p-4 transition-all open:border-indigo-500/30" open>
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              What is Nadi Shodhana good for?
              <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-indigo-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Nadi Shodhana, or alternate nostril breathing, is a yogic breath control practice that clears and calms the mind, lowers stress and anxiety, balances the autonomic nervous system, and improves lung function and mental focus by alternating airflow through each nostril.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-950/60 p-4 transition-all open:border-indigo-500/30">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              What is the difference between Anulom Vilom and Nadi Shodhan?
              <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-indigo-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
              The main difference between Anulom Vilom and Nadi Shodhan is breath retention (Kumbhaka). Anulom Vilom is a gentle, continuous alternate nostril breathing exercise without holding the breath, making it ideal for beginners. Nadi Shodhan is a more advanced practice that adds controlled breath retention and specific ratios to deeply purify the body's energy channels.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-950/60 p-4 transition-all open:border-indigo-500/30">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              How many times should I do Nadi Shodhana?
              <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-indigo-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Beginners should practice 5 to 10 rounds per session (or 5 to 15 minutes by time). Experienced practitioners often scale up to 15 to 20 rounds per session. For optimal, consistent results, perform alternate nostril breathing 1 to 2 times daily on an empty stomach.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-950/60 p-4 transition-all open:border-indigo-500/30">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              Is Nadi Shodhan safe for everyone?
              <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-indigo-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Gentle alternate nostril breathing without holding your breath is safe for most individuals. However, advanced Nadi Shodhana involving breath retention or forced breathing is not safe for everyone, specifically people with high blood pressure, heart conditions, or recent surgeries. Always practice without forcing the breath and listen to your body.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-950/60 p-4 transition-all open:border-indigo-500/30">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              Can I do Nadi Shodhana if I have a blocked nose or cold?
              <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-indigo-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
              If your nasal passages are heavily congested from a cold or allergies, do not force alternate nostril breathing. Switch to standard diaphragmatic breathing or wait until your nasal passages clear naturally.
            </p>
          </details>

          <details class="group rounded-2xl border border-neutral-800 bg-neutral-950/60 p-4 transition-all open:border-indigo-500/30">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
              Which hand position (mudra) should I use?
              <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-indigo-400">↓</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-neutral-300 leading-relaxed">
              In traditional practice (Vishnu Mudra), bring your right hand toward your nose. Use your right thumb to control your right nostril and your right ring finger to control your left nostril.
            </p>
          </details>
