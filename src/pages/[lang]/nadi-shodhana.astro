---
import NadiShodhanaPage from '../../components/NadiShodhanaPage.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<NadiShodhanaPage lang={lang as SupportedLanguage} />
