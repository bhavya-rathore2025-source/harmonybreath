---
import TermsPage from '../../components/TermsPage.astro';
import type { SupportedLanguage } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'de' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
---

<TermsPage lang={lang as SupportedLanguage} />
