---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Contact Us — HarmonyBreath';
const description = 'Get in touch with the HarmonyBreath team. Reach out with questions, feedback, or suggestions about our free breathwork platform.';
const canonicalUrl = 'https://harmonybreath.com/contact/';
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <section class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <div class="text-center space-y-4 mb-12">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs font-mono">
          Get in Touch
        </span>
        <h1 class="text-4xl sm:text-5xl font-bold text-white">Contact Us</h1>
        <p class="text-neutral-400 max-w-2xl mx-auto text-sm sm:text-base font-sans font-light">
          Have a question, suggestion, or feedback? We'd love to hear from you.
        </p>
      </div>

      <div class="max-w-2xl mx-auto">
        <form 
          action="https://formspree.io/f/xrenjllv" 
          method="POST"
          class="space-y-6"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="block text-xs font-mono text-neutral-400 uppercase tracking-wider">Name</label>
              <input 
                type="text" 
                id="name" 
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-neutral-800 bg-neutral-900/60 text-white placeholder-neutral-500 text-sm focus:outline-none focus:border-amber-400/50 focus:ring-1 focus:ring-amber-400/20 transition-all"
                placeholder="Your name"
              />
            </div>
            <div class="space-y-2">
              <label for="email" class="block text-xs font-mono text-neutral-400 uppercase tracking-wider">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-neutral-800 bg-neutral-900/60 text-white placeholder-neutral-500 text-sm focus:outline-none focus:border-amber-400/50 focus:ring-1 focus:ring-amber-400/20 transition-all"
                placeholder="your@email.com"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label for="subject" class="block text-xs font-mono text-neutral-400 uppercase tracking-wider">Subject</label>
            <select 
              id="subject" 
              name="subject"
              required
              class="w-full px-4 py-3 rounded-xl border border-neutral-800 bg-neutral-900/60 text-white text-sm focus:outline-none focus:border-amber-400/50 focus:ring-1 focus:ring-amber-400/20 transition-all"
            >
              <option value="" disabled selected class="text-neutral-500">Select a subject</option>
              <option value="general">General Inquiry</option>
              <option value="feedback">Feedback & Suggestions</option>
              <option value="bug">Bug Report</option>
              <option value="feature">Feature Request</option>
              <option value="privacy">Privacy Question</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="space-y-2">
            <label for="message" class="block text-xs font-mono text-neutral-400 uppercase tracking-wider">Message</label>
            <textarea 
              id="message" 
              name="message"
              rows="6"
              required
              class="w-full px-4 py-3 rounded-xl border border-neutral-800 bg-neutral-900/60 text-white placeholder-neutral-500 text-sm focus:outline-none focus:border-amber-400/50 focus:ring-1 focus:ring-amber-400/20 transition-all resize-y"
              placeholder="Write your message here..."
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-amber-400/90 text-neutral-950 font-bold text-sm hover:bg-amber-300 transition-all shadow-xl shadow-amber-500/10"
          >
            Send Message
          </button>

          <p class="text-[11px] text-neutral-500 text-center font-mono">
            This form uses Formspree. Your message will be sent securely. No data is stored on our servers.
          </p>
        </form>

        <div class="mt-16 pt-12 border-t border-neutral-900 text-center space-y-4">
          <h2 class="text-2xl font-bold text-white">Other Ways to Reach Us</h2>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-sm text-neutral-400 font-mono">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>happyharmonybreath@gmail.com</span>
            </div>
          </div>
          <p class="text-xs text-neutral-500 font-mono">
            We aim to respond within 48 hours during business days.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
