---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Relaxing478Timer from '../components/Relaxing478Timer.astro';
import RelaxingSessionPresets from '../components/RelaxingSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: '4-7-8 Breathing', url: '/4-7-8-breathing' },
];

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HarmonyBreath — 4-7-8 Relaxing Breath Timer",
    "alternateName": "HarmonyBreath 4-7-8 Guided Breathwork App",
    "description": "Free guided 4-7-8 breathing timer with audio cues, customizable cycle counts, ambient soundscapes, and session tracking. Practice the 4-7-8 breathing method for calm and relaxation.",
    "url": "https://harmonybreath.com/4-7-8-breathing",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided 4-7-8 breathing timer with visual and acoustic feedback",
      "Customizable 4-7-8 breathing method timing parameters and round presets",
      "Relaxation-focused 4-7-8 technique guidance for sleep prep and calm",
      "Ambient soundscape player and real-time phase indicators",
      "Private browser-local session analytics with zero data tracking"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HarmonyBreath 4-7-8 Breathing Timer",
    "description": "Free online 4-7-8 breathing timer for practicing the 4-7-8 breathing technique. A structured inhale-hold-exhale pattern for relaxation and winding down.",
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does 4-7-8 breathing work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The 4-7-8 breathing method works by using a specific timing pattern — inhaling for 4 seconds, holding the breath for 7 seconds, and exhaling for 8 seconds. The extended exhalation naturally slows the pace of your breath and keeps your attention on the rhythm, which many people find calming."
        }
      },
      {
        "@type": "Question",
        "name": "Does the 4-7-8 sleep trick really work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Many people find the 4-7-8 sleep trick helpful as a nightly wind-down ritual. By slowing your breathing and giving your mind a single rhythm to follow, it can help quiet a racing mind and ease the transition toward rest."
        }
      },
      {
        "@type": "Question",
        "name": "How many times a day should I do 4-7-8 breathing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dr. Andrew Weil suggests practicing 4-7-8 breathing at least twice a day. Beginners should start with 4 cycles per session, and with regular daily practice, you can gradually increase up to 8 cycles per session."
        }
      },
      {
        "@type": "Question",
        "name": "How long does it take to fall asleep with 4 / 7 / 8 breathing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "With regular daily practice, many people report drifting off within 1 to 2 minutes (about 4 to 8 breath cycles) after finishing the exercise. Beginners may need 2 to 4 weeks of consistent practice to feel comfortable with the rhythm."
        }
      },
      {
        "@type": "Question",
        "name": "Is 4-7-8 breathing dangerous?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "4-7-8 breathing is a gentle practice that is safe for most healthy individuals when performed correctly. Dr. Andrew Weil recommends starting with 4 cycles per session and not exceeding 8 cycles at a time. Beginners may feel mild lightheadedness as respiration slows; if this happens, stop and resume natural breathing. Individuals with respiratory or cardiovascular conditions should consult a healthcare provider before practicing breath holds."
        }
      }
    ]
  }
];
---

<Layout
  title="4-7-8 Breathing Technique & Relaxing Timer | HarmonyBreath"
  description="Master the 4-7-8 breathing method with our free online 4-7-8 breathing timer. Practice the 4-7-8 breathing technique for relaxation and winding down before sleep."
  keywords="4-7-8 breathing, 4-7-8 breathing method, 4-7-8 breathing technique, 4-7-8 breathing timer, relaxing breath technique, breathing exercise for sleep, 4-7-8 breathing benefits"
  canonicalUrl="https://harmonybreath.com/4-7-8-breathing/"
  image="https://harmonybreath.com/og-image.png"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <!-- Top Navigation & Hero Header -->
    <section class="w-full max-w-4xl mx-auto pt-8 pb-6 px-4 text-center space-y-4">
      <div class="flex items-center justify-center gap-2 mb-2">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-neutral-800 bg-neutral-900/80 text-neutral-400 hover:text-white text-xs font-mono transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to All Techniques
        </a>
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-400/30 bg-blue-400/10 text-blue-400 text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          4-7-8 Relaxing Breath
        </span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-bold tracking-normal text-white leading-tight">
        4-7-8 Breathing <br />
        <span class="gradient-text-develop">Free Guided Relaxing Timer</span>
      </h1>

      <p class="max-w-2xl mx-auto text-sm sm:text-base text-neutral-400 leading-relaxed font-sans font-light">
        Unwind your mind and body with our free online <strong class="text-neutral-200 font-medium">4-7-8 breathing timer</strong>. Popularized by Dr. Andrew Weil, the <strong class="text-neutral-200 font-medium">4-7-8 breathing technique</strong> uses an extended exhalation to encourage a slow, steady rhythm — a gentle practice often used before bed and during stressful moments.
      </p>
    </section>

    <!-- Main Interactive 4-7-8 Breathing Timer Component -->
    <Relaxing478Timer />

    <!-- Session Presets -->
    <RelaxingSessionPresets />

    <!-- Analytics Stats Panel -->
    <AnalyticsPanel exerciseId="4-7-8-breathing" />

    <!-- Step-by-Step Technique Guide -->
    <section class="w-full max-w-4xl mx-auto px-4 py-8">
      <div class="bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-8 backdrop-blur-xl space-y-6">
        <div class="flex items-center gap-3 border-b border-neutral-800 pb-4">
          <div class="w-8 h-8 rounded-full bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">How to Practice 4-7-8 Breathing</h3>
            <p class="text-xs text-neutral-400 font-mono">Follow this 3-step rhythm for maximum relaxation</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-4 rounded-2xl bg-neutral-900/50 border border-neutral-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-amber-400 font-semibold uppercase">Phase 1</span>
              <span class="text-xs font-mono text-neutral-500">4 Seconds</span>
            </div>
            <h4 class="text-base font-bold text-white">Inhale (Nose)</h4>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Close your mouth and inhale quietly through your nose for a count of 4. Expand your chest and abdomen smoothly.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-neutral-900/50 border border-neutral-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-cyan-400 font-semibold uppercase">Phase 2</span>
              <span class="text-xs font-mono text-neutral-500">7 Seconds</span>
            </div>
            <h4 class="text-base font-bold text-white">Hold Breath</h4>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Hold your breath comfortably for a count of 7. Keep your shoulders, jaw, and throat relaxed without straining.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-neutral-900/50 border border-neutral-800 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-400 font-semibold uppercase">Phase 3</span>
              <span class="text-xs font-mono text-neutral-500">8 Seconds</span>
            </div>
            <h4 class="text-base font-bold text-white">Exhale (Mouth)</h4>
            <p class="text-xs text-neutral-400 leading-relaxed">
              Exhale completely through your mouth for a count of 8, making a soft whoosh sound as air releases slowly.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Safety Precautions & Contraindications -->
    <section id="safety-section" class="w-full max-w-4xl mx-auto py-12 px-4 border-t border-neutral-900">
      <div class="bg-red-950/20 border border-red-500/30 rounded-2xl p-6 sm:p-8 backdrop-blur-md">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-lg bg-red-500/20 border border-red-500/30 text-red-400 flex items-center justify-center font-bold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">Essential Safety Guidelines</h3>
            <p class="text-xs text-neutral-400">Please read carefully before starting any breathing session.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-neutral-300">
          <div>
            <h4 class="font-bold text-red-400 uppercase tracking-wider mb-2 font-mono">NEVER Practice 4-7-8 Breathing:</h4>
            <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
              <li>While driving or operating any vehicle</li>
              <li>While swimming, bathing, or in water</li>
              <li>While operating machinery</li>
              <li>In any situation where fainting or dizziness could cause harm</li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-emerald-400 uppercase tracking-wider mb-2 font-mono">ALWAYS Practice:</h4>
            <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
              <li>Sitting comfortably with your back supported, or lying down in a safe, calm space</li>
              <li>Starting with 4 cycles per session — never exceed 8 cycles at a time</li>
              <li>Keeping your breath gentle and natural — never force the breath hold</li>
              <li>Stopping immediately and resuming normal breathing if you feel lightheaded, dizzy, or have chest pain</li>
            </ul>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-red-500/20 text-[11px] text-neutral-400 leading-relaxed font-mono">
          <strong>Medical Disclaimer:</strong> HarmonyBreath is for wellness and educational purposes only. It is not medical advice. Individuals with epilepsy, high blood pressure, heart conditions, respiratory conditions, or who are pregnant should consult a qualified doctor before practicing.
        </div>
      </div>
    </section>

    <!-- SEO Content Section (600+ words with target main & supporting keywords) -->
    <section class="w-full max-w-4xl mx-auto px-4 pb-12 pt-4">
      <div class="max-w-3xl mx-auto space-y-8 text-sm sm:text-base text-neutral-400 leading-relaxed font-sans font-light">
        
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Master the 4-7-8 Breathing Method with Our Guided Online Tool
          </h2>
          <p>
            Welcome to HarmonyBreath, your free web tool for mastering <strong class="text-white font-medium">4-7-8 breathing</strong>. Popularized by Integrative Medicine specialist Dr. Andrew Weil and rooted in traditional pranayama practice, the <strong class="text-white font-medium">4-7-8 breathing method</strong> is a slow, calming exercise many people use to unwind, ease tension, and settle into sleep.
          </p>
          <p>
            Whether you are coping with nighttime restlessness, workplace stress, or sudden anxious thoughts, our interactive <strong class="text-white font-medium">4-7-8 breathing timer</strong> offers visual pacing rings, customizable round counts, and relaxing ambient soundscapes to ensure an effortless breathwork experience.
          </p>
        </div>

        <div class="space-y-4 border-t border-neutral-900 pt-6">
          <h2 class="text-xl sm:text-2xl font-bold text-white">
            What Is the 4-7-8 Breathing Technique?
          </h2>
          <p>
            The <strong class="text-white font-medium">4-7-8 breathing technique</strong> is a structured pattern of controlled breathing based on a precise mathematical cadence: inhaling for 4 seconds, retaining the breath for 7 seconds, and exhaling slowly for 8 seconds.
          </p>
          <p>
            Unlike high-energy breathwork protocols intended to increase alertness, the 4-7-8 pattern is deliberately slow and gentle. Prolonging the exhalation to roughly twice the length of the inhalation naturally slows your breath and gives your mind a single, simple rhythm to follow — which is why many people reach for it at the end of the day.
          </p>
        </div>

        <div class="space-y-4 border-t border-neutral-900 pt-6">
          <h2 class="text-xl sm:text-2xl font-bold text-white">
            When to Practice 4-7-8 Breathing
          </h2>
          <p>
            The beauty of the <strong class="text-white font-medium">4-7-8 breathing method</strong> is that it fits into everyday life. Because it is slow and calming by design, it works well as a transition ritual rather than a high-energy workout.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
              <h3 class="text-base font-bold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-400"></span> Before Sleep
              </h3>
              <p class="text-xs text-neutral-400">
                A few cycles in bed — with the lights low and the timer on — makes a quiet, repeatable wind-down ritual for the end of the day.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
              <h3 class="text-base font-bold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400"></span> During Stressful Moments
              </h3>
              <p class="text-xs text-neutral-400">
                Between meetings, before a hard conversation, or anytime your mind is racing, a few slow cycles give you a moment to reset and refocus.
              </p>
            </div>
          </div>
          <p>
            Consistency beats intensity. A short daily session is far more rewarding than an occasional long one, and our timer removes the guesswork so you can simply follow along.
          </p>
        </div>

        <div class="space-y-4 border-t border-neutral-900 pt-6">
          <h2 class="text-xl sm:text-2xl font-bold text-white">
            The 4-7-8 Pattern for Sleep & Daily Calm
          </h2>
          <p>
            The <strong class="text-white font-medium">4-7-8 breathing technique</strong> centers on a simple, repeatable cadence: breathe in for 4 seconds, hold for 7 seconds, and exhale for 8 seconds. The long, even exhale is what gives the practice its relaxed, unhurried feel.
          </p>
          <p>
            As you repeat the cycle, your breathing naturally becomes slower and more even, and your attention settles on the rhythm instead of wandering thoughts. With regular practice, the pattern becomes familiar enough to call on whenever you need to slow down — whether that is at night, on a break, or before something demanding.
          </p>
        </div>

        <div class="space-y-4 border-t border-neutral-900 pt-6">
          <h2 class="text-xl sm:text-2xl font-bold text-white">
            Features of Our Interactive 4-7-8 Breathing Timer
          </h2>
          <p>
            HarmonyBreath's free <strong class="text-white font-medium">4-7-8 breathing timer</strong> is designed from the ground up to support a seamless practice session:
          </p>
          <ul class="space-y-3 text-neutral-300">
            <li class="flex items-start gap-2">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong class="text-white">Real-Time Visual Guidance:</strong> An interactive glowing aura and smooth circular ring expand during inhale (4s), hold during retention (7s), and contract during exhale (8s).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong class="text-white">Preset & Custom Modes:</strong> Choose from standard session presets (Beginner 4 cycles, Calm 8 cycles, Deep 12 cycles, Sleep Prep 16 cycles) or customize phase lengths to match your breath capacity.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong class="text-white">Audio Chimes & Ambient Tracks:</strong> Gentle phase sounds notify you when to inhale, hold, and exhale, allowing you to practice comfortably with your eyes closed.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-blue-400 font-bold">•</span>
              <span><strong class="text-white">Privacy-First Local Analytics:</strong> Your session history and streak data stay strictly inside your browser storage—100% free with zero registration required.</span>
            </li>
          </ul>
        </div>

      </div>
    </section>

    <!-- FAQ Section -->
    <section class="w-full max-w-4xl mx-auto px-4 pb-16 border-t border-neutral-900 pt-12">
      <div class="max-w-3xl mx-auto space-y-8">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-white">Frequently Asked Questions</h2>
          <p class="text-neutral-400 text-xs sm:text-sm">Everything you need to know about practicing 4-7-8 relaxing breath</p>
        </div>

        <div class="space-y-4">
          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
            <h3 class="text-base font-bold text-white">How does 4-7-8 breathing work?</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              The 4-7-8 breathing method works by using a specific timing pattern — inhaling for 4 seconds, holding the breath for 7 seconds, and exhaling for 8 seconds. The extended exhalation naturally slows the pace of your breath and keeps your attention on the rhythm, which many people find calming.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
            <h3 class="text-base font-bold text-white">Does the 4-7-8 sleep trick really work?</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              Many people find the 4-7-8 sleep trick helpful as a nightly wind-down ritual. By slowing your breathing and giving your mind a single rhythm to follow, it can help quiet a racing mind and ease the transition toward rest.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
            <h3 class="text-base font-bold text-white">How many times a day should I do 4-7-8 breathing?</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              Dr. Andrew Weil suggests practicing 4-7-8 breathing at least twice a day. Beginners should start with 4 cycles per session, and with regular daily practice, you can gradually increase up to 8 cycles per session.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
            <h3 class="text-base font-bold text-white">How long does it take to fall asleep with 4 / 7 / 8 breathing?</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              With regular daily practice, many people report drifting off within 1 to 2 minutes (about 4 to 8 breath cycles) after finishing the exercise. Beginners may need 2 to 4 weeks of consistent practice to feel comfortable with the rhythm.
            </p>
          </div>

          <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
            <h3 class="text-base font-bold text-white">Is 4-7-8 breathing dangerous?</h3>
            <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
              4-7-8 breathing is a gentle practice that is safe for most healthy individuals when performed correctly. Dr. Andrew Weil recommends starting with 4 cycles per session and not exceeding 8 cycles at a time. Beginners may feel mild lightheadedness as respiration slows; if this happens, stop and resume natural breathing. Individuals with respiratory or cardiovascular conditions should consult a healthcare provider before practicing breath holds.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Explore Other Techniques -->
    <ExploreOtherTechniques current="4-7-8-breathing" accent="blue" />
  </main>

  <Footer />
</Layout>
