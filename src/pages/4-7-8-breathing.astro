---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Relaxing478Timer from '../components/Relaxing478Timer.astro';
import RelaxingSessionPresets from '../components/RelaxingSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: '4-7-8 Breathing', url: '/4-7-8-breathing/' },
];

const datePublished = '2026-07-25';
const dateModified = '2026-08-15';

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HarmonyBreath — 4-7-8 Relaxing Breath Timer",
    "alternateName": "HarmonyBreath 4-7-8 Guided Breathwork App",
    "description": "Free guided 4-7-8 breathing timer with audio cues, customizable cycle counts, ambient soundscapes, and session tracking. Practice the 4-7-8 breathing method for calm and relaxation.",
    "url": "https://harmonybreath.com/4-7-8-breathing",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided 4-7-8 breathing timer with visual and acoustic feedback",
      "Customizable 4-7-8 breathing method timing parameters and round presets",
      "Relaxation-focused 4-7-8 technique guidance for sleep prep and calm",
      "Ambient soundscape player and real-time phase indicators",
      "Private browser-local session analytics with zero data tracking"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "4-7-8 Breathing Technique: Free Guided Relaxing Timer & Science Guide",
    "description": "Master the 4-7-8 breathing method with our free online timer. Learn the physiological mechanisms, sleep benefits, and scientific citations for Dr. Andrew Weil's relaxing breath.",
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "mainEntityOfPage": "https://harmonybreath.com/4-7-8-breathing/",
    "citation": [
      "https://pubmed.ncbi.nlm.nih.gov/36630953/",
      "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9316023/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HarmonyBreath 4-7-8 Breathing Timer",
    "description": "Free online 4-7-8 breathing timer for practicing the 4-7-8 breathing technique. A structured inhale-hold-exhale pattern for relaxation and winding down.",
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does 4-7-8 breathing work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The 4-7-8 breathing method works by using a specific timing pattern — inhaling for 4 seconds, holding the breath for 7 seconds, and exhaling for 8 seconds. The extended exhalation naturally slows the pace of your breath and keeps your attention on the rhythm, which many people find calming."
        }
      },
      {
        "@type": "Question",
        "name": "Does the 4-7-8 sleep trick really work?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Many people find the 4-7-8 sleep trick helpful as a nightly wind-down ritual. By slowing your breathing and giving your mind a single rhythm to follow, it can help quiet a racing mind and ease the transition toward rest."
        }
      },
      {
        "@type": "Question",
        "name": "How many times a day should I do 4-7-8 breathing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dr. Andrew Weil suggests practicing 4-7-8 breathing at least twice a day. Beginners should start with 4 cycles per session, and with regular daily practice, you can gradually increase up to 8 cycles per session."
        }
      },
      {
        "@type": "Question",
        "name": "How long does it take to fall asleep with 4 / 7 / 8 breathing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "With regular daily practice, many people report drifting off within 1 to 2 minutes (about 4 to 8 breath cycles) after finishing the exercise. Beginners may need 2 to 4 weeks of consistent practice to feel comfortable with the rhythm."
        }
      },
      {
        "@type": "Question",
        "name": "Is 4-7-8 breathing dangerous?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "4-7-8 breathing is a gentle practice that is safe for most healthy individuals when performed correctly. Dr. Andrew Weil recommends starting with 4 cycles per session and not exceeding 8 cycles at a time. Beginners may feel mild lightheadedness as respiration slows; if this happens, stop and resume natural breathing. Individuals with respiratory or cardiovascular conditions should consult a healthcare provider before practicing breath holds."
        }
      }
    ]
  }
];
---

<Layout
  title="4-7-8 Breathing Technique & Relaxing Timer | HarmonyBreath"
  description="Master the 4-7-8 breathing method with our free online 4-7-8 breathing timer. Practice the 4-7-8 breathing technique for relaxation and winding down before sleep."
  keywords="4-7-8 breathing, 4-7-8 breathing method, 4-7-8 breathing technique, 4-7-8 breathing timer, relaxing breath technique, breathing exercise for sleep, 4-7-8 breathing benefits"
  canonicalUrl="https://harmonybreath.com/4-7-8-breathing/"
  image="https://harmonybreath.com/og-image.png"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
>
  <Header />

  <main class="flex-1 bg-[#06080d] text-white relative selection:bg-blue-500/30 selection:text-blue-200">
    <!-- Fixed Persistent Atmospheric Background Image -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img 
        src="/4-7-8-breathing.png" 
        alt="" 
        class="w-full h-full object-cover object-center filter brightness-[0.7] contrast-110 saturate-110 scale-105"
      />
      <!-- Page-wide Gradient & Radial Ambient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/50 to-[#06080d]/95"></div>
      <div class="absolute inset-0 bg-radial from-blue-500/15 via-transparent to-transparent"></div>
      <div class="absolute inset-0 noise-overlay opacity-15"></div>
    </div>

    <!-- Scrolling Page Content Container -->
    <div class="relative z-10 w-full">
      <!-- Hero Header Section -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col items-center">
        <!-- Floating Glass Nav Pill Bar -->
        <header class="w-full max-w-4xl mx-auto mb-10 sm:mb-14">
          <nav class="flex flex-wrap items-center justify-between gap-3 p-2 sm:px-4 sm:py-2.5 rounded-full border border-white/15 bg-neutral-950/80 backdrop-blur-2xl shadow-2xl shadow-blue-950/30">
            <!-- Brand Badge -->
            <div class="flex items-center gap-2.5 px-3 py-1">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-400 animate-pulse shadow-[0_0_12px_#60a5fa]"></span>
              <span class="text-xs sm:text-sm font-bold tracking-wider text-white uppercase font-mono">
                4-7-8 <span class="text-blue-400">BREATHING</span>
              </span>
            </div>

            <!-- Jump Links (Pills) -->
            <div class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-neutral-300">
              <a href="#relax-timer-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Timer</a>
              <a href="#presets" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Presets</a>
              <a href="#analytics" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Stats</a>
              <a href="#guide" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">Guide</a>
              <a href="#about-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">About</a>
              <a href="#faq-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">FAQ</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
              <a 
                href="/" 
                class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono text-neutral-400 hover:text-white bg-neutral-900/80 border border-white/10 hover:border-white/20 transition-all"
              >
                ← All Techniques
              </a>
              <a 
                href="#relax-timer-section" 
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-neutral-950 bg-white hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)]"
              >
                <span>Start Practice</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l7-7m7-7H3" />
                </svg>
              </a>
            </div>
          </nav>
        </header>

        <!-- Hero Headline & Subtitle -->
        <div class="text-center space-y-6 max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-white text-xs font-mono tracking-wide">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>DEEP RELAXATION & SLEEP INDUCTION ENGINE</span>
          </div>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] text-balance drop-shadow-xl">
            4-7-8 Breathing <br />
            Deep Relaxing Breath
          </h1>

          <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-300 font-light leading-relaxed text-pretty">
            Unwind your mind and body with our free online guided 4-7-8 breathing timer. Popularized by Dr. Andrew Weil, the 4-7-8 technique uses extended exhalation to trigger deep nervous system calm.
          </p>

          <!-- Authorship & Quick Metadata -->
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-neutral-400 pt-2">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              100% Free & Private
            </span>
            <span class="text-neutral-600">•</span>
            <span>By HarmonyBreath Editorial</span>
            <span class="text-neutral-600">•</span>
            <span>Published {datePublished} · Updated {dateModified}</span>
          </div>
        </div>
      </section>

      <!-- Main Interactive 4-7-8 Breathing Timer Component -->
      <Relaxing478Timer />

      <!-- Session Presets -->
      <div id="presets" class="scroll-mt-20">
        <RelaxingSessionPresets />
      </div>

      <!-- Analytics Stats Panel -->
      <div id="analytics" class="scroll-mt-20">
        <AnalyticsPanel exerciseId="4-7-8-breathing" />
      </div>

      <!-- Step-by-Step Technique Guide -->
      <section id="guide" class="w-full max-w-4xl mx-auto px-4 py-8 scroll-mt-20">
        <div class="bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-8 backdrop-blur-xl space-y-6">
        <div class="flex items-center gap-3 border-b border-neutral-800 pb-4">
          <div class="w-8 h-8 rounded-full bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-blue-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">How to Practice 4-7-8 Breathing</h3>
            <p class="text-xs text-neutral-400 font-mono">Follow this 3-step rhythm for maximum relaxation</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="reveal p-6 rounded-2xl bg-neutral-900/50 border border-neutral-800 space-y-2 group hover:border-blue-500/30 hover:bg-neutral-900/70 hover:-translate-y-0.5 transition-all duration-300">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-400 font-semibold uppercase">Phase 1</span>
              <span class="text-xs font-mono text-neutral-500">4 Seconds</span>
            </div>
            <h4 class="text-base font-bold text-white">Inhale (Nose)</h4>
            <p class="text-xs text-neutral-400 leading-relaxed text-pretty">
              Close your mouth and inhale quietly through your nose for a count of 4. Expand your chest and abdomen smoothly.
            </p>
          </div>

          <div class="reveal p-6 rounded-2xl bg-neutral-900/50 border border-neutral-800 space-y-2 group hover:border-blue-500/30 hover:bg-neutral-900/70 hover:-translate-y-0.5 transition-all duration-300 md:mt-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-400 font-semibold uppercase">Phase 2</span>
              <span class="text-xs font-mono text-neutral-500">7 Seconds</span>
            </div>
            <h4 class="text-base font-bold text-white">Hold Breath</h4>
            <p class="text-xs text-neutral-400 leading-relaxed text-pretty">
              Hold your breath comfortably for a count of 7. Keep your shoulders, jaw, and throat relaxed without straining.
            </p>
          </div>

          <div class="reveal p-6 rounded-2xl bg-neutral-900/50 border border-neutral-800 space-y-2 group hover:border-blue-500/30 hover:bg-neutral-900/70 hover:-translate-y-0.5 transition-all duration-300 md:-mt-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-blue-400 font-semibold uppercase">Phase 3</span>
              <span class="text-xs font-mono text-neutral-500">8 Seconds</span>
            </div>
            <h4 class="text-base font-bold text-white">Exhale (Mouth)</h4>
            <p class="text-xs text-neutral-400 leading-relaxed text-pretty">
              Exhale completely through your mouth for a count of 8, making a soft whoosh sound as air releases slowly.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Safety Precautions & Contraindications -->
    <section id="safety-section" class="w-full max-w-4xl mx-auto py-12 px-4 border-t border-neutral-900">
      <div class="reveal bg-red-950/20 border border-red-500/30 rounded-2xl p-6 sm:p-8 backdrop-blur-md">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-lg bg-red-500/20 border border-red-500/30 text-red-400 flex items-center justify-center">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white">Essential Safety Guidelines</h3>
            <p class="text-xs text-neutral-400">Please read carefully before starting any breathing session.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-neutral-300">
          <div>
            <h4 class="font-bold text-red-400 uppercase tracking-wider mb-2 font-mono">NEVER Practice 4-7-8 Breathing:</h4>
            <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
              <li>While driving or operating any vehicle</li>
              <li>While swimming, bathing, or in water</li>
              <li>While operating machinery</li>
              <li>In any situation where fainting or dizziness could cause harm</li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-emerald-400 uppercase tracking-wider mb-2 font-mono">ALWAYS Practice:</h4>
            <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
              <li>Sitting comfortably with your back supported, or lying down in a safe, calm space</li>
              <li>Starting with 4 cycles per session — never exceed 8 cycles at a time</li>
              <li>Keeping your breath gentle and natural — never force the breath hold</li>
              <li>Stopping immediately and resuming normal breathing if you feel lightheaded, dizzy, or have chest pain</li>
            </ul>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-red-500/20 text-[11px] text-neutral-400 leading-relaxed font-mono">
          <strong>Medical Disclaimer:</strong> HarmonyBreath is for wellness and educational purposes only. It is not medical advice. Individuals with epilepsy, high blood pressure, heart conditions, respiratory conditions, or who are pregnant should consult a qualified doctor before practicing.
        </div>
      </div>
    </section>

    <!-- SEO Content Section (600+ words with target main & supporting keywords) -->
    <section id="478-about-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-widest text-blue-400">About 4-7-8 Breathing</h2>
        <h3 class="text-3xl font-bold text-white sm:text-4xl text-balance">
          What Is the 4-7-8 Breathing Method?
        </h3>
        <p class="text-sm text-neutral-400">
          Everything you need to know about the 4-7-8 relaxing breath — from the science behind the pattern to how our guided timer helps you wind down.
        </p>
      </div>

      <div class="space-y-8 text-sm text-neutral-300 leading-relaxed text-pretty">
        <div class="reveal p-4 rounded-xl border border-neutral-800 bg-neutral-900/50 text-xs text-neutral-300 font-sans flex items-start gap-3 backdrop-blur-md">
          <span class="shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </span>
          <div>
            <strong class="text-white font-medium">Scientific Research & Editorial Disclosure:</strong> Content on this page is compiled from published physiological research, integrative medicine guidelines, and peer-reviewed clinical studies. Our goal is to explain the biological mechanisms behind the 4-7-8 breath while providing free, interactive guided timers.
          </div>
        </div>

        <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">Master the 4-7-8 breathing method with our guided online tool</h4>
          <p class="mb-4">
            Welcome to HarmonyBreath, your free web tool for mastering <strong class="text-white">4-7-8 breathing</strong>. Popularized by Integrative Medicine specialist Dr. Andrew Weil and rooted in traditional pranayama practice, the <strong class="text-white">4-7-8 breathing method</strong> is a slow, calming exercise many people use to unwind, ease tension, and settle into sleep.
          </p>
          <p>
            Whether you are coping with nighttime restlessness, workplace stress, or sudden anxious thoughts, our interactive <strong class="text-white">4-7-8 breathing timer</strong> offers visual pacing rings, customizable round counts, and relaxing ambient soundscapes to ensure an effortless breathwork experience.
          </p>
        </div>

        <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">The physiology & science behind 4-7-8 breathing</h4>
          <p class="mb-4">
            The effectiveness of the 4-7-8 technique rests on basic autonomic nervous system mechanisms:
          </p>
          <ul class="space-y-2 list-disc list-inside text-neutral-400">
            <li><strong class="text-white">Vagus Nerve Activation via Extended Exhalation (8 Seconds):</strong> Inhalation naturally accelerates heart rate slightly, while exhalation slows it down (respiratory sinus arrhythmia). Because the exhalation phase (8 seconds) is twice as long as the inhalation phase (4 seconds), each cycle stimulates the vagus nerve, lowering heart rate and activating parasympathetic "rest-and-digest" tone.</li>
            <li><strong class="text-white">Oxygen & Blood Gas Stabilization (7-Second Hold):</strong> Holding your breath for 7 seconds allows oxygen to thoroughly diffuse into bloodstream capillaries while gently elevating blood carbon dioxide (CO2) levels. This brief pause signals to the brainstem's locus coeruleus that the body is safe, halting acute fight-or-flight signaling.</li>
            <li><strong class="text-white">Sleep Onset & Cortisol Dampening:</strong> Practicing 4-7-8 breathing before bed lowers nocturnal cortisol levels and reduces cognitive rumination, creating optimal physiological conditions for falling asleep faster.</li>
          </ul>
        </div>

        <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">When to practice 4-7-8 breathing</h4>
          <p class="mb-4">
            The beauty of the <strong class="text-white">4-7-8 breathing method</strong> is that it fits into everyday life. Because it is slow and calming by design, it works well as a transition ritual rather than a high-energy workout.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-4">
            <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
              <h5 class="text-base font-bold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-400"></span> Before Sleep
              </h5>
              <p class="text-xs text-neutral-400">
                A few cycles in bed — with the lights low and the timer on — makes a quiet, repeatable wind-down ritual for the end of the day.
              </p>
            </div>
            <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
              <h5 class="text-base font-bold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-400"></span> During Stressful Moments
              </h5>
              <p class="text-xs text-neutral-400">
                Between meetings, before a hard conversation, or anytime your mind is racing, a few slow cycles give you a moment to reset and refocus.
              </p>
            </div>
          </div>
          <p>
            Consistency beats intensity. A short daily session is far more rewarding than an occasional long one, and our timer removes the guesswork so you can simply follow along.
          </p>
        </div>

        <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">The 4-7-8 pattern for sleep & daily calm</h4>
          <p class="mb-4">
            The <strong class="text-white">4-7-8 breathing technique</strong> centers on a simple, repeatable cadence: breathe in for 4 seconds, hold for 7 seconds, and exhale for 8 seconds. The long, even exhale is what gives the practice its relaxed, unhurried feel.
          </p>
          <p>
            As you repeat the cycle, your breathing naturally becomes slower and more even, and your attention settles on the rhythm instead of wandering thoughts. With regular practice, the pattern becomes familiar enough to call on whenever you need to slow down — whether that is at night, on a break, or before something demanding.
          </p>
        </div>

        <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-lg font-bold text-white mb-3">Features of our interactive 4-7-8 breathing timer</h4>
          <p class="mb-4">
            HarmonyBreath's free <strong class="text-white">4-7-8 breathing timer</strong> is designed from the ground up to support a seamless practice session:
          </p>
          <ul class="space-y-3 text-neutral-300">
