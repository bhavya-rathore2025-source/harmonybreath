---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms & Conditions — HarmonyBreath';
const description = 'HarmonyBreath terms and conditions. By using our breathwork platform, you agree to these terms. Educational and wellness tool only, not medical advice.';
const canonicalUrl = 'https://harmonybreath.com/terms/';
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <Header />

  <main class="flex-1 hero-gradient-mesh relative">
    <section class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <div class="text-center space-y-4 mb-12">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs font-mono">
          Terms of Service
        </span>
        <h1 class="text-4xl sm:text-5xl font-bold text-white">Terms & Conditions</h1>
        <p class="text-neutral-400 max-w-2xl mx-auto text-sm font-sans font-light">Last updated: July 27, 2026</p>
      </div>

      <div class="max-w-3xl mx-auto space-y-6 text-sm sm:text-base text-neutral-300 leading-relaxed font-sans font-light [&_h2]:text-white [&_h2]:text-xl [&_h2]:sm:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-white [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_strong]:text-white [&_strong]:font-medium [&_ul]:list-disc [&_ul]:list-inside [&_ul]:space-y-2 [&_ul]:text-neutral-400">
        <h2>Acceptance of Terms</h2>
        <p>
          By accessing or using HarmonyBreath (the "Service"), you agree to be bound by these Terms & Conditions. If you do not agree, please do not use the Service. We reserve the right to update these terms at any time, with changes effective upon posting.
        </p>

        <h2>Educational Purpose Only</h2>
        <p>
          HarmonyBreath provides educational content and guided breathing tools for general wellness purposes. The Service is <strong>not a medical device</strong> and does not diagnose, treat, cure, or prevent any disease or medical condition. Always consult a qualified healthcare professional before beginning any breathing or wellness practice, especially if you have a pre-existing medical condition.
        </p>

        <h2>User Responsibility</h2>
        <p>By using HarmonyBreath, you acknowledge and agree to the following:</p>
        <ul>
          <li>You practice breathing techniques at your own risk, in a safe environment (seated or lying down).</li>
          <li>You will not practice breathing techniques while driving, swimming, operating machinery, or in any situation where altered consciousness could cause harm.</li>
          <li>You will stop immediately if you feel dizzy, lightheaded, or uncomfortable.</li>
          <li>You are responsible for your own safety and well-being during practice.</li>
          <li>You will not use the Service for any unlawful purpose or in violation of any applicable laws.</li>
        </ul>

        <h2>Medical Disclaimer</h2>
        <p>
          <strong>WARNING:</strong> Breathing exercises, particularly advanced techniques like the Wim Hof Method, can cause tingling sensations, lightheadedness, altered consciousness, and in rare cases, loss of consciousness. Do not practice in or near water, while driving, or in any environment where loss of consciousness could result in injury. Persons with the following conditions should consult a doctor before practicing: epilepsy, high or low blood pressure, cardiovascular disease, glaucoma, pregnancy, recent surgery, panic disorder, or any respiratory condition.
        </p>

        <h2>Intellectual Property</h2>
        <p>
          All content on HarmonyBreath, including text, graphics, logos, and software, is our property or used with permission. You may use the Service for personal, non-commercial purposes. You may not reproduce, distribute, modify, or create derivative works without explicit permission.
        </p>

        <h2>Limitation of Liability</h2>
        <p>
          HarmonyBreath and its creators shall not be liable for any direct, indirect, incidental, consequential, or special damages arising from your use of or inability to use the Service. This includes but is not limited to physical injury, property damage, or data loss. The Service is provided "as is" without warranty of any kind.
        </p>

        <h2>No Account Required</h2>
        <p>
          HarmonyBreath does not require user accounts, registration, or any personal information. All preferences and session history are stored locally in your browser and can be cleared at any time.
        </p>

        <h2>Governing Law</h2>
        <p>
          These terms shall be governed by and construed in accordance with the laws. Any disputes arising from these terms shall be resolved through amicable negotiation.
        </p>

        <h2>Contact</h2>
        <p>
          For questions about these terms, please <a href="/contact/" class="text-amber-400 hover:text-amber-300 underline underline-offset-2">contact us</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
