---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  keywords?: string;
  schemaData?: any[];
  breadcrumb?: { name: string; url: string }[];
  robots?: string;
}

const {
  title = 'Wim Hof Breathing — Free Guided Timer & Breathwork App | HarmonyBreath',
  description = 'Master the Wim Hof breathing technique with our free guided timer. Practice Wim Hof method breathing with customizable retention holds, audio cues, and session analytics. 100% free & private.',
  image = 'https://harmonybreath.com/og-image.png',
  canonicalUrl = 'https://harmonybreath.com',
  keywords = 'wim hof breathing, wim hof method, wim hof breathing technique, guided breathing, breathwork timer, wim hof timer online, breathing exercises',
  robots = 'index, follow',
} = Astro.props;

const defaultSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HarmonyBreath — Wim Hof Breathing Timer",
    "alternateName": "HarmonyBreath Wim Hof Guided Breathing App",
    "description": "Free guided Wim Hof breathing timer with customizable retention holds, audio cues, and session tracking. Practice the Wim Hof method online with beginner to expert difficulty presets.",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided Wim Hof 3-phase breathing sessions",
      "Configurable difficulty presets (Beginner to Expert)",
      "Custom breath count and retention hold duration",
      "Local audio track support and silent fallbacks",
      "Local progress tracking and retention records",
      "100% free, privacy-first, no registration needed"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HarmonyBreath Wim Hof Breathing Timer",
    "description": "Free online Wim Hof breathing timer with guided sessions, breath retention tracking, and customizable difficulty levels. Practice the Wim Hof breathing method safely.",
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
];

const schemaData = Astro.props.schemaData ?? defaultSchemaData;
const breadcrumb = Astro.props.breadcrumb;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Breath" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0c0a09" />
    <meta name="author" content="HarmonyBreath" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="HarmonyBreath" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:site" content="@harmonybreath" />
    <meta name="twitter:creator" content="@harmonybreath" />

    <!-- Web Fonts: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

       <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    {breadcrumb && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": breadcrumb.map((item, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": item.name,
            "item": `https://harmonybreath.com${item.url}`
          }))
        })}
      />
    )}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RL5BBWJ3Q7"></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500,
      });

      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);

      gtag('js', new Date());
      gtag('config', 'G-RL5BBWJ3Q7');
    </script>

  </head>

  <body class="bg-neutral-950 text-white selection:bg-neutral-700 selection:text-white flex flex-col min-h-screen">
    <slot />
    <CookieConsent />
  </body>
</html>
