---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { getLangFromUrl } from '../i18n/utils';
import { languageMeta, type SupportedLanguage } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  keywords?: string;
  schemaData?: any[];
  breadcrumb?: { name: string; url: string }[];
  robots?: string;
  ogType?: string;
  lang?: string;
  hreflangLinks?: { lang: string; href: string }[];
}

const {
  title = 'HarmonyBreath — Free Guided Breathing Timers & Breathwork Techniques',
  description = 'Free online guided breathing timer for Wim Hof, Box Breathing & 4-7-8. Practice breathwork with audio cues, custom intervals & no sign-up required.',
  image = 'https://harmonybreath.com/og-image.png',
  imageAlt = 'HarmonyBreath Guided Breathing App',
  canonicalUrl: customCanonicalUrl,
  keywords = 'guided breathing timer, breathing exercises, breathwork timer, wim hof breathing, box breathing, 4-7-8 breathing, calming breathing, breathing techniques, free breathwork app',
  robots = 'index, follow',
  ogType = 'website',
  lang: customLang,
  hreflangLinks,
} = Astro.props;

const currentLang = (customLang || getLangFromUrl(Astro.url)) as SupportedLanguage;
const ogLocale = languageMeta[currentLang]?.ogLocale || 'en_US';

const siteUrl = Astro.site ? Astro.site.href : 'https://harmonybreath.com';
const canonicalUrl = customCanonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = image.startsWith('http://') || image.startsWith('https://') ? image : new URL(image, siteUrl).href;
const ogImageType = ogImageUrl.endsWith('.jpg') || ogImageUrl.endsWith('.jpeg') ? 'image/jpeg' : 'image/png';

const defaultSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "HarmonyBreath — Free Guided Breathing Timer",
    "alternateName": "HarmonyBreath Guided Breathwork App",
    "description": "Free online guided breathing timers for popular breathwork techniques including Wim Hof, Box Breathing, and 4-7-8. Customizable sessions, audio cues, ambient soundscapes, and local progress tracking.",
    "url": canonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided timers for multiple breathing techniques",
      "Customizable phase durations and session presets",
      "Audio cues and ambient soundscape support",
      "Local progress tracking and session history",
      "100% free, privacy-first, no registration needed"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HarmonyBreath Breathing Timer",
    "description": "Free online breathing timer with guided sessions for Wim Hof breathing, box breathing, and 4-7-8 breathing. Customizable durations, audio cues, and local session tracking.",
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
];

const schemaData = Astro.props.schemaData ?? defaultSchemaData;
const breadcrumb = Astro.props.breadcrumb;
---

<!doctype html>
<html lang={currentLang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Breath" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks && hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0c0a09" />
    <meta name="author" content="HarmonyBreath" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="HarmonyBreath" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:site" content="@harmonybreath" />
    <meta name="twitter:creator" content="@harmonybreath" />

    <!-- Web Fonts: Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

       <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    {breadcrumb && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": breadcrumb.map((item, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": item.name,
            "item": new URL(item.url, siteUrl).href
          }))
        })}
      />
    )}

    <!-- Google Analytics & Consent Mode v2 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }

      // Default all consent parameters to denied before tags load
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);

      // Immediately restore consent if previously granted by user
      try {
        if (localStorage.getItem('hb-cookie-consent') === 'accepted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            analytics_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            functionality_storage: 'granted',
            personalization_storage: 'granted',
            security_storage: 'granted',
          });
        }
      } catch (e) {}
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-RL5BBWJ3Q7"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-RL5BBWJ3Q7');
    </script>

  </head>

  <body class="bg-neutral-950 text-white selection:bg-neutral-700 selection:text-white flex flex-col min-h-screen">
    <slot />
    <CookieConsent lang={currentLang} />
  </body>
</html>
