---
---

<div id="sigh-custom-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden p-4">
  <div class="w-full max-w-md bg-neutral-950 border border-neutral-800 rounded-2xl p-6 shadow-2xl space-y-6">
    <div class="flex items-center justify-between border-b border-neutral-800 pb-4">
      <h3 class="text-base font-bold text-white flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Custom Physiological Sigh Settings
      </h3>
      <button id="close-sigh-custom-modal" class="text-neutral-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="text-xs text-neutral-500 font-mono leading-relaxed -mt-2">
      Customize the double inhale, prolonged exhale, and total cycles for your session.
    </div>

    <!-- First Inhale Duration -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>First Inhale (Nose)</span>
        <span id="sigh-custom-inhale1-val" class="text-emerald-400 font-bold">3s</span>
      </div>
      <input
        type="range"
        id="sigh-custom-inhale1-input"
        min="1"
        max="10"
        step="1"
        value="3"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-emerald-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>1s</span>
        <span>10s</span>
      </div>
    </div>

    <!-- Second Inhale (Sharp Sip) Duration -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Second Inhale / Sharp Sip (Nose)</span>
        <span id="sigh-custom-inhale2-val" class="text-cyan-400 font-bold">1s</span>
      </div>
      <input
        type="range"
        id="sigh-custom-inhale2-input"
        min="1"
        max="5"
        step="1"
        value="1"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>1s</span>
        <span>5s</span>
      </div>
    </div>

    <!-- Exhale Duration -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Long Exhale (Mouth)</span>
        <span id="sigh-custom-exhale-val" class="text-teal-400 font-bold">6s</span>
      </div>
      <input
        type="range"
        id="sigh-custom-exhale-input"
        min="2"
        max="15"
        step="1"
        value="6"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-teal-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>2s</span>
        <span>15s</span>
      </div>
    </div>

    <!-- Total Cycles -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Total Cycles</span>
        <span id="sigh-custom-cycles-val" class="text-indigo-400 font-bold">10 Cycles</span>
      </div>
      <input
        type="range"
        id="sigh-custom-cycles-input"
        min="1"
        max="50"
        step="1"
        value="10"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-indigo-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>1 Cycle</span>
        <span>50 Cycles</span>
      </div>
    </div>

    <div class="pt-4 flex gap-3">
      <button
        id="apply-sigh-custom"
        type="button"
        class="flex-1 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-semibold text-xs transition-colors shadow-lg shadow-emerald-500/10"
      >
        Apply Custom Session
      </button>
    </div>
  </div>
</div>
