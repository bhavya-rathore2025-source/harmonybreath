const currentI18n = boxTimerI18n[lang] || boxTimerI18n.en;
---

<section id="box-timer-section" class="reveal w-full max-w-4xl mx-auto py-8 px-4">
  <!-- Hidden JSON dictionary for client script hydration -->
  <script is:inline id="hb-box-timer-i18n" type="application/json" set:html={JSON.stringify(currentI18n)} />

  <div class="relative w-full border border-white/15 bg-neutral-950/80 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-2xl overflow-hidden shadow-amber-950/20">
    <div class="noise-overlay absolute inset-0 opacity-[0.04] pointer-events-none"></div>
    <div id="box-phase-glow" class="absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-amber-500/20 via-transparent to-transparent"></div>

    <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 border-b border-neutral-800/60 pb-6 mb-8">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span id="box-preset-badge" class="px-3 py-1 rounded-full text-xs font-mono font-medium border border-amber-400/30 bg-amber-400/10 text-amber-400 max-w-full break-words">
          {currentI18n.presetStandard}
        </span>
        <span id="box-cycle-badge" class="text-xs font-mono text-neutral-400 whitespace-nowrap">
          {currentI18n.cyclePrefix} <span id="box-current-cycle-text" class="text-white font-bold">1</span> {currentI18n.cycleOf} <span id="box-total-cycles-text" class="text-white font-bold">20</span>
        </span>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400 shrink-0">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping shrink-0"></span>
        <span id="box-phase-label" class="uppercase tracking-wider font-semibold text-emerald-400 break-words">{currentI18n.ready}</span>
      </div>
    </div>

    <div class="relative z-10 flex flex-col items-center justify-center my-6">
      <div
        id="box-circle-action"
        role="button"
        tabindex="0"
        aria-label={currentI18n.btnStart || 'Start Session'}
        title={currentI18n.btnStart || 'Start Session'}
        class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center cursor-pointer select-none rounded-2xl sm:rounded-3xl transition-transform duration-200 hover:scale-[1.02] active:scale-[0.98] focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-400/50"
      >
        <div class="breath-square absolute inset-2 rounded-2xl border border-dashed border-amber-400/25 pointer-events-none"></div>
        <div class="breath-square-pulse absolute -inset-1 rounded-[1.75rem] border border-amber-400/10 pointer-events-none"></div>
        <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="3" class="text-neutral-900" fill="none" />
          <circle
            id="box-progress-circle"
            cx="50"
            cy="50"
            r="44"
            stroke="url(#box-gradient-accent)"
            stroke-width="3.5"
            stroke-dasharray="276.46"
            stroke-dashoffset="0"
            stroke-linecap="round"
            class="transition-all duration-300"
            fill="none"
          />
          <defs>
            <linearGradient id="box-gradient-accent" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#d4a574" />
              <stop offset="50%" stop-color="#50e3c2" />
              <stop offset="100%" stop-color="#7cba9a" />
            </linearGradient>
          </defs>
        </svg>

        <div id="box-breath-halo" class="absolute w-44 h-44 rounded-full bg-gradient-to-tr from-amber-500/15 via-cyan-500/15 to-emerald-500/15 transition-transform duration-[2500ms] ease-in-out scale-100 flex items-center justify-center border border-white/5 pointer-events-none"></div>

        <div class="relative z-20 flex flex-col items-center text-center pointer-events-none">
          <div id="box-breath-action-text" class="text-xs font-mono uppercase tracking-widest text-amber-400 mb-1">
            {currentI18n.pressStart}
          </div>

          <div id="box-primary-counter" class="text-5xl sm:text-6xl font-bold tracking-normal font-mono-numbers text-white">
            00:00
          </div>

          <div id="box-secondary-counter" class="text-xs font-mono text-neutral-400 mt-2">
            4{currentI18n.perPhase}
          </div>
        </div>
      </div>

      <div class="mt-6 flex items-center gap-3 text-xs text-neutral-500 bg-neutral-900/40 border border-neutral-800/60 px-4 py-2 rounded-full font-mono">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>{currentI18n.inhalePill}</span>
        <span class="text-neutral-700">|</span>
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>{currentI18n.holdPill}</span>
        <span class="text-neutral-700">|</span>
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span>{currentI18n.exhalePill}</span>
        <span class="text-neutral-700">|</span>
        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
        <span>{currentI18n.holdEmptyPill}</span>
      </div>
    </div>

    <div class="relative z-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4 mt-8 pt-6 border-t border-neutral-800/60">
      <button
        id="box-btn-main-action"
        type="button"
        class="focus-ring flex items-center justify-center gap-2 px-6 sm:px-8 py-3 sm:py-3.5 rounded-full bg-amber-400/90 text-neutral-950 font-semibold text-xs sm:text-sm hover:bg-amber-300 transition-all transform active:scale-95 shadow-xl shadow-amber-500/15 cursor-pointer max-w-full"
      >
        <svg id="box-icon-play" class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="box-icon-pause" class="w-4 h-4 hidden shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <span id="box-label-main-action" class="break-words text-center">{currentI18n.btnStart}</span>
      </button>

      <button
        id="box-btn-skip-phase"
        type="button"
        class="focus-ring hidden flex items-center justify-center gap-2 px-4 sm:px-6 py-3 sm:py-3.5 rounded-full bg-neutral-900 border border-neutral-750 text-neutral-200 hover:text-white hover:bg-neutral-800 text-xs font-mono font-medium transition-all cursor-pointer max-w-full text-center"
      >
        <span id="box-label-skip-phase" class="break-words">{currentI18n.btnSkipPhase}</span>
        <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
        </svg>
      </button>

      <button
        id="box-btn-restart"
        type="button"
        class="focus-ring flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all cursor-pointer"
        title="Restart Session"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>{currentI18n.btnReset}</span>
      </button>

      <button
        id="box-btn-music"
        type="button"
        class="focus-ring flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all cursor-pointer"
        title="Change Background Music"
      >
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span>{currentI18n.btnMusic}</span>
      </button>

      <button
        id="box-btn-quit-music"
        type="button"
        class="focus-ring flex items-center gap-2 px-4 sm:px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-rose-400 hover:border-rose-500/30 hover:bg-neutral-800 text-xs font-mono transition-all cursor-pointer group"
        title={currentI18n.btnQuitMusic}
      >
        <svg class="w-4 h-4 text-rose-400/80 group-hover:text-rose-400 shrink-0 transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <rect x="6" y="6" width="12" height="12" rx="2"/>
        </svg>
        <span id="box-label-quit-music">{currentI18n.btnQuitMusic}</span>
      </button>
    </div>
  </div>
</section>

<BoxCustomSettingsModal lang={lang} />
<BoxMusicSelectionModal lang={lang} />

<script>
  import { audioPlayer } from '../utils/audioPlayer';
  import { musicTracks } from '../config/audioConfig';
  import { saveExerciseStats } from '../utils/stats';

  // Hydrate client translations
  const i18nScriptEl = document.getElementById('hb-box-timer-i18n');
  const t = i18nScriptEl ? JSON.parse(i18nScriptEl.textContent || '{}') : {};

  const BOX_MUSIC_KEY = 'hb_box_music_selection';
  const allTracks = [
    ...musicTracks.guidedBreathing,
    ...musicTracks.breathOutHold,
    ...musicTracks.recoveryHold,
  ];

  let phaseDuration = 4;
  let totalCycles = 20;
  let currentCycle = 1;

  let currentPreset = 'standard-4s';

  const PHASES = ['INHALE', 'HOLD_FULL', 'EXHALE', 'HOLD_EMPTY'] as const;
  let currentPhaseIndex = 0;
  let phaseElapsed = 0;

  let phase = 'IDLE';
  let isPaused = false;

  let phaseTimer: number | null = null;
  let tickTimer: number | null = null;

  const progressCircle = document.getElementById('box-progress-circle') as SVGCircleElement | null;
  const breathHalo = document.getElementById('box-breath-halo');
  const phaseGlow = document.getElementById('box-phase-glow');
  const phaseLabel = document.getElementById('box-phase-label');
  const breathActionText = document.getElementById('box-breath-action-text');
  const primaryCounter = document.getElementById('box-primary-counter');
  const secondaryCounter = document.getElementById('box-secondary-counter');
  const presetBadge = document.getElementById('box-preset-badge');
  const currentCycleText = document.getElementById('box-current-cycle-text');
  const totalCyclesText = document.getElementById('box-total-cycles-text');

  const btnMainAction = document.getElementById('box-btn-main-action');
  const boxCircleAction = document.getElementById('box-circle-action');
  const iconPlay = document.getElementById('box-icon-play');
  const iconPause = document.getElementById('box-icon-pause');
  const labelMainAction = document.getElementById('box-label-main-action');
  const btnSkipPhase = document.getElementById('box-btn-skip-phase');
  const labelSkipPhase = document.getElementById('box-label-skip-phase');
  const btnRestart = document.getElementById('box-btn-restart');

  const customModal = document.getElementById('box-custom-modal');
  const customSettingsBtn = document.getElementById('box-custom-settings-btn');
  const closeCustomModal = document.getElementById('close-box-custom-modal');
  const applyCustom = document.getElementById('apply-box-custom');
  const customDurationInput = document.getElementById('box-custom-duration-input') as HTMLInputElement | null;
  const customDurationVal = document.getElementById('box-custom-duration-val');
  const customCyclesInput = document.getElementById('box-custom-cycles-input') as HTMLInputElement | null;
  const customCyclesVal = document.getElementById('box-custom-cycles-val');

  const btnMusic = document.getElementById('box-btn-music');
  const btnQuitMusic = document.getElementById('box-btn-quit-music');
  const labelQuitMusic = document.getElementById('box-label-quit-music');
  let isMusicStopped = false;

  const phaseConfig = t.phases || {
    INHALE: { label: 'Phase 1: Inhale', action: 'Breathe In Slowly', glow: 'from-amber-500/20', labelClass: 'text-amber-400', haloScale: '1.25' },
    HOLD_FULL: { label: 'Phase 2: Hold (Full)', action: 'Hold Gently', glow: 'from-cyan-500/20', labelClass: 'text-cyan-400', haloScale: '1.25' },
    EXHALE: { label: 'Phase 3: Exhale', action: 'Breathe Out Slowly', glow: 'from-blue-500/20', labelClass: 'text-blue-400', haloScale: '0.95' },
    HOLD_EMPTY: { label: 'Phase 4: Hold (Empty)', action: 'Stay Relaxed', glow: 'from-purple-500/20', labelClass: 'text-purple-400', haloScale: '0.95' },
  };

  function formatTime(sec: number): string {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  }

  function updateProgressRing(percent: number) {
    if (!progressCircle) return;
    const circumference = 2 * Math.PI * 44;
    const offset = circumference - (percent / 100) * circumference;
    progressCircle.style.strokeDashoffset = `${offset}`;
  }

  function getSelectedMusicFilePath(): string | null {
    try {
      const trackId = localStorage.getItem(BOX_MUSIC_KEY);
      if (!trackId) return null;
      const track = allTracks.find(item => item.id === trackId);
      return track?.filePath || null;
    } catch {
      return null;
    }
  }

  document.querySelectorAll('.box-preset-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      currentPreset = target.dataset.boxPreset || 'standard-4s';
      phaseDuration = parseFloat(target.dataset.duration || '4');
      totalCycles = parseInt(target.dataset.cycles || '20', 10);

      document.querySelectorAll('.box-preset-btn').forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      target.classList.add('is-active');
      target.setAttribute('aria-pressed', 'true');

      updatePresetUI();
      resetSession();
    });
  });

  function updatePresetUI() {
    if (presetBadge) {
      let badgeText = currentPreset === 'standard-4s'
        ? `${t.presetStandard || 'Standard 4s'} (${phaseDuration}s)`
        : `${t.presetCustom || 'Custom'} (${phaseDuration}s)`;
      presetBadge.textContent = badgeText;
    }
    if (totalCyclesText) totalCyclesText.textContent = String(totalCycles);
    if (currentCycleText) currentCycleText.textContent = String(currentCycle);
    if (secondaryCounter) secondaryCounter.textContent = `${phaseDuration}${t.perPhase || 's per phase'}`;
  }

  customSettingsBtn?.addEventListener('click', () => customModal?.classList.remove('hidden'));
  closeCustomModal?.addEventListener('click', () => customModal?.classList.add('hidden'));

  customDurationInput?.addEventListener('input', () => {
    if (customDurationVal && customDurationInput) customDurationVal.textContent = `${customDurationInput.value}s`;
  });
  customCyclesInput?.addEventListener('input', () => {
    if (customCyclesVal && customCyclesInput) {
      const suffix = customCyclesVal.getAttribute('data-suffix') || 'Cycles';
      customCyclesVal.textContent = `${customCyclesInput.value} ${suffix}`;
    }
  });

  applyCustom?.addEventListener('click', () => {
    if (customDurationInput && customCyclesInput) {
      currentPreset = 'custom';
      phaseDuration = parseFloat(customDurationInput.value);
      totalCycles = parseInt(customCyclesInput.value, 10);

      document.querySelectorAll('.box-preset-btn').forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      const customBtn = document.querySelector('.box-preset-btn[data-box-preset="custom"]');
      customBtn?.classList.add('is-active');
      customBtn?.setAttribute('aria-pressed', 'true');

      updatePresetUI();
      resetSession();
      customModal?.classList.add('hidden');
    }
  });

  btnMainAction?.addEventListener('click', () => {
    if (phase === 'IDLE' || phase === 'COMPLETE') {
      startSession();
    } else if (isPaused) {
      resumeSession();
    } else {
      pauseSession();
    }
  });

  boxCircleAction?.addEventListener('click', () => {
    btnMainAction?.click();
  });

  boxCircleAction?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      btnMainAction?.click();
    }
  });

  if (boxCircleAction && labelMainAction) {
    const syncCircleAria = () => {
      const txt = labelMainAction.textContent?.trim() || t.btnStart || 'Start Session';
      boxCircleAction.setAttribute('aria-label', txt);
      boxCircleAction.setAttribute('title', txt);
    };
    const observer = new MutationObserver(syncCircleAria);
    observer.observe(labelMainAction, { childList: true, characterData: true, subtree: true });
    syncCircleAria();
  }

  btnSkipPhase?.addEventListener('click', () => {
    advancePhase();
  });

  btnRestart?.addEventListener('click', () => resetSession());

  btnMusic?.addEventListener('click', () => {
    (window as any).openBoxMusicModal?.();
  });

  btnQuitMusic?.addEventListener('click', () => {
    isMusicStopped = true;
    audioPlayer.stopAll();
    if (labelQuitMusic) {
      const originalText = labelQuitMusic.textContent;
      labelQuitMusic.textContent = t.musicStopped || 'Music Stopped';
      btnQuitMusic.classList.add('text-rose-400', 'border-rose-500/50');
      setTimeout(() => {
        labelQuitMusic.textContent = originalText;
        btnQuitMusic.classList.remove('text-rose-400', 'border-rose-500/50');
      }, 1600);
    }
  });

  window.addEventListener('hb_box_music_updated', () => {
    if (phase === 'IDLE' || phase === 'COMPLETE') return;
    const filePath = getSelectedMusicFilePath();
    if (filePath) {
      audioPlayer.playMusicTrack(filePath, true);
    } else {
      audioPlayer.playPhaseTrack('guidedBreathing', true);
    }
  });

  function startSession() {
    currentCycle = 1;
    currentPhaseIndex = 0;
    phaseElapsed = 0;
    resetTimers();
    playBackgroundMusic();
    startPhase();
  }

  function playBackgroundMusic() {
    if (isMusicStopped) return;
    const filePath = getSelectedMusicFilePath();
    if (filePath) {
      audioPlayer.playMusicTrack(
        filePath,
        audioPlayer.isLoopSong(),
        allTracks,
        BOX_MUSIC_KEY,
        'hb_box_music_updated'
      );
    } else {
      audioPlayer.playPhaseTrack('guidedBreathing', audioPlayer.isLoopSong());
    }
  }

  function pauseSession() {
    isPaused = true;
    audioPlayer.pause();
    if (tickTimer) clearTimeout(tickTimer);
    if (phaseTimer) clearInterval(phaseTimer);
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      labelMainAction.textContent = t.btnResume || 'Resume';
    }
  }

  let lastTick = Date.now();

  function resumeSession() {
    isPaused = false;
    lastTick = Date.now();
    if (!isMusicStopped) {
      audioPlayer.resume();
    }
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      labelMainAction.textContent = t.btnPause || 'Pause';
    }
    runPhaseTimer();
  }

  function startPhase() {
    phase = 'ACTIVE';
    isPaused = false;
    phaseElapsed = 0;
    lastTick = Date.now();

    const currentKey = PHASES[currentPhaseIndex];
    const cfg = phaseConfig[currentKey] || phaseConfig.INHALE;
    const phaseTotal = PHASES.length;

    if (phaseLabel) {
      phaseLabel.textContent = cfg.label;
      phaseLabel.className = `uppercase tracking-wider font-semibold ${cfg.labelClass}`;
    }
    if (breathActionText) breathActionText.textContent = cfg.action;
    if (phaseGlow) {
      phaseGlow.className = `absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b ${cfg.glow} via-transparent to-transparent`;
    }
    if (breathHalo) {
      breathHalo.style.transitionDuration = `${phaseDuration * 1000}ms`;
      breathHalo.style.transform = `scale(${cfg.haloScale})`;
    }
    if (currentCycleText) currentCycleText.textContent = String(currentCycle);
    if (secondaryCounter) secondaryCounter.textContent = `${cfg.label} — ${phaseDuration}s`;

    if (btnSkipPhase && labelSkipPhase) {
      btnSkipPhase.classList.remove('hidden');
      const nextPhaseIdx = (currentPhaseIndex + 1) % phaseTotal;
      const nextKey = PHASES[nextPhaseIdx];
      const nextCfg = phaseConfig[nextKey] || phaseConfig.INHALE;
      labelSkipPhase.textContent = nextPhaseIdx === 0 ? (t.nextCycle || 'Next Cycle') : nextCfg.label;
    }

    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      labelMainAction.textContent = t.btnPause || 'Pause';
    }

    updateCounter();
    runPhaseTimer();
  }

  function runPhaseTimer() {
    if (tickTimer) clearTimeout(tickTimer);
    if (phaseTimer) clearInterval(phaseTimer);
    lastTick = Date.now();

    phaseTimer = window.setInterval(() => {
      if (isPaused) return;

      const now = Date.now();
      const deltaSec = (now - lastTick) / 1000;
      lastTick = now;

      phaseElapsed += deltaSec;
      updateCounter();

      if (phaseElapsed >= phaseDuration) {
        if (phaseTimer) clearInterval(phaseTimer);
        audioPlayer.playChime();
        advancePhase();
      }
    }, 250);
  }

  function updateCounter() {
    const remaining = Math.max(0, Math.ceil(phaseDuration - phaseElapsed));
    if (primaryCounter) primaryCounter.textContent = formatTime(remaining);
    const pct = Math.min(100, (phaseElapsed / phaseDuration) * 100);
    updateProgressRing(pct);
  }

  function advancePhase() {
    if (tickTimer) clearTimeout(tickTimer);
    if (phaseTimer) clearInterval(phaseTimer);

    currentPhaseIndex++;

    if (currentPhaseIndex >= PHASES.length) {
      currentPhaseIndex = 0;
      currentCycle++;

      if (currentCycle > totalCycles) {
        completeSession();
        return;
      }
    }

    startPhase();
  }

  function completeSession() {
    phase = 'COMPLETE';
    resetTimers();
    audioPlayer.stop();

    if (phaseLabel) {
      phaseLabel.textContent = t.complete || 'Session Complete 🎉';
      phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400';
    }
    if (breathActionText) breathActionText.textContent = t.completedDirective || 'Great Job! Practice Logged.';
    if (primaryCounter) primaryCounter.textContent = 'DONE';
    if (secondaryCounter) {
      secondaryCounter.textContent = (t.completedCyclesTemplate || 'Completed {n} Cycles')
        .replace('{n}', String(totalCycles));
    }
    if (breathHalo) breathHalo.style.transform = 'scale(1.0)';
    if (btnSkipPhase) btnSkipPhase.classList.add('hidden');
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      labelMainAction.textContent = t.btnStartNew || 'Start New Session';
    }
    updateProgressRing(100);
    saveSessionStats();
  }

  function resetTimers() {
    if (phaseTimer) clearInterval(phaseTimer);
    if (tickTimer) clearTimeout(tickTimer);
    audioPlayer.stop();
  }

  function resetSession() {
    resetTimers();
    isMusicStopped = false;
    phase = 'IDLE';
    isPaused = false;
    currentPhaseIndex = 0;
    phaseElapsed = 0;

    if (phaseLabel) {
      phaseLabel.textContent = t.ready || 'Ready';
      phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400';
    }
    if (breathActionText) breathActionText.textContent = t.pressStart || 'Press Start';
    if (primaryCounter) primaryCounter.textContent = '00:00';
    if (secondaryCounter) secondaryCounter.textContent = `${phaseDuration}${t.perPhase || 's per phase'}`;
    if (breathHalo) breathHalo.style.transform = 'scale(1.0)';
    if (btnSkipPhase) btnSkipPhase.classList.add('hidden');
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      labelMainAction.textContent = t.btnStart || 'Start Session';
    }
    updateProgressRing(0);
    updatePresetUI();
  }

  function saveSessionStats() {
    try {
      saveExerciseStats('box-breathing', {
        totalRounds: totalCycles,
      });
    } catch {
      // Ignore localStorage errors
    }
  }

  resetSession();

  const activePresetBtn = document.querySelector(`.box-preset-btn[data-box-preset="${currentPreset}"]`);
  activePresetBtn?.classList.add('is-active');
  activePresetBtn?.setAttribute('aria-pressed', 'true');

  window.addEventListener('hb_music_quit', () => {
    isMusicStopped = true;
  });

  // Clean up timers and audio when navigating away via back button, links, or changing page
  function cleanupSession() {
    resetSession();
    audioPlayer.stopAll();
  }

  (window as any).hbStopSession = cleanupSession;

  window.addEventListener('pagehide', cleanupSession);
  window.addEventListener('popstate', cleanupSession);
  window.addEventListener('beforeunload', cleanupSession);
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      resetSession();
    }
  });

  // Stop session immediately when user clicks internal navigation links (home, technique pages, language switch)
  document.addEventListener('click', (e) => {
    const anchor = (e.target as HTMLElement)?.closest('a');
    if (anchor && anchor.href) {
      try {
        const url = new URL(anchor.href, window.location.origin);
        if (url.origin === window.location.origin && url.pathname !== window.location.pathname) {
          cleanupSession();
        }
      } catch {}
    }
  });
</script>
