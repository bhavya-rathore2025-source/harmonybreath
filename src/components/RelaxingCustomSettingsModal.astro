---
---

<div id="relax-custom-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden p-4">
  <div class="w-full max-w-md bg-neutral-950 border border-neutral-800 rounded-2xl p-6 shadow-2xl space-y-6">
    <div class="flex items-center justify-between border-b border-neutral-800 pb-4">
      <h3 class="text-base font-bold text-white flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Custom 4-7-8 Breath Settings
      </h3>
      <button id="close-relax-custom-modal" class="text-neutral-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="text-xs text-neutral-500 font-mono leading-relaxed -mt-2">
      Customize the timing of each phase or total cycles for your relaxing breath session.
    </div>

    <!-- Inhale Duration -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Inhale Duration (Nose)</span>
        <span id="relax-custom-inhale-val" class="text-amber-400 font-bold">4s</span>
      </div>
      <input
        type="range"
        id="relax-custom-inhale-input"
        min="2"
        max="8"
        step="1"
        value="4"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-amber-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>2s</span>
        <span>8s</span>
      </div>
    </div>

    <!-- Hold Duration -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Hold Duration</span>
        <span id="relax-custom-hold-val" class="text-cyan-400 font-bold">7s</span>
      </div>
      <input
        type="range"
        id="relax-custom-hold-input"
        min="3"
        max="14"
        step="1"
        value="7"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>3s</span>
        <span>14s</span>
      </div>
    </div>

    <!-- Exhale Duration -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Exhale Duration (Mouth)</span>
        <span id="relax-custom-exhale-val" class="text-blue-400 font-bold">8s</span>
      </div>
      <input
        type="range"
        id="relax-custom-exhale-input"
        min="4"
        max="16"
        step="1"
        value="8"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-blue-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>4s</span>
        <span>16s</span>
      </div>
    </div>

    <!-- Total Cycles -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Total Cycles</span>
        <span id="relax-custom-cycles-val" class="text-indigo-400 font-bold">4 Cycles</span>
      </div>
      <input
        type="range"
        id="relax-custom-cycles-input"
        min="1"
        max="30"
        step="1"
        value="4"
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-indigo-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>1 Cycle</span>
        <span>30 Cycles</span>
      </div>
    </div>

    <div class="pt-4 flex gap-3">
      <button
        id="apply-relax-custom"
        type="button"
        class="flex-1 py-2.5 rounded-xl bg-blue-500 hover:bg-blue-400 text-white font-semibold text-xs transition-colors shadow-lg shadow-blue-500/10"
      >
        Apply Custom Session
      </button>
    </div>
  </div>
</div>
