---
---

<div id="custom-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden p-4">
  <div class="w-full max-w-md bg-neutral-950 border border-neutral-800 rounded-2xl p-6 shadow-2xl space-y-6">
    <div class="flex items-center justify-between border-b border-neutral-800 pb-4">
      <h3 class="text-base font-bold text-white flex items-center gap-2">
        <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Custom Session Settings
      </h3>
      <button id="close-custom-modal" class="text-neutral-400 hover:text-white transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Breath Count Slider -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Guided Breaths</span>
        <span id="custom-breaths-val" class="text-cyan-400 font-bold">30 Breaths</span>
      </div>
      <input 
        type="range" 
        id="custom-breaths-input" 
        min="15" 
        max="60" 
        step="5" 
        value="30" 
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>15</span>
        <span>30 (Default)</span>
        <span>60</span>
      </div>
    </div>

    <!-- Breath-out Hold Slider -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Breath-Out Hold Target</span>
        <span id="custom-hold-val" class="text-blue-400 font-bold">90 Seconds</span>
      </div>
      <input 
        type="range" 
        id="custom-hold-input" 
        min="30" 
        max="300" 
        step="15" 
        value="90" 
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-blue-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>30s</span>
        <span>90s</span>
        <span>300s (5m)</span>
      </div>
    </div>

    <!-- Number of Rounds Slider -->
    <div class="space-y-2">
      <div class="flex justify-between text-xs font-mono text-neutral-300">
        <span>Total Rounds</span>
        <span id="custom-rounds-val" class="text-purple-400 font-bold">3 Rounds</span>
      </div>
      <input 
        type="range" 
        id="custom-rounds-input" 
        min="1" 
        max="10" 
        step="1" 
        value="3" 
        class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-purple-400"
      />
      <div class="flex justify-between text-[10px] text-neutral-500 font-mono">
        <span>1 Round</span>
        <span>3 (Default)</span>
        <span>10 Rounds</span>
      </div>
    </div>

    <div class="pt-4 flex gap-3">
      <button 
        id="apply-custom-settings"
        type="button" 
        class="flex-1 py-2.5 rounded-xl bg-white text-black font-semibold text-xs hover:bg-neutral-200 transition-colors shadow-lg shadow-white/5"
      >
        Apply Custom Session
      </button>
    </div>
  </div>
</div>
