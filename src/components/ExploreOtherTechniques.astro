    techniques: {
      'box-breathing': {
        title: 'ボックス呼吸法タイマー',
        desc: '4秒ずつ吸う・止める・吐く・止めるを繰り返す四角形のリズム。プレッシャー下での冷静さと集中力をもたらします。',
      },
      '4-7-8-breathing': {
        title: '4-7-8 呼吸法タイマー',
        desc: '4秒吸って7秒止め8秒で吐き出す、就寝前の深いリラックスと入眠に適した呼吸法。',
      },
      'physiological-sigh': {
