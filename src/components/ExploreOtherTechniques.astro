const t = translations[lang] || translations.en;

// Techniques with localized page support
const multilingualTechniques = new Set(['box-breathing', 'diaphragmatic-breathing', 'wim-hof', '4-7-8-breathing']);

function getTechniqueUrl(id: string): string {
  if (lang !== 'en' && multilingualTechniques.has(id)) {
    return `/${lang}/${id}/`;
  }
  return `/${id}/`;
}

const allTechniqueIds: Array<'box-breathing' | '4-7-8-breathing' | 'physiological-sigh' | 'diaphragmatic-breathing' | 'nadi-shodhana' | 'wim-hof'> = [
  'box-breathing',
  '4-7-8-breathing',
  'physiological-sigh',
  'diaphragmatic-breathing',
  'nadi-shodhana',
  'wim-hof',
];

const otherTechniques = allTechniqueIds
  .filter(id => id !== current)
  .map(id => ({
    id,
    title: t.techniques[id]?.title || translations.en.techniques[id].title,
    desc: t.techniques[id]?.desc || translations.en.techniques[id].desc,
    url: getTechniqueUrl(id),
  }));

const accentClasses: Record<string, string> = {
  amber: 'text-amber-400 hover:text-amber-300',
  indigo: 'text-indigo-400 hover:text-indigo-300',
  blue: 'text-blue-400 hover:text-blue-300',
  teal: 'text-teal-400 hover:text-teal-300',
  cyan: 'text-cyan-400 hover:text-cyan-300',
  emerald: 'text-emerald-400 hover:text-emerald-300',
};

const linkClass = accentClasses[accent] || accentClasses.amber;
---

<section class="w-full max-w-4xl mx-auto px-4 py-8">
  <div class="p-6 sm:p-8 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md space-y-5">
    <div class="space-y-2">
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        {t.heading}
      </h2>
      <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
        {t.subheading}
      </p>
    </div>

    <ul class="space-y-3 text-xs sm:text-sm text-neutral-300 leading-relaxed font-sans">
      {otherTechniques.map((tech) => (
        <li class="flex items-start gap-2">
          <span class={`font-bold select-none ${linkClass}`}>•</span>
          <span>
            <a
              href={tech.url}
              class={`${linkClass} underline underline-offset-2 font-medium transition-colors`}
            >
              {tech.title}
            </a>
            {' '}— {tech.desc}
          </span>
        </li>
      ))}
    </ul>

    <div class="pt-2 border-t border-neutral-900 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light">
      {t.footerPre}{' '}
      <a
        href="/about/"
        class={`${linkClass} underline underline-offset-2 font-medium transition-colors`}
      >
        {t.footerLink}
      </a>
      {' '}{t.footerPost}
    </div>
  </div>
</section>
