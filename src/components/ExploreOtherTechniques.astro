---
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  current: 'box-breathing' | 'nadi-shodhana' | 'wim-hof' | '4-7-8-breathing' | 'diaphragmatic-breathing' | 'physiological-sigh';
  accent?: 'amber' | 'indigo' | 'blue' | 'teal' | 'cyan' | 'emerald';
  lang?: SupportedLanguage;
}

const { current, accent = 'amber', lang = 'en' } = Astro.props;

const translations: Record<SupportedLanguage, {
