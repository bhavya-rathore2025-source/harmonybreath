---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PhysiologicalSighTimer from '../components/PhysiologicalSighTimer.astro';
import PhysiologicalSessionPresets from '../components/PhysiologicalSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';
import { physiologicalSighI18n } from '../i18n/physiological-sigh';
import { getHreflangLinks } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const content = physiologicalSighI18n[lang] || physiologicalSighI18n.en;

const siteUrl = 'https://harmonybreath.com';
const fullCanonicalUrl = `${siteUrl}${content.canonicalPath}`;
const hreflangLinks = getHreflangLinks('physiological-sigh', siteUrl);

const datePublished = '2026-07-25';
const dateModified = '2026-08-15';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: content.breadcrumbName, url: content.canonicalPath },
];

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": `HarmonyBreath — ${content.heroTitle.replace('\n', ' ')}`,
    "alternateName": "HarmonyBreath Physiological Sigh Guided Breathwork App",
    "description": content.metaDescription,
    "url": fullCanonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
    },
    "featureList": [
      "Guided Physiological Sigh timer with double inhale + extended exhale visual cues",
      "Customizable timing parameters (first inhale, top-up inhale, long exhale, and cycle counts)",
      "Evidence-backed cyclic sighing protocol for rapid stress relief",
      "Ambient soundscape player with real-time phase indicators",
      "Private browser-local session analytics with zero data tracking",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": `HarmonyBreath ${content.breadcrumbName} Timer`,
    "description": content.metaDescription,
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All",
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": content.metaTitle,
    "description": content.metaDescription,
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com",
    },
    "publisher": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com",
    },
    "mainEntityOfPage": fullCanonicalUrl,
    "citation": [
      "https://pubmed.ncbi.nlm.nih.gov/36630953/",
      "https://www.cell.com/cell-reports-medicine/fulltext/S2666-3791(22)00475-8",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer,
      },
    })),
  },
];
---

<Layout
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.keywords}
  canonicalUrl={fullCanonicalUrl}
  image="https://harmonybreath.com/og-image.png"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
  lang={lang}
  hreflangLinks={hreflangLinks}
>
  <Header />

  <main class="flex-1 bg-[#06080d] text-white relative selection:bg-emerald-500/30 selection:text-emerald-200">
    <!-- Fixed Persistent Atmospheric Background Image -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img
        src="/physiological-sigh.png"
        alt="Physiological Sigh cyclic sighing rapid stress relief atmosphere" 
        class="w-full h-full object-cover object-center filter brightness-[0.7] contrast-110 saturate-110 scale-105"
      />
      <!-- Page-wide Gradient & Radial Ambient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/50 to-[#06080d]/95"></div>
      <div class="absolute inset-0 bg-radial from-emerald-500/15 via-transparent to-transparent"></div>
      <div class="absolute inset-0 noise-overlay opacity-15"></div>
    </div>

    <!-- Scrolling Page Content Container -->
    <div class="relative z-10 w-full">
      <!-- Hero Header Section -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col items-center">
        <!-- Floating Glass Nav Pill Bar -->
        <header class="w-full max-w-4xl mx-auto mb-10 sm:mb-14">
          <nav class="flex flex-wrap items-center justify-between gap-3 p-2 sm:px-4 sm:py-2.5 rounded-full border border-white/15 bg-neutral-950/80 backdrop-blur-2xl shadow-2xl shadow-emerald-950/30">
            <!-- Brand Badge -->
            <div class="flex items-center gap-2.5 px-3 py-1">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_12px_#34d399] shrink-0"></span>
              <span class="text-xs sm:text-sm font-bold tracking-wider text-white uppercase font-mono break-words">
                PHYSIOLOGICAL <span class="text-emerald-400">SIGH</span>
              </span>
            </div>

            <!-- Jump Links (Pills) -->
            <div class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-neutral-300">
              <a href="#phys-timer-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.timer}</a>
              <a href="#presets" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.presets}</a>
              <a href="#analytics" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.stats}</a>
              <a href="#about-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.about}</a>
              <a href="#faq-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.faq}</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
              <a
                href="/"
                class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono text-neutral-400 hover:text-white bg-neutral-900/80 border border-white/10 hover:border-white/20 transition-all"
              >
                {content.allTechniquesBtn}
              </a>
              <a
                href="#phys-timer-section"
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-neutral-950 bg-white hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)] shrink-0"
              >
                <span>{content.startPracticeBtn}</span>
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </nav>
        </header>

        <!-- Hero Headline & Subtitle -->
        <div class="text-center space-y-6 max-w-3xl mx-auto px-2">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-white text-xs font-mono tracking-wide max-w-full break-words">
            <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span class="break-words">{content.badge}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12] text-balance drop-shadow-xl break-words">
            {content.heroTitle.split('\n').map((line, idx) => (
              <>
                {idx > 0 && <br />}
                {line}
              </>
            ))}
          </h1>

          <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-300 font-light leading-relaxed text-pretty break-words">
            {content.heroSubtitle}
          </p>

          <!-- Authorship & Quick Metadata -->
          <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-4 text-xs font-mono text-neutral-400 pt-2">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
              <span>{content.metaDetails.freeBadge}</span>
            </span>
            <span class="text-neutral-600 hidden xs:inline">•</span>
            <span>{content.metaDetails.author}</span>
            <span class="text-neutral-600 hidden xs:inline">•</span>
            <span>{content.metaDetails.publishedDate} · {content.metaDetails.updatedDate}</span>
          </div>
        </div>
      </section>

      <!-- PRESETS SELECTOR -->
      <div id="presets" class="scroll-mt-20">
        <PhysiologicalSessionPresets lang={lang} />
      </div>

      <!-- TIMER INTERFACE -->
      <div id="phys-timer-section" class="scroll-mt-20">
        <PhysiologicalSighTimer lang={lang} />
      </div>

      <!-- Analytics Stats Panel -->
      <div id="analytics" class="scroll-mt-20">
        <AnalyticsPanel exerciseId="physiological-sigh" lang={lang} />
      </div>

      <!-- Detailed Science & Technique Guide Section -->
      <section id="about-section" class="w-full max-w-4xl mx-auto px-4 py-8 scroll-mt-20">
        <div class="bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-8 backdrop-blur-xl space-y-8 text-neutral-300 font-sans font-light text-sm sm:text-base leading-relaxed">
          
          <!-- Section Header -->
          <div class="flex items-center gap-3 border-b border-neutral-800 pb-4">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-400 font-bold shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight break-words">{content.guide.sectionTitle}</h2>
              <p class="text-xs font-mono text-neutral-400 break-words">{content.guide.sectionSubtitle}</p>
            </div>
          </div>

          <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/60 text-xs text-neutral-300 font-sans flex items-start gap-3">
            <span class="text-emerald-400 font-bold text-base leading-none shrink-0">🔬</span>
            <div class="break-words">
              <strong class="text-white font-medium">{content.disclosure.title}</strong> {content.disclosure.desc}
            </div>
          </div>

          <!-- 1. What Is the Physiological Sigh? -->
          <div class="space-y-3">
            <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 text-sm font-mono font-bold border border-emerald-500/30 shrink-0">1</span>
              <span class="break-words">{content.guide.whatIsTitle}</span>
            </h2>
            <p class="break-words">{content.guide.whatIsDesc1}</p>
            <p class="break-words">{content.guide.whatIsDesc2}</p>
          </div>

          <!-- 2. Step-by-Step Execution -->
          <div class="space-y-4 pt-4 border-t border-neutral-900">
            <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-teal-500/20 text-teal-400 text-sm font-mono font-bold border border-teal-500/30 shrink-0">2</span>
              <span class="break-words">{content.guide.howToTitle}</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {content.guide.howToSteps.map((stepItem) => (
                <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/40 space-y-2">
                  <div class="text-xs font-mono uppercase text-emerald-400 font-semibold break-words">
                    {stepItem.step}. {stepItem.title}
                  </div>
                  <p class="text-xs text-neutral-300 break-words">{stepItem.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- 3. Why the Double Inhale & Long Exhale? -->
          <div class="space-y-3 pt-4 border-t border-neutral-900">
            <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-emerald-500/20 text-emerald-400 text-sm font-mono font-bold border border-emerald-500/30 shrink-0">3</span>
              <span class="break-words">{content.guide.physiologyTitle}</span>
            </h2>
            <p class="break-words">{content.guide.physiologyDesc1}</p>
            <p class="break-words">{content.guide.physiologyDesc2}</p>
          </div>

          <!-- 4. What Scientific Research Says -->
          <div class="space-y-3 pt-4 border-t border-neutral-900">
            <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
              <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 text-sm font-mono font-bold border border-cyan-500/30 shrink-0">4</span>
              <span class="break-words">{content.guide.researchTitle}</span>
            </h2>
            <p class="break-words">{content.guide.researchDesc1}</p>
            <div class="p-4 rounded-2xl bg-emerald-950/20 border border-emerald-500/20 space-y-2">
              <h3 class="text-sm font-bold text-white break-words">{content.guide.researchHighlightsTitle}</h3>
              <ul class="list-disc list-inside space-y-1.5 text-xs sm:text-sm text-neutral-300 font-sans">
                {content.guide.researchHighlights.map((hl) => (
                  <li class="break-words">{hl}</li>
                ))}
              </ul>
            </div>
          </div>

          <!-- 5. Potential Benefits -->
          <div class="space-y-3 pt-4 border-t border-neutral-900">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
              <span class="break-words">{content.guide.benefitsTitle}</span>
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {content.guide.benefits.map((benefit) => (
                <div class="p-4 rounded-xl border border-neutral-800/80 bg-neutral-900/40 space-y-1.5">
                  <h4 class="text-sm font-bold text-white break-words">{benefit.title}</h4>
                  <p class="text-xs text-neutral-400 break-words">{benefit.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- 6. Safety & Practice Tips -->
          <div class="p-5 rounded-2xl bg-amber-500/10 border border-amber-500/20 space-y-3 text-xs sm:text-sm text-neutral-300">
            <h4 class="text-sm font-bold text-amber-400 flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>{content.guide.safetyTitle}</span>
            </h4>
            <ul class="list-disc list-inside space-y-1 font-sans text-neutral-300">
              {content.guide.safetyTips.map((tip) => (
                <li class="break-words">{tip}</li>
              ))}
            </ul>
          </div>

          <div class="pt-6 border-t border-neutral-800">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono mb-3">{content.guide.referencesTitle}</h3>
            <ol class="space-y-1.5 text-xs text-neutral-500 font-mono list-decimal list-inside">
              <li class="break-words">
                Balban, M. Y., Neri, E., Kaelberer, M. M., et al. (2023). Brief structured respiration practices enhance mood and reduce physiological arousal. <em class="text-neutral-400">Cell Reports Medicine</em>, 4(1), 100895.{' '}
                <a href="https://pubmed.ncbi.nlm.nih.gov/36630953/" target="_blank" rel="noopener" class="text-emerald-400 hover:underline">[PubMed]</a>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Editorial Team Bio -->
      <section class="w-full max-w-4xl mx-auto px-4 py-10">
        <div class="max-w-3xl mx-auto rounded-2xl border border-neutral-800 bg-neutral-950/60 p-6 sm:p-8 font-sans">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-12 h-12 rounded-full border border-emerald-400/30 bg-emerald-400/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h2 class="text-sm sm:text-base font-bold text-white break-words">{content.editorial.title}</h2>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed break-words">
                {content.editorial.desc}
              </p>
              <p class="text-xs font-mono text-neutral-500 break-words">
                {content.editorial.disclaimer}
              </p>
              <a href="/about/" class="inline-flex items-center gap-1.5 text-xs font-mono text-emerald-400 hover:text-emerald-300 transition-colors">
                <span>{content.editorial.learnMore}</span>
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Frequently Asked Questions (FAQ) Section -->
      <section id="faq-section" class="w-full max-w-4xl mx-auto px-4 py-8 scroll-mt-20">
        <div class="bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-8 backdrop-blur-xl space-y-6">
          <div class="flex items-center gap-3 border-b border-neutral-800 pb-4">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-400 font-bold shrink-0">
              ?
            </div>
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight break-words">{content.faqsTitle}</h2>
              <p class="text-xs font-mono text-neutral-400 break-words">{content.faqsSubtitle}</p>
            </div>
          </div>

          <div class="space-y-4">
            {content.faqs.map((faq) => (
              <details class="group rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base">
                  <span class="break-words">{faq.question}</span>
                  <span class="ml-4 shrink-0 transition-transform duration-200 group-open:-rotate-180 text-emerald-400">↓</span>
                </summary>
                <p class="mt-3 text-xs sm:text-sm text-neutral-400 leading-relaxed font-sans font-light break-words">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Explore Other Techniques Component -->
      <ExploreOtherTechniques current="physiological-sigh" accent="emerald" lang={lang} />
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
