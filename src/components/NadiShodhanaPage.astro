---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import NadiShodhanaTimer from '../components/NadiShodhanaTimer.astro';
import NadiSessionPresets from '../components/NadiSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';
import { nadiShodhanaI18n } from '../i18n/nadi-shodhana';
import { getHreflangLinks } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const content = nadiShodhanaI18n[lang] || nadiShodhanaI18n.en;

const siteUrl = 'https://harmonybreath.com';
const fullCanonicalUrl = `${siteUrl}${content.canonicalPath}`;
const hreflangLinks = getHreflangLinks('nadi-shodhana', siteUrl);

const datePublished = '2026-07-25';
const dateModified = '2026-08-15';

const breadcrumb = [
  { name: 'Home', url: lang === 'en' ? '/' : `/${lang}/` },
  { name: content.breadcrumbName, url: content.canonicalPath },
];

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": `HarmonyBreath — ${content.heroTitle.replace('\n', ' ')}`,
    "alternateName": "HarmonyBreath Nadi Shodhana Pranayama App",
    "description": content.metaDescription,
    "url": fullCanonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided alternate nostril breathing timer with active nostril state indicators",
      "Customizable Nadi Shodhana rhythms (Beginner 4–4, Relaxed 5–5, Equal 6–6, Retention 4-4-4)",
      "Vishnu Mudra hand positioning guidance and step-by-step nostril cues",
      "Ambient soundscape player and real-time phase indicators",
      "Private browser-local session analytics with zero data tracking"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": content.metaTitle,
    "description": content.metaDescription,
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "mainEntityOfPage": fullCanonicalUrl,
    "citation": [
      "https://pubmed.ncbi.nlm.nih.gov/24381831/",
      "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3681046/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": `HarmonyBreath ${content.breadcrumbName} Timer`,
    "description": content.metaDescription,
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer,
      }
    }))
  }
];
---

<Layout
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.keywords}
  canonicalUrl={fullCanonicalUrl}
  image="https://harmonybreath.com/og-image.png"
  imageAlt={`HarmonyBreath ${content.breadcrumbName} guided breathing timer`}
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
  lang={lang}
  hreflangLinks={hreflangLinks}
  ogType="website"
>
  <Header />

  <main class="flex-1 bg-[#06080d] text-white relative selection:bg-purple-500/30 selection:text-purple-200">
    <!-- Fixed Persistent Atmospheric Background Image -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img 
        src="/nadi-shoudhana.png" 
        alt="Nadi Shodhana Alternate Nostril Breathing guided meditation atmosphere" 
        class="w-full h-full object-cover object-center filter brightness-[0.7] contrast-110 saturate-110 scale-105"
      />
      <!-- Page-wide Gradient & Radial Ambient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/50 to-[#06080d]/95"></div>
      <div class="absolute inset-0 bg-radial from-purple-500/15 via-transparent to-transparent"></div>
      <div class="absolute inset-0 noise-overlay opacity-15"></div>
    </div>

    <!-- Scrolling Page Content Container -->
    <div class="relative z-10 w-full">
      <!-- Hero Header Section -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col items-center">
        <!-- Floating Glass Nav Pill Bar -->
        <header class="w-full max-w-4xl mx-auto mb-10 sm:mb-14">
          <nav class="flex flex-wrap items-center justify-between gap-3 p-2 sm:px-4 sm:py-2.5 rounded-full border border-white/15 bg-neutral-950/80 backdrop-blur-2xl shadow-2xl shadow-purple-950/30">
            <!-- Brand Badge -->
            <div class="flex items-center gap-2.5 px-3 py-1">
              <span class="w-2.5 h-2.5 rounded-full bg-purple-400 animate-pulse shadow-[0_0_12px_#c084fc]"></span>
              <span class="text-xs sm:text-sm font-bold tracking-wider text-white uppercase font-mono break-words">
                {content.breadcrumbName}
              </span>
            </div>

            <!-- Jump Links (Pills) -->
            <div class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-neutral-300">
              <a href="#nadi-timer-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.timer}</a>
              <a href="#presets" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.presets}</a>
              <a href="#analytics" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.stats}</a>
              <a href="#how-to" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.guide}</a>
              <a href="#about-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.about}</a>
              <a href="#faq-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.faq}</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
              <a 
                href={lang === 'en' ? '/' : `/${lang}/`} 
                class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-mono text-neutral-400 hover:text-white bg-neutral-900/80 border border-white/10 hover:border-white/20 transition-all"
              >
                ← All Techniques
              </a>
              <a 
                href="#nadi-timer-section" 
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-neutral-950 bg-white hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)]"
              >
                <span>{content.startPracticeBtn}</span>
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </nav>
        </header>

        <!-- Hero Headline & Subtitle -->
        <div class="text-center space-y-6 max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-white text-xs font-mono tracking-wide break-words max-w-full">
            <svg class="w-3.5 h-3.5 text-purple-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span class="truncate">{content.badge}</span>
          </div>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] text-balance drop-shadow-xl whitespace-pre-line break-words">
            {content.heroTitle}
          </h1>

          <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-300 font-light leading-relaxed text-pretty break-words">
            {content.heroSubtitle}
          </p>

          <!-- Authorship & Quick Metadata -->
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-neutral-400 pt-2">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              100% Free & Private
            </span>
            <span class="text-neutral-600">•</span>
            <span>By HarmonyBreath Editorial</span>
            <span class="text-neutral-600">•</span>
            <span>Published {datePublished} · Updated {dateModified}</span>
          </div>
        </div>
      </section>

      <!-- PRESETS SELECTOR -->
      <div id="presets" class="scroll-mt-20">
        <NadiSessionPresets lang={lang} />
      </div>

      <!-- TIMER INTERFACE -->
      <div id="nadi-timer-section" class="scroll-mt-20">
        <NadiShodhanaTimer lang={lang} />
      </div>

      <!-- ANALYTICS PANEL -->
      <div id="analytics" class="scroll-mt-20">
        <AnalyticsPanel exerciseId="nadi-shodhana" lang={lang} />
      </div>

      <!-- DETAILED EDUCATIONAL & TECHNIQUE GUIDE -->
      <section id="how-to" class="w-full max-w-4xl mx-auto py-12 px-4 border-t border-neutral-900 space-y-12">
        <!-- 1. Technique Overview -->
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3 break-words">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-indigo-500/20 text-indigo-400 text-sm font-mono font-bold border border-indigo-500/30 shrink-0">
              {content.overview.badge}
            </span>
            <span>{content.overview.title}</span>
          </h2>
          <div class="prose prose-invert max-w-none text-neutral-300 text-sm sm:text-base leading-relaxed space-y-3 break-words">
            <p>{content.overview.desc1}</p>
            <p>{content.overview.desc2}</p>
          </div>
        </div>

        <!-- 2. Step-by-Step Cycle Guide -->
        <div class="space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3 break-words">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-purple-500/20 text-purple-400 text-sm font-mono font-bold border border-purple-500/30 shrink-0">
              {content.mechanics.badge}
            </span>
            <span>{content.mechanics.title}</span>
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
              <div class="text-xs font-mono text-indigo-400 uppercase tracking-wider font-semibold break-words">{content.mechanics.phaseATitle}</div>
              <div class="text-lg font-bold text-white">{content.mechanics.phaseAStep}</div>
              <p class="text-xs text-neutral-400 leading-relaxed break-words">
                {content.mechanics.phaseADesc}
              </p>
            </div>

            <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-950/60 space-y-2">
              <div class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold break-words">{content.mechanics.phaseBTitle}</div>
              <div class="text-lg font-bold text-white">{content.mechanics.phaseBStep}</div>
              <p class="text-xs text-neutral-400 leading-relaxed break-words">
                {content.mechanics.phaseBDesc}
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-neutral-900/60 border border-neutral-800 text-xs font-mono text-neutral-300 flex flex-wrap items-center justify-between gap-2">
            <span>{content.mechanics.patternLabel}</span>
            <span class="text-indigo-400 font-bold break-words">{content.mechanics.patternFlow}</span>
          </div>
        </div>

        <!-- 3. Vishnu Mudra Hand Position -->
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3 break-words">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-pink-500/20 text-pink-400 text-sm font-mono font-bold border border-pink-500/30 shrink-0">
              {content.mudra.badge}
            </span>
            <span>{content.mudra.title}</span>
          </h2>
          <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/80 space-y-3 text-xs sm:text-sm text-neutral-300 leading-relaxed break-words">
            <p>{content.mudra.intro}</p>
            <ul class="list-disc list-inside space-y-2 text-neutral-300 pl-2">
              <li><strong class="text-white">{content.mudra.thumbTitle}</strong> {content.mudra.thumbDesc}</li>
              <li><strong class="text-white">{content.mudra.ringFingerTitle}</strong> {content.mudra.ringFingerDesc}</li>
              <li><strong class="text-white">{content.mudra.otherFingersTitle}</strong> {content.mudra.otherFingersDesc}</li>
            </ul>
          </div>
        </div>

        <!-- 4. Potential Benefits & Science -->
        <div id="about-section" class="space-y-4 scroll-mt-20">
          <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/60 text-xs text-neutral-300 font-sans flex items-start gap-3 break-words">
            <span class="text-indigo-400 font-bold text-base leading-none shrink-0">🔬</span>
            <div class="leading-relaxed">
              {content.science.disclosure}
            </div>
          </div>

          <h2 class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-3 break-words">
            <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 text-sm font-mono font-bold border border-cyan-500/30 shrink-0">
              {content.science.badge}
            </span>
            <span>{content.science.title}</span>
          </h2>
          
          <div class="p-6 rounded-2xl border border-neutral-800 bg-neutral-950/80 space-y-3 text-xs sm:text-sm text-neutral-300 leading-relaxed break-words">
            <p>{content.science.intro}</p>
            <ul class="space-y-3 list-disc list-inside text-neutral-400">
              {content.science.points.map((p) => (
                <li class="leading-relaxed">
                  <strong class="text-white">{p.title}</strong> {p.desc}
                </li>
              ))}
            </ul>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {content.science.benefits.map((b) => (
              <div class="p-5 rounded-2xl border border-neutral-800 bg-neutral-900/40 space-y-2">
                <h3 class="text-sm font-bold text-white flex items-center gap-2 break-words">
                  <span class="w-2 h-2 rounded-full bg-indigo-400 shrink-0"></span>
                  <span>{b.title}</span>
                </h3>
                <p class="text-xs text-neutral-400 leading-relaxed break-words">
                  {b.desc}
                </p>
              </div>
            ))}
          </div>

          <div class="pt-6 border-t border-neutral-800">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono mb-3">{content.science.citationsTitle}</h3>
            <ol class="space-y-2 text-xs text-neutral-400 font-mono list-decimal list-inside">
              {content.science.citations.map((c) => (
                <li class="leading-relaxed">
                  {c.authors} {c.title} <em class="text-neutral-300">{c.journal}</em>{' '}
                  <a href={c.url} target="_blank" rel="noopener" class="text-indigo-400 hover:underline inline-flex items-center gap-0.5">
                    {c.linkText}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- Editorial Team Bio -->
        <div class="rounded-3xl border border-neutral-800 bg-neutral-950/80 p-6 sm:p-8 font-sans backdrop-blur-xl">
          <div class="flex flex-col sm:flex-row items-start gap-4">
            <div class="shrink-0 w-12 h-12 rounded-full border border-indigo-400/30 bg-indigo-400/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h2 class="text-sm sm:text-base font-bold text-white">{content.editorial.title}</h2>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed break-words">
                {content.editorial.desc}
              </p>
              <p class="text-xs font-mono text-neutral-500 break-words">
                {content.editorial.disclaimer}
              </p>
              <a href={lang === 'en' ? '/about/' : `/${lang}/about/`} class="inline-flex items-center gap-1.5 text-xs font-mono text-indigo-400 hover:text-indigo-300 transition-colors">
                <span>{content.editorial.linkText}</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- 5. Safety & Disclaimers -->
        <div class="p-6 rounded-2xl border border-amber-500/30 bg-amber-500/5 space-y-4">
          <h3 class="text-base font-bold text-amber-300 flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>{content.safety.title}</span>
          </h3>
          <ul class="text-xs text-neutral-300 space-y-2 leading-relaxed list-disc list-inside">
            {content.safety.points.map((pt) => (
              <li class="break-words">{pt}</li>
            ))}
          </ul>
        </div>

        <!-- 6. FAQ Accordion Section -->
        <div id="faq-section" class="space-y-6 scroll-mt-20">
          <div class="space-y-2">
            <h2 class="text-2xl sm:text-3xl font-bold text-white break-words">{content.faqsTitle}</h2>
            <p class="text-xs sm:text-sm text-neutral-400 break-words">{content.faqsSubtitle}</p>
          </div>
          <div class="space-y-4">
            {content.faqs.map((faq, idx) => (
              <details class="group rounded-2xl border border-neutral-800 bg-neutral-950/60 p-4 sm:p-5 transition-all open:border-indigo-500/30" open={idx === 0}>
                <summary class="flex cursor-pointer items-center justify-between font-medium text-white text-sm sm:text-base list-none">
                  <span class="break-words pr-4">{faq.question}</span>
                  <span class="transition-transform duration-200 group-open:rotate-180 text-indigo-400 shrink-0">↓</span>
                </summary>
                <p class="mt-3 text-xs sm:text-sm text-neutral-300 leading-relaxed break-words">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Explore Other Techniques -->
      <ExploreOtherTechniques current="nadi-shodhana" accent="indigo" lang={lang} />
    </div>
  </main>

  <Footer lang={lang} />
</Layout>
