---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import DiaphragmaticTimer from '../components/DiaphragmaticTimer.astro';
import DiaphragmaticSessionPresets from '../components/DiaphragmaticSessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';
import { diaphragmaticBreathingI18n } from '../i18n/diaphragmatic-breathing';
import { getHreflangLinks } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const content = diaphragmaticBreathingI18n[lang] || diaphragmaticBreathingI18n.en;

const siteUrl = 'https://harmonybreath.com';
const fullCanonicalUrl = `${siteUrl}${content.canonicalPath}`;
const hreflangLinks = getHreflangLinks('diaphragmatic-breathing', siteUrl);

const datePublished = '2026-07-25';
const dateModified = '2026-09-29';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: content.breadcrumbName, url: content.canonicalPath },
];

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": `HarmonyBreath — ${content.heroTitle.replace('\n', ' ')}`,
    "alternateName": "HarmonyBreath Guided Belly Breathing App",
    "description": content.metaDescription,
    "url": fullCanonicalUrl,
    "image": "https://harmonybreath.com/og-image.png",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All (Web Browser)",
    "browserRequirements": "Requires JavaScript",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided diaphragmatic breathing timer with real-time visual halo cues",
      "Customizable inhale, hold, exhale, and pause durations",
      "Preset session options for daily practice, deep relaxation, and bedtime routine",
      "Ambient soundscape player and audio chime cues",
      "Private browser-local session analytics with zero data tracking"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer,
      }
    }))
  }
];
---

<Layout
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.keywords}
  canonicalUrl={fullCanonicalUrl}
  image="https://harmonybreath.com/og-image.png"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
  lang={lang}
  hreflangLinks={hreflangLinks}
>
  <Header />

  <main class="flex-1 bg-[#06080d] text-white relative selection:bg-cyan-500/30 selection:text-cyan-200">
    <!-- Fixed Persistent Atmospheric Background Image -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img 
        src="/diaphragmatic-breathing.webp" 
        alt="Diaphragmatic belly breathing exercises deep meditation atmosphere" 
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover object-center filter brightness-[0.7] contrast-110 saturate-110 scale-105"
      />
      <!-- Page-wide Gradient & Radial Ambient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/50 to-[#06080d]/95"></div>
      <div class="absolute inset-0 bg-radial from-cyan-500/15 via-transparent to-transparent"></div>
      <div class="absolute inset-0 noise-overlay opacity-15"></div>
    </div>

    <!-- Scrolling Page Content Container -->
    <div class="relative z-10 w-full">
      <!-- Hero Header Section -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col items-center">
        <!-- Floating Glass Nav Pill Bar -->
        <header class="w-full max-w-4xl mx-auto mb-10 sm:mb-14">
          <nav class="flex flex-wrap items-center justify-between gap-3 p-2 sm:px-4 sm:py-2.5 rounded-full border border-white/15 bg-neutral-950/80 backdrop-blur-2xl shadow-2xl shadow-cyan-950/30">
            <!-- Brand Badge -->
            <div class="flex items-center gap-2.5 px-3 py-1">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse shadow-[0_0_12px_#22d3ee]"></span>
              <span class="text-xs sm:text-sm font-bold tracking-wider text-white uppercase font-mono">
                {content.breadcrumbName}
              </span>
            </div>

            <!-- Jump Links (Pills) -->
            <div class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-neutral-300">
              <a href="#diaphragmatic-timer-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.timer}</a>
              <a href="#presets" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.presets}</a>
              <a href="#analytics" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.stats}</a>
              <a href="#diaphragmatic-technique-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.guide}</a>
              <a href="#diaphragmatic-about-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.about}</a>
              <a href="#diaphragmatic-faq-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.faq}</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
              <a 
                href="#diaphragmatic-timer-section" 
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-neutral-950 bg-white hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)]"
              >
                <span>{content.startPracticeBtn}</span>
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </nav>
        </header>

        <!-- Hero Headline & Subtitle -->
        <div class="text-center space-y-6 max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-white text-xs font-mono tracking-wide">
            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>{content.badge}</span>
          </div>

          <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08] text-balance drop-shadow-xl whitespace-pre-line hyphens-none">
            {content.heroTitle}
          </h1>

          <p class="max-w-2xl mx-auto text-base sm:text-lg text-neutral-300 font-light leading-relaxed text-pretty">
            {content.heroSubtitle}
          </p>

          <!-- Authorship & Quick Metadata -->
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-neutral-400 pt-2">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              100% Free & Private
            </span>
            <span class="text-neutral-600">•</span>
            <span>By HarmonyBreath Editorial</span>
            <span class="text-neutral-600">•</span>
            <span>Published {datePublished} · Updated {dateModified}</span>
          </div>
        </div>
      </section>

      <!-- Main Interactive Diaphragmatic Breathing Timer Component -->
      <div id="diaphragmatic-timer-section" class="scroll-mt-20">
        <DiaphragmaticTimer lang={lang} />
      </div>

      <!-- Presets & Analytics -->
      <div id="presets" class="scroll-mt-20">
        <DiaphragmaticSessionPresets />
      </div>
      <div id="analytics" class="scroll-mt-20">
        <AnalyticsPanel exerciseId="diaphragmatic-breathing" />
      </div>

      <!-- Technique Guide -->
      <section id="diaphragmatic-technique-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400">Step-by-Step Guide</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl">
            {content.guide.howToTitle}
          </h3>
          <p class="text-sm text-neutral-400">
            {content.guide.whatIsDesc2}
          </p>
        </div>

        <div class="relative grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 mb-12">
          <div class="hidden md:block absolute inset-x-10 top-1/2 -translate-y-1/2 border-t border-dashed border-cyan-400/15 pointer-events-none"></div>

          {content.guide.howToSteps.map((s, idx) => (
            <div class={`reveal relative p-6 sm:p-7 rounded-3xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md group hover:border-cyan-500/40 hover:bg-neutral-900/40 hover:-translate-y-0.5 transition-all duration-300 ${
              idx === 1 ? 'md:mt-14' : idx === 2 ? 'md:-mt-14' : idx === 3 ? 'md:mt-14' : ''
            }`}>
              <div class="w-11 h-11 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono font-bold flex items-center justify-center mb-4 text-sm">
                0{s.step}
              </div>
              <h4 class="text-lg font-bold text-white mb-2">{s.title}</h4>
              <p class="text-xs text-neutral-400 leading-relaxed mb-4 text-pretty">
                {s.desc}
              </p>
            </div>
          ))}
        </div>

        <div class="reveal relative p-8 rounded-3xl border border-neutral-800 bg-gradient-to-r from-neutral-950 via-neutral-900 to-neutral-950 overflow-hidden">
          <div class="noise-overlay absolute inset-0 opacity-[0.03] pointer-events-none"></div>
          <h4 class="relative text-sm font-mono text-cyan-400 uppercase tracking-widest mb-4">{content.guide.benefitsTitle}</h4>
          <div class="relative grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-medium text-neutral-300">
            {content.guide.benefits.map((b) => (
              <div class="flex flex-col gap-1 p-3.5 rounded-xl bg-neutral-900/50 border border-neutral-800/80">
                <div class="flex items-center gap-2 text-white font-semibold">
                  <span class="w-2 h-2 rounded-full bg-cyan-400 shrink-0"></span>
                  {b.title}
                </div>
                <p class="text-neutral-400 text-xs pl-4 font-normal">{b.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- About Section: In-Depth SEO Content -->
      <section id="diaphragmatic-about-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400">About {content.breadcrumbName}</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl text-balance">
            {content.guide.whatIsTitle}
          </h3>
          <p class="text-sm text-neutral-400">
            {content.guide.whatIsDesc1}
          </p>
        </div>

        <div class="space-y-8 text-sm text-neutral-300 leading-relaxed text-pretty">
          <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
            <h4 class="text-lg font-bold text-white mb-3">{content.guide.scienceTitle}</h4>
            <p class="mb-4">
              {content.guide.scienceDesc1}
            </p>
            <p>
              {content.guide.scienceDesc2}
            </p>
          </div>

          <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
            <h4 class="text-lg font-bold text-white mb-3">{content.guide.whoUsesTitle}</h4>
            <p>
              {content.guide.whoUsesDesc}
            </p>
          </div>
        </div>
      </section>

      <!-- Explore Other Techniques -->
      <ExploreOtherTechniques current="diaphragmatic-breathing" accent="cyan" lang={lang} />

      <!-- FAQ Section -->
      <section id="diaphragmatic-faq-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400">FAQ</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl text-balance">
            Frequently Asked Questions
          </h3>
        </div>

        <div class="reveal space-y-4">
          {content.faqs.map((faq, idx) => (
            <details class="group p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md open:border-cyan-500/30 hover:border-neutral-700 transition-all duration-300" open={idx === 0}>
              <summary class="flex items-center justify-between cursor-pointer list-none text-white font-bold text-base">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="mt-4 text-sm text-neutral-300 leading-relaxed">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('reveal-visible'));
    }
  }
</script>
