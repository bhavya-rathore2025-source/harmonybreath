---
import CustomSettingsModal from './CustomSettingsModal.astro';
import MusicSelectionModal from './MusicSelectionModal.astro';
---

<section id="timer-section" class="w-full max-w-4xl mx-auto py-8 px-4">
  <!-- Main Timer Control Box -->
  <div class="relative w-full bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-xl overflow-hidden">
    <!-- Background Ambient Glow -->
    <div id="phase-glow" class="absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-cyan-500/20 via-transparent to-transparent"></div>

    <!-- Top Status Bar: Round & Mode -->
    <div class="relative z-10 flex items-center justify-between border-b border-neutral-800/60 pb-6 mb-8">
      <div class="flex items-center gap-3">
        <span id="preset-badge" class="px-3 py-1 rounded-full text-xs font-mono font-medium border border-amber-400/30 bg-amber-400/10 text-amber-400">
          Beginner Preset
        </span>
        <span id="round-badge" class="text-xs font-mono text-neutral-400">
          Round <span id="current-round-text" class="text-white font-bold">1</span> of <span id="total-rounds-text" class="text-white font-bold">3</span>
        </span>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="phase-label" class="uppercase tracking-wider font-semibold text-emerald-400">Ready</span>
      </div>
    </div>

    <!-- Central Interactive Visual Breath Circle -->
    <div class="relative z-10 flex flex-col items-center justify-center my-6">
      <div class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center">
        <!-- SVG Radial Progress Ring -->
        <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 100 100">
          <!-- Background Track Circle -->
          <circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="3" class="text-neutral-900" fill="none" />
          <!-- Animated Progress Stroke -->
          <circle
            id="progress-circle"
            cx="50"
            cy="50"
            r="44"
            stroke="url(#gradient-accent)"
            stroke-width="3.5"
            stroke-dasharray="276.46"
            stroke-dashoffset="0"
            stroke-linecap="round"
            class="transition-all duration-300"
            fill="none"
          />
          <defs>
            <linearGradient id="gradient-accent" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#d4a574" />
              <stop offset="50%" stop-color="#50e3c2" />
              <stop offset="100%" stop-color="#7cba9a" />
            </linearGradient>
          </defs>
        </svg>

        <!-- Expanding Breath Halo -->
        <div id="breath-halo" class="absolute w-44 h-44 rounded-full bg-gradient-to-tr from-amber-500/15 via-cyan-500/15 to-emerald-500/15 transition-transform duration-[2500ms] ease-in-out scale-100 flex items-center justify-center border border-white/5"></div>

        <!-- Center Counter Content -->
        <div class="relative z-20 flex flex-col items-center text-center">
          <!-- Breath In / Out Directive Text -->
          <div id="breath-action-text" class="text-xs font-mono uppercase tracking-widest text-amber-400 mb-1">
            Press Start
          </div>

          <!-- Primary Counter -->
          <div id="primary-counter" class="text-5xl sm:text-6xl font-bold tracking-normal font-mono-numbers text-white">
            00:00
          </div>

          <!-- Secondary Sub-label (Breath count or status) -->
          <div id="secondary-counter" class="text-xs font-mono text-neutral-400 mt-2">
            30 Breaths Total
          </div>
        </div>
      </div>

      <!-- Breathing Style Visual Tip -->
      <div id="technique-tip" class="mt-6 text-xs text-neutral-400 bg-neutral-900/40 border border-neutral-800/60 px-4 py-2 rounded-full font-mono text-center max-w-sm">
        <span id="tip-text">Inhale deep & relaxed. Relax the exhale.</span>
      </div>
    </div>

    <!-- Timer Controls -->
    <div class="relative z-10 flex flex-wrap items-center justify-center gap-4 mt-8 pt-6 border-t border-neutral-800/60">
      <!-- Primary Play / Pause / Start Button -->
      <button
        id="btn-main-action"
        type="button"
        class="flex items-center gap-2 px-8 py-3.5 rounded-full bg-amber-400/90 text-neutral-950 font-semibold text-sm hover:bg-amber-300 transition-all transform active:scale-95 shadow-xl shadow-amber-500/15"
      >
        <svg id="icon-play" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="icon-pause" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <span id="label-main-action">Start Session</span>
      </button>

      <!-- Skip / Force Hold Transition Button -->
      <button
        id="btn-skip-phase"
        type="button"
        class="hidden flex items-center gap-2 px-6 py-3.5 rounded-full bg-neutral-900 border border-neutral-750 text-neutral-200 hover:text-white hover:bg-neutral-800 text-xs font-mono font-medium transition-all"
      >
        <span id="label-skip-phase">Finish Breaths & Hold</span>
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Restart Button -->
      <button
        id="btn-restart"
        type="button"
        class="flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all"
        title="Restart Session"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset</span>
      </button>

      <!-- Music Button -->
      <button
        id="btn-music"
        type="button"
        class="flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all"
        title="Change Background Music"
      >
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span>Music</span>
      </button>
    </div>
  </div>
</section>

<!-- Custom Settings Modal Integration -->
<CustomSettingsModal />

<!-- Music Selection Modal Integration -->
<MusicSelectionModal />

<script>
  import { audioPlayer } from '../utils/audioPlayer';
  import { defaultAudioConfig, musicTracks } from '../config/audioConfig';
  import { saveExerciseStats } from '../utils/stats';

  // openMusicModal is defined by MusicSelectionModal.astro's own script
  // which properly calls renderTracks() before showing the modal.

// State Variables
  let currentPreset = 'beginner';
  let targetHoldSeconds = 60;
  let baseHoldSeconds = 60;
  let targetBreaths = 30;
  let totalRounds = 3;
  let currentRound = 1;

  // Breath timing configuration - progressive pace per round
  let customBreathTime = null; // Custom breath cycle time in seconds (from custom settings)
  
  function getBreathTiming(round: number): { inhale: number; exhale: number; total: number } {
    // If custom breath time is set, use it
    if (customBreathTime) {
      const inhale = customBreathTime * 0.6; // 60% inhale, 40% exhale ratio
      const exhale = customBreathTime * 0.4;
      return { inhale, exhale, total: customBreathTime };
    }
    
    // Progressive breathing pace for built-in presets
    if (round === 1) {
      return { inhale: 2.5, exhale: 1.5, total: 4.0 };
    } else if (round === 2) {
      return { inhale: 2.0, exhale: 1.0, total: 3.0 };
    } else {
      return { inhale: 1.5, exhale: 1.0, total: 2.5 };
    }
  }

  const roundTips: Record<number, string> = {
    1: 'Slow, deep, and relaxed breathing.',
    2: 'Increase the pace slightly. Keep each breath deep and controlled.',
    3: 'Fast, deep, and rhythmic breathing. Stay relaxed and never force the exhale.',
  };

  function updateTip(round: number) {
    if (techniqueTip) {
      techniqueTip.textContent = roundTips[round] || roundTips[3] || 'Inhale deep & relaxed. Relax the exhale.';
    }
  }

  // Background Music Storage Key
  const MUSIC_KEY = 'hb_music_selection';

  function getSelectedMusicFilePath(): string {
    const trackId = localStorage.getItem(MUSIC_KEY);
    const allTracks = [
      ...musicTracks.guidedBreathing,
      ...musicTracks.breathOutHold,
      ...musicTracks.recoveryHold,
    ];
    if (trackId) {
      const found = allTracks.find(t => t.id === trackId);
      if (found) return found.filePath;
    }
    return musicTracks.guidedBreathing[0]?.filePath || '/audio/guided-breathing.mp3';
  }

  function playBackgroundMusic() {
    const filePath = getSelectedMusicFilePath();
    if (filePath) {
      audioPlayer.playMusicTrack(filePath, true);
    }
  }

  // Phase enum: 'IDLE' | 'GUIDED' | 'HOLD' | 'RECOVERY' | 'COMPLETE'
  let phase = 'IDLE';
  let isPaused = false;

  // Timer intervals & counters
  let breathCount = 0;
  let elapsedPhaseSeconds = 0;
  let phaseTimer: number | null = null;
  let breathCycleTimer: number | null = null;
  let isInhaling = true;

  // UI Elements
  const progressCircle = document.getElementById('progress-circle') as SVGCircleElement | null;
  const breathHalo = document.getElementById('breath-halo');
  const phaseGlow = document.getElementById('phase-glow');
  const phaseLabel = document.getElementById('phase-label');
  const breathActionText = document.getElementById('breath-action-text');
  const primaryCounter = document.getElementById('primary-counter');
  const secondaryCounter = document.getElementById('secondary-counter');
  const techniqueTip = document.getElementById('tip-text');
  const presetBadge = document.getElementById('preset-badge');
  const currentRoundText = document.getElementById('current-round-text');
  const totalRoundsText = document.getElementById('total-rounds-text');

  const btnMainAction = document.getElementById('btn-main-action');
  const iconPlay = document.getElementById('icon-play');
  const iconPause = document.getElementById('icon-pause');
  const labelMainAction = document.getElementById('label-main-action');
  const btnSkipPhase = document.getElementById('btn-skip-phase');
  const labelSkipPhase = document.getElementById('label-skip-phase');
  const btnRestart = document.getElementById('btn-restart');
  const btnMusic = document.getElementById('btn-music');

  const customModal = document.getElementById('custom-modal');
  const customSettingsBtn = document.getElementById('custom-settings-btn');
  const closeCustomModal = document.getElementById('close-custom-modal');
  const applyCustomSettings = document.getElementById('apply-custom-settings');

  const customBreathsInput = document.getElementById('custom-breaths-input') as HTMLInputElement | null;
  const customHoldInput = document.getElementById('custom-hold-input') as HTMLInputElement | null;
  const customRoundsInput = document.getElementById('custom-rounds-input') as HTMLInputElement | null;
  const customBreathTimeInput = document.getElementById('custom-breath-time-input') as HTMLInputElement | null;

  const customBreathsVal = document.getElementById('custom-breaths-val');
  const customHoldVal = document.getElementById('custom-hold-val');
  const customRoundsVal = document.getElementById('custom-rounds-val');
  const customBreathTimeVal = document.getElementById('custom-breath-time-val');

  // Format seconds into MM:SS
  function formatTime(sec: number): string {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  }

  // Update SVG Circle Progress
  function updateProgressRing(percent: number) {
    if (!progressCircle) return;
    const circumference = 2 * Math.PI * 44; // 276.46
    const offset = circumference - (percent / 100) * circumference;
    progressCircle.style.strokeDashoffset = `${offset}`;
  }

  // Preset Selection Listeners
  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      currentPreset = target.dataset.preset || 'beginner';
      targetHoldSeconds = parseInt(target.dataset.hold || '60', 10);
      baseHoldSeconds = targetHoldSeconds;
      targetBreaths = parseInt(target.dataset.breaths || '30', 10);
      totalRounds = parseInt(target.dataset.rounds || '3', 10);
      customBreathTime = null; // Reset custom breath time for presets

      updatePresetUI();
      resetSession();
    });
  });

  function updatePresetUI() {
    if (presetBadge) {
      let badgeText = `${currentPreset.toUpperCase()} (${baseHoldSeconds}s Hold`;
      if (currentPreset !== 'beginner' && currentPreset !== 'custom') {
        badgeText += ` +10s/round`;
      }
      badgeText += ')';
      presetBadge.textContent = badgeText;
    }
    if (totalRoundsText) totalRoundsText.textContent = String(totalRounds);
    if (currentRoundText) currentRoundText.textContent = String(currentRound);
  }

  // Custom Modal Handlers
  customSettingsBtn?.addEventListener('click', () => customModal?.classList.remove('hidden'));
  closeCustomModal?.addEventListener('click', () => customModal?.classList.add('hidden'));

  customBreathsInput?.addEventListener('input', () => {
    if (customBreathsVal && customBreathsInput) customBreathsVal.textContent = `${customBreathsInput.value} Breaths`;
  });
  customHoldInput?.addEventListener('input', () => {
    if (customHoldVal && customHoldInput) customHoldVal.textContent = `${customHoldInput.value} Seconds`;
  });
  customRoundsInput?.addEventListener('input', () => {
    if (customRoundsVal && customRoundsInput) customRoundsVal.textContent = `${customRoundsInput.value} Rounds`;
  });
  customBreathTimeInput?.addEventListener('input', () => {
    if (customBreathTimeVal && customBreathTimeInput) customBreathTimeVal.textContent = `${customBreathTimeInput.value}s`;
  });

  applyCustomSettings?.addEventListener('click', () => {
    if (customBreathsInput && customHoldInput && customRoundsInput && customBreathTimeInput) {
      currentPreset = 'custom';
      targetBreaths = parseInt(customBreathsInput.value, 10);
      targetHoldSeconds = parseInt(customHoldInput.value, 10);
      baseHoldSeconds = targetHoldSeconds;
      totalRounds = parseInt(customRoundsInput.value, 10);
      customBreathTime = parseFloat(customBreathTimeInput.value);

      updatePresetUI();
      resetSession();
      customModal?.classList.add('hidden');
    }
  });

  // Main Action Toggle (Start / Pause / Resume)
  btnMainAction?.addEventListener('click', () => {
    if (phase === 'IDLE' || phase === 'COMPLETE') {
      startSession();
    } else if (isPaused) {
      resumeSession();
    } else {
      pauseSession();
    }
  });

  btnSkipPhase?.addEventListener('click', () => {
    if (phase === 'GUIDED') {
      startPhaseHold();
    } else if (phase === 'HOLD') {
      startPhaseRecovery();
    } else if (phase === 'RECOVERY') {
      advanceRound();
    }
  });

  btnRestart?.addEventListener('click', () => resetSession());
  btnMusic?.addEventListener('click', () => {
    if (typeof (window as any).openMusicModal === 'function') {
      (window as any).openMusicModal();
    }
  });

  function startSession() {
    currentRound = 1;
    targetHoldSeconds = baseHoldSeconds;
    resetTimers();
    playBackgroundMusic();
    startPhaseGuided();
  }

  function pauseSession() {
    isPaused = true;
    audioPlayer.pause();
    if (phaseTimer) clearInterval(phaseTimer);
    if (breathCycleTimer) clearTimeout(breathCycleTimer);
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      labelMainAction.textContent = 'Resume';
    }
  }

  function resumeSession() {
    isPaused = false;
    audioPlayer.resume();
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      labelMainAction.textContent = 'Pause';
    }

    if (phase === 'GUIDED') {
      runGuidedLoop();
    } else if (phase === 'HOLD') {
      runHoldLoop();
    } else if (phase === 'RECOVERY') {
      runRecoveryLoop();
    }
  }

  // Phase 1: Guided Breathing
  function startPhaseGuided() {
    phase = 'GUIDED';
    isPaused = false;
    breathCount = 0;
    elapsedPhaseSeconds = 0;
    updateTip(currentRound);

    if (phaseLabel) {
      phaseLabel.textContent = 'Phase 1: Guided Breathing';
      phaseLabel.className = 'uppercase tracking-wider font-semibold text-cyan-400';
    }
    if (phaseGlow) {
      phaseGlow.className = 'absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-cyan-500/20 via-transparent to-transparent';
    }
    if (currentRoundText) currentRoundText.textContent = String(currentRound);
    if (btnSkipPhase && labelSkipPhase) {
      btnSkipPhase.classList.remove('hidden');
      labelSkipPhase.textContent = 'Finish Breaths & Hold';
    }
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      labelMainAction.textContent = 'Pause';
    }

    runGuidedLoop();
  }

  function runGuidedLoop() {
    if (phaseTimer) clearInterval(phaseTimer);
    if (breathCycleTimer) clearTimeout(breathCycleTimer);

    const timing = getBreathTiming(currentRound);
    isInhaling = true;

    function tick() {
      if (isPaused) return;

      const delay = (isInhaling ? timing.inhale : timing.exhale) * 1000;

      if (isInhaling) {
        isInhaling = false;
        breathCount++;
        if (breathActionText) breathActionText.textContent = 'Inhale Deep';
        if (breathHalo) breathHalo.style.transform = 'scale(1.25)';
        if (secondaryCounter) secondaryCounter.textContent = `Breath ${breathCount} of ${targetBreaths}`;
        if (primaryCounter) primaryCounter.textContent = `${breathCount} / ${targetBreaths}`;

        updateProgressRing((breathCount / targetBreaths) * 100);

        audioPlayer.playBreathSound(true);
      } else {
        isInhaling = true;
        if (breathActionText) breathActionText.textContent = 'Relax Exhale';
        if (breathHalo) breathHalo.style.transform = 'scale(0.95)';

        audioPlayer.playBreathSound(false);

        if (breathCount >= targetBreaths) {
          clearTimeout(breathCycleTimer!);
          audioPlayer.playChime();
          startPhaseHold();
          return;
        }
      }

      breathCycleTimer = window.setTimeout(tick, delay);
    }

    tick();
  }

  // Phase 2: Breath-Out Hold
  function startPhaseHold() {
    phase = 'HOLD';
    isPaused = false;
    elapsedPhaseSeconds = 0;

    if (breathCycleTimer) clearTimeout(breathCycleTimer);
    if (phaseTimer) clearInterval(phaseTimer);

    if (phaseLabel) {
      phaseLabel.textContent = 'Phase 2: Breath-Out Hold';
      phaseLabel.className = 'uppercase tracking-wider font-semibold text-blue-400';
    }
    if (breathActionText) breathActionText.textContent = 'Gently Exhale & Retention Hold';
    if (breathHalo) breathHalo.style.transform = 'scale(1.0)';
    if (phaseGlow) {
      phaseGlow.className = 'absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-amber-500/20 via-transparent to-transparent';
    }
    if (btnSkipPhase && labelSkipPhase) {
      btnSkipPhase.classList.remove('hidden');
      labelSkipPhase.textContent = 'Inhale Recovery';
    }
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      labelMainAction.textContent = 'Pause';
    }

    runHoldLoop();
  }

  function runHoldLoop() {
    if (phaseTimer) clearInterval(phaseTimer);

    phaseTimer = window.setInterval(() => {
      if (isPaused) return;

      elapsedPhaseSeconds++;
      if (primaryCounter) primaryCounter.textContent = formatTime(elapsedPhaseSeconds);
      if (secondaryCounter) secondaryCounter.textContent = `Target: ${targetHoldSeconds}s (Hold relaxed)`;

      const progressPct = Math.min(100, (elapsedPhaseSeconds / targetHoldSeconds) * 100);
      updateProgressRing(progressPct);

      if (elapsedPhaseSeconds >= targetHoldSeconds) {
        clearInterval(phaseTimer!);
        audioPlayer.playChime();
        startPhaseRecovery();
      }
    }, 1000);
  }

  // Phase 3: Recovery Breath (15 Seconds)
  function startPhaseRecovery() {
    phase = 'RECOVERY';
    isPaused = false;
    elapsedPhaseSeconds = 15;

    if (phaseTimer) clearInterval(phaseTimer);

    if (phaseLabel) {
      phaseLabel.textContent = 'Phase 3: Recovery Breath';
      phaseLabel.className = 'uppercase tracking-wider font-semibold text-purple-400';
    }
    if (breathActionText) breathActionText.textContent = 'Deep Inhale & Hold 15s';
    if (breathHalo) breathHalo.style.transform = 'scale(1.2)';
    if (phaseGlow) {
      phaseGlow.className = 'absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-emerald-500/20 via-transparent to-transparent';
    }
    if (btnSkipPhase && labelSkipPhase) {
      btnSkipPhase.classList.remove('hidden');
      labelSkipPhase.textContent = 'Next Round';
    }
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      labelMainAction.textContent = 'Pause';
    }

    runRecoveryLoop();
  }

  function runRecoveryLoop() {
    if (phaseTimer) clearInterval(phaseTimer);

    phaseTimer = window.setInterval(() => {
      if (isPaused) return;

      elapsedPhaseSeconds--;
      if (primaryCounter) primaryCounter.textContent = `00:${elapsedPhaseSeconds.toString().padStart(2, '0')}`;
      if (secondaryCounter) secondaryCounter.textContent = 'Hold recovery breath';

      updateProgressRing(((15 - elapsedPhaseSeconds) / 15) * 100);

      if (elapsedPhaseSeconds <= 0) {
        clearInterval(phaseTimer!);
        audioPlayer.playChime();
        advanceRound();
      }
    }, 1000);
  }

  function advanceRound() {
    if (currentRound < totalRounds) {
      currentRound++;
      if (currentPreset !== 'beginner' && currentPreset !== 'custom') {
        targetHoldSeconds = baseHoldSeconds + (currentRound - 1) * 10;
      }
      startPhaseGuided();
    } else {
      completeSession();
    }
  }

  function completeSession() {
    phase = 'COMPLETE';
    resetTimers();
    audioPlayer.stop();

    if (phaseLabel) {
      phaseLabel.textContent = 'Session Complete 🎉';
      phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400';
    }
    if (breathActionText) breathActionText.textContent = 'Great Job! Practice Logged.';
    if (primaryCounter) primaryCounter.textContent = 'DONE';
    if (secondaryCounter) secondaryCounter.textContent = `Completed ${totalRounds} Rounds`;
    if (btnSkipPhase) btnSkipPhase.classList.add('hidden');
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      labelMainAction.textContent = 'Start New Session';
    }
    updateProgressRing(100);
    saveSessionStats();
  }

  function resetTimers() {
    if (phaseTimer) clearInterval(phaseTimer);
    if (breathCycleTimer) clearTimeout(breathCycleTimer);
    audioPlayer.stop();
  }

  function resetSession() {
    resetTimers();
    phase = 'IDLE';
    isPaused = false;
    breathCount = 0;
    elapsedPhaseSeconds = 0;
    targetHoldSeconds = baseHoldSeconds;

    if (phaseLabel) {
      phaseLabel.textContent = 'Ready';
      phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400';
    }
    if (breathActionText) breathActionText.textContent = 'Press Start';
    updateTip(1);
    if (primaryCounter) primaryCounter.textContent = '00:00';
    if (secondaryCounter) secondaryCounter.textContent = `${targetBreaths} Breaths Total`;
    if (breathHalo) breathHalo.style.transform = 'scale(1.0)';
    if (btnSkipPhase) btnSkipPhase.classList.add('hidden');
    if (iconPlay && iconPause && labelMainAction) {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      labelMainAction.textContent = 'Start Session';
    }
    updateProgressRing(0);
    updatePresetUI();
  }

  function saveSessionStats() {
    try {
      saveExerciseStats('wim-hof', {
        totalRounds: totalRounds,
        bestHoldSec: targetHoldSeconds,
      });
    } catch {
      // Ignore localStorage errors
    }
  }

  // Initial state setup
  resetSession();

  // Listen for music selection changes and apply immediately if session is active
  window.addEventListener('hb_music_updated', () => {
    if (phase !== 'IDLE' && phase !== 'COMPLETE') {
      playBackgroundMusic();
    }
  });
</script>
