---
---

<div id="music-selection-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
  <div class="relative w-full max-w-4xl max-h-[90vh] overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950/95 shadow-2xl">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-neutral-800 px-6 py-4">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        Choose Your Music
      </h2>
      <p class="text-xs text-neutral-500 font-mono">Customize audio for each breathing phase</p>
      <button
        id="close-music-modal"
        type="button"
        class="p-2 rounded-lg hover:bg-neutral-800 text-neutral-400 hover:text-white transition-colors"
        aria-label="Close music selection"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Phase Tabs -->
    <div class="flex border-b border-neutral-800 bg-neutral-900/50 px-2 py-1 overflow-x-auto" role="tablist" aria-label="Breathing phases">
      <button
        type="button"
        class="phase-tab px-4 py-2 text-xs font-mono font-medium text-neutral-400 hover:text-white transition-colors whitespace-nowrap rounded-t-lg"
        data-phase="guidedBreathing"
        role="tab"
        aria-selected="true"
        aria-controls="panel-guidedBreathing"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Phase 1: Guided Breathing
        </span>
      </button>
      <button
        type="button"
        class="phase-tab px-4 py-2 text-xs font-mono font-medium text-neutral-500 hover:text-white transition-colors whitespace-nowrap rounded-t-lg"
        data-phase="breathOutHold"
        role="tab"
        aria-selected="false"
        aria-controls="panel-breathOutHold"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Phase 2: Breath-Out Hold
        </span>
      </button>
      <button
        type="button"
        class="phase-tab px-4 py-2 text-xs font-mono font-medium text-neutral-500 hover:text-white transition-colors whitespace-nowrap rounded-t-lg"
        data-phase="recoveryHold"
        role="tab"
        aria-selected="false"
        aria-controls="panel-recoveryHold"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Phase 3: Recovery Breath
        </span>
      </button>
    </div>

    <!-- Phase Panels -->
    <div class="overflow-y-auto max-h-[calc(90vh-140px)] p-4 space-y-6">
      <!-- Phase 1: Guided Breathing -->
      <div
        id="panel-guidedBreathing"
        class="phase-panel space-y-4"
        role="tabpanel"
        aria-labelledby="tab-guidedBreathing"
      >
        <div class="text-center text-xs text-neutral-500 font-mono pb-2 border-b border-neutral-800">
          Choose background music for the 30-breath guided breathing phase. Same music can be used across different phases.
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="tracks-guidedBreathing"></div>
      </div>

      <!-- Phase 2: Breath-Out Hold -->
      <div
        id="panel-breathOutHold"
        class="phase-panel hidden space-y-4"
        role="tabpanel"
        aria-labelledby="tab-breathOutHold"
      >
        <div class="text-center text-xs text-neutral-500 font-mono pb-2 border-b border-neutral-800">
          Select audio for the breath retention hold phase. Use the same track across phases or choose different ones.
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="tracks-breathOutHold"></div>
      </div>

      <!-- Phase 3: Recovery Hold -->
      <div
        id="panel-recoveryHold"
        class="phase-panel hidden space-y-4"
        role="tabpanel"
        aria-labelledby="tab-recoveryHold"
      >
        <div class="text-center text-xs text-neutral-500 font-mono pb-2 border-b border-neutral-800">
          Pick music for the 15-second recovery breath. Consistent audio across phases creates a cohesive experience.
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="tracks-recoveryHold"></div>
      </div>
    </div>

    <!-- Footer Actions -->
    <div class="flex items-center justify-between border-t border-neutral-800 px-6 py-4 bg-neutral-900/50">
      <div class="flex items-center gap-2 text-xs text-neutral-500">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Settings saved automatically to your browser</span>
      </div>
      <button
        id="apply-music-settings"
        type="button"
        class="px-5 py-2 rounded-xl bg-cyan-500 text-black font-semibold text-sm hover:bg-cyan-400 transition-colors"
      >
        Apply & Close
      </button>
    </div>
  </div>
</div>

<script>
  import { musicTracks } from '../config/audioConfig';
  import { audioPlayer } from '../utils/audioPlayer';

  const STORAGE_KEY = 'hb_music_selections';

  // Default selections
  const defaultSelections = {
    guidedBreathing: 'guided-breathing-default',
    breathOutHold: 'breath-out-hold-default',
    recoveryHold: 'recovery-hold-default',
  };

  // Load saved selections from localStorage
  function getSavedSelections() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        return { ...defaultSelections, ...JSON.parse(saved) };
      }
    } catch {
      // Ignore localStorage errors
    }
    return defaultSelections;
  }

  // Save selections to localStorage
  function saveSelections(selections) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(selections));
    } catch {
      // Ignore localStorage errors
    }
  }

  // Current selections
  let currentSelections = getSavedSelections();

  // DOM Elements
  const modal = document.getElementById('music-selection-modal');
  const closeBtn = document.getElementById('close-music-modal');
  const applyBtn = document.getElementById('apply-music-settings');
  const phaseTabs = document.querySelectorAll('.phase-tab');
  const phasePanels = document.querySelectorAll('.phase-panel');
  const trackContainers = {
    guidedBreathing: document.getElementById('tracks-guidedBreathing'),
    breathOutHold: document.getElementById('tracks-breathOutHold'),
    recoveryHold: document.getElementById('tracks-recoveryHold'),
  };

  // Render tracks for a phase
  function renderTracks(phase) {
    const container = trackContainers[phase];
    const tracks = musicTracks[phase];
    const selectedId = currentSelections[phase];

    container.innerHTML = tracks.map(track => {
      const isSelected = track.id === selectedId;
      return `
        <button
          type="button"
          class="music-track-card relative group p-4 rounded-xl border-2 transition-all duration-200 ${isSelected
            ? 'border-cyan-400 bg-cyan-500/10'
            : 'border-neutral-800 bg-neutral-900/50 hover:border-neutral-700'}"
          data-track-id="${track.id}"
          data-phase="${phase}"
          aria-pressed="${isSelected}"
        >
          <div class="absolute top-2 right-2">
            <svg class="w-5 h-5 ${isSelected ? 'text-cyan-400' : 'hidden'}" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center ${isSelected ? 'bg-cyan-500/20' : 'bg-neutral-800/50'}">
              <svg class="w-5 h-5 ${isSelected ? 'text-cyan-400' : 'text-neutral-500'}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-sm font-medium text-white truncate">${track.name}</h4>
              <p class="text-xs text-neutral-400 mt-0.5 truncate">${track.description}</p>
            </div>
          </div>
          ${isSelected ? '<span class="absolute bottom-2 right-2 text-xs font-mono text-cyan-400">Selected</span>' : ''}
        </button>
      `;
    }).join('');

    // Add click listeners
    container.querySelectorAll('.music-track-card').forEach(card => {
      card.addEventListener('click', () => {
        const trackId = card.dataset.trackId;
        const phase = card.dataset.phase;
        selectTrack(phase, trackId);
      });
    });
  }

  // Select a track for a phase
  function selectTrack(phase, trackId) {
    currentSelections[phase] = trackId;
    saveSelections(currentSelections);
    renderTracks(phase);
    
    // Preview the track
    audioPlayer.previewTrack(phase, trackId);
    
    // Dispatch event for other components to listen
    window.dispatchEvent(new CustomEvent('hb_music_updated', { 
      detail: { phase, trackId, selections: currentSelections } 
    }));
  }

  // Switch phase tab
  function switchPhase(phase) {
    audioPlayer.stopPreview();
    phaseTabs.forEach(tab => {
      const isActive = tab.dataset.phase === phase;
      tab.classList.toggle('text-white', isActive);
      tab.classList.toggle('text-neutral-400', !isActive);
      tab.classList.toggle('text-neutral-500', !isActive);
      tab.classList.toggle('bg-neutral-800', isActive);
      tab.setAttribute('aria-selected', isActive);
    });

    phasePanels.forEach(panel => {
      const isActive = panel.id === `panel-${phase}`;
      panel.classList.toggle('hidden', !isActive);
    });
  }

  // Open modal
  function openModal() {
    audioPlayer.stopPreview();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    
    // Render all tracks
    Object.keys(trackContainers).forEach(renderTracks);
  }

  // Close modal
  function closeModal() {
    audioPlayer.stopPreview();
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  // Event Listeners
  closeBtn?.addEventListener('click', closeModal);
  applyBtn?.addEventListener('click', closeModal);

  phaseTabs.forEach(tab => {
    tab.addEventListener('click', () => switchPhase(tab.dataset.phase));
  });

  // Close on backdrop click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  // Expose open function globally
  window.openMusicModal = openModal;

  // Listen for music selection updates from other components
  window.addEventListener('hb_music_updated', (e) => {
    currentSelections = e.detail.selections;
    Object.keys(trackContainers).forEach(renderTracks);
  });
</script>

<style>
  .music-track-card:focus-visible {
    outline: 2px solid #22d3ee;
    outline-offset: 2px;
  }
  
  .phase-tab[aria-selected="true"] {
    background-color: #1f2937;
    color: white;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .music-track-card,
    .phase-tab {
      transition: none;
    }
  }
</style>