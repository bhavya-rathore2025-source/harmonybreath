---
import PhysiologicalCustomSettingsModal from './PhysiologicalCustomSettingsModal.astro';
import PhysiologicalMusicSelectionModal from './PhysiologicalMusicSelectionModal.astro';
---

<section id="sigh-timer-section" class="w-full max-w-4xl mx-auto py-8 px-4">
  <div class="relative w-full bg-neutral-950/80 border border-neutral-800/80 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-xl overflow-hidden">
    <div id="sigh-phase-glow" class="absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-emerald-500/20 via-transparent to-transparent"></div>

    <div class="relative z-10 flex items-center justify-between border-b border-neutral-800/60 pb-6 mb-8">
      <div class="flex items-center gap-3">
        <span id="sigh-preset-badge" class="px-3 py-1 rounded-full text-xs font-mono font-medium border border-emerald-400/30 bg-emerald-400/10 text-emerald-400">
          Quick Reset (10 Cycles)
        </span>
        <span id="sigh-cycle-badge" class="text-xs font-mono text-neutral-400">
          Cycle <span id="sigh-current-cycle-text" class="text-white font-bold">1</span> of <span id="sigh-total-cycles-text" class="text-white font-bold">10</span>
        </span>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400">
        <span id="sigh-status-indicator" class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="sigh-phase-label" class="uppercase tracking-wider font-semibold text-emerald-400">Ready</span>
      </div>
    </div>

    <div class="relative z-10 flex flex-col items-center justify-center my-6">
      <div class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center">
        <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="3" class="text-neutral-900" fill="none" />
          <circle
            id="sigh-progress-circle"
            cx="50"
            cy="50"
            r="44"
            stroke="url(#sigh-gradient-accent)"
            stroke-width="3.5"
            stroke-dasharray="276.46"
            stroke-dashoffset="0"
            stroke-linecap="round"
            class="transition-all duration-300"
            fill="none"
          />
          <defs>
            <linearGradient id="sigh-gradient-accent" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#34d399" />
              <stop offset="50%" stop-color="#22d3ee" />
              <stop offset="100%" stop-color="#14b8a6" />
            </linearGradient>
          </defs>
        </svg>

        <div id="sigh-breath-halo" class="absolute w-44 h-44 rounded-full bg-gradient-to-tr from-emerald-500/20 via-cyan-500/20 to-teal-500/20 transition-transform duration-[2500ms] ease-in-out scale-100 flex items-center justify-center border border-white/5"></div>

        <div class="relative z-20 flex flex-col items-center text-center">
          <div id="sigh-breath-action-text" class="text-xs font-mono uppercase tracking-widest text-emerald-400 mb-1">
            Press Start
          </div>

          <div id="sigh-primary-counter" class="text-5xl sm:text-6xl font-bold tracking-normal font-mono-numbers text-white">
            00:00
          </div>

          <div id="sigh-secondary-counter" class="text-xs font-mono text-neutral-400 mt-2">
            3s In • 1s Sharp Sip • 6s Out
          </div>
        </div>
      </div>

      <div class="mt-6 flex items-center gap-3 text-xs text-neutral-500 bg-neutral-900/40 border border-neutral-800/60 px-4 py-2 rounded-full font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Inhale (3s)</span>
        <span class="text-neutral-700">|</span>
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>Sharp Sip (1s)</span>
        <span class="text-neutral-700">|</span>
        <span class="w-2 h-2 rounded-full bg-teal-400"></span>
        <span>Exhale (6s)</span>
      </div>
    </div>

    <div class="relative z-10 flex flex-wrap items-center justify-center gap-4 mt-8 pt-6 border-t border-neutral-800/60">
      <button
        id="sigh-btn-main-action"
        type="button"
        class="flex items-center gap-2 px-8 py-3.5 rounded-full bg-emerald-500 hover:bg-emerald-400 text-black font-semibold text-sm transition-all transform active:scale-95 shadow-xl shadow-emerald-500/15"
      >
        <svg id="sigh-icon-play" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="sigh-icon-pause" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <span id="sigh-label-main-action">Start Session</span>
      </button>

      <button
        id="sigh-btn-skip-phase"
        type="button"
        class="hidden flex items-center gap-2 px-6 py-3.5 rounded-full bg-neutral-900 border border-neutral-750 text-neutral-200 hover:text-white hover:bg-neutral-800 text-xs font-mono font-medium transition-all"
      >
        <span id="sigh-label-skip-phase">Skip Phase</span>
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
        </svg>
      </button>

      <button
        id="sigh-btn-restart"
        type="button"
        class="flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all"
        title="Restart Session"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset</span>
      </button>

      <button
        id="sigh-btn-music"
        type="button"
        class="flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all"
        title="Change Background Music"
      >
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span>Music</span>
      </button>
    </div>
  </div>
</section>

<PhysiologicalCustomSettingsModal />
<PhysiologicalMusicSelectionModal />

<script>
  import { audioPlayer } from '../utils/audioPlayer';
  import { musicTracks } from '../config/audioConfig';
  import { saveExerciseStats } from '../utils/stats';

  const SIGH_MUSIC_KEY = 'hb_sigh_music_selection';
  const allTracks = [
    ...musicTracks.guidedBreathing,
    ...musicTracks.breathOutHold,
    ...musicTracks.recoveryHold,
  ];

  let inhale1Sec = 3;
  let inhale2Sec = 1;
  let exhaleSec = 6;
  let totalCycles = 10;
  let currentCycle = 1;
  let currentPreset = 'quick';

  const PHASES = ['INHALE_1', 'INHALE_2', 'EXHALE'];
  let currentPhaseIndex = 0;
  let phaseElapsed = 0;

  let state = 'IDLE'; // IDLE, RUNNING, PAUSED, COMPLETED
  let tickTimer: any = null;

  const progressCircle = document.getElementById('sigh-progress-circle') as SVGCircleElement | null;
  const breathHalo = document.getElementById('sigh-breath-halo');
  const phaseGlow = document.getElementById('sigh-phase-glow');
  const phaseLabel = document.getElementById('sigh-phase-label');
  const breathActionText = document.getElementById('sigh-breath-action-text');
  const primaryCounter = document.getElementById('sigh-primary-counter');
  const secondaryCounter = document.getElementById('sigh-secondary-counter');
  const presetBadge = document.getElementById('sigh-preset-badge');
  const currentCycleText = document.getElementById('sigh-current-cycle-text');
  const totalCyclesText = document.getElementById('sigh-total-cycles-text');
  const statusIndicator = document.getElementById('sigh-status-indicator');

  const btnMainAction = document.getElementById('sigh-btn-main-action');
  const iconPlay = document.getElementById('sigh-icon-play');
  const iconPause = document.getElementById('sigh-icon-pause');
  const labelMainAction = document.getElementById('sigh-label-main-action');
  const btnSkipPhase = document.getElementById('sigh-btn-skip-phase');
  const btnRestart = document.getElementById('sigh-btn-restart');
  const btnMusic = document.getElementById('sigh-btn-music');

  const customModal = document.getElementById('sigh-custom-modal');
  const customSettingsBtn = document.getElementById('sigh-custom-settings-btn');
  const closeCustomModal = document.getElementById('close-sigh-custom-modal');
  const applyCustom = document.getElementById('apply-sigh-custom');
  const customInhale1Input = document.getElementById('sigh-custom-inhale1-input') as HTMLInputElement | null;
  const customInhale1Val = document.getElementById('sigh-custom-inhale1-val');
  const customInhale2Input = document.getElementById('sigh-custom-inhale2-input') as HTMLInputElement | null;
  const customInhale2Val = document.getElementById('sigh-custom-inhale2-val');
  const customExhaleInput = document.getElementById('sigh-custom-exhale-input') as HTMLInputElement | null;
  const customExhaleVal = document.getElementById('sigh-custom-exhale-val');
  const customCyclesInput = document.getElementById('sigh-custom-cycles-input') as HTMLInputElement | null;
  const customCyclesVal = document.getElementById('sigh-custom-cycles-val');

  function getPhaseDuration(phaseKey: string) {
    if (phaseKey === 'INHALE_1') return inhale1Sec;
    if (phaseKey === 'INHALE_2') return inhale2Sec;
    if (phaseKey === 'EXHALE') return exhaleSec;
    return 4;
  }

  function getPhaseConfig(phaseKey: string) {
    switch (phaseKey) {
      case 'INHALE_1':
        return {
          label: 'Phase 1: Inhale',
          action: 'Breathe In Deeply (Nose)',
          glow: 'from-emerald-500/20',
          labelClass: 'text-emerald-400',
          haloScale: 'scale-125 duration-[3000ms]',
        };
      case 'INHALE_2':
        return {
          label: 'Phase 2: Second Inhale',
          action: 'Sharp "Sip" of Air (Nose)',
          glow: 'from-cyan-500/20',
          labelClass: 'text-cyan-400',
          haloScale: 'scale-140 duration-[1000ms]',
        };
      case 'EXHALE':
        return {
          label: 'Phase 3: Long Exhale',
          action: 'Slow Extended Exhale (Mouth)',
          glow: 'from-teal-500/20',
          labelClass: 'text-teal-400',
          haloScale: 'scale-90 duration-[6000ms]',
        };
      default:
        return {
          label: 'Ready',
          action: 'Press Start',
          glow: 'from-emerald-500/20',
          labelClass: 'text-emerald-400',
          haloScale: 'scale-100 duration-500',
        };
    }
  }

  function formatTime(sec: number) {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  }

  function updateProgressRing(percent: number) {
    if (!progressCircle) return;
    const circumference = 2 * Math.PI * 44;
    const offset = circumference - (percent / 100) * circumference;
    progressCircle.style.strokeDashoffset = `${offset}`;
  }

  function getSelectedMusicFilePath() {
    try {
      const trackId = localStorage.getItem(SIGH_MUSIC_KEY);
      if (!trackId) return null;
      const track = allTracks.find(t => t.id === trackId);
      return track?.filePath || null;
    } catch {
      return null;
    }
  }

  function updateUI() {
    if (presetBadge) {
      presetBadge.textContent = currentPreset === 'custom'
        ? `Custom (${inhale1Sec}-${inhale2Sec}-${exhaleSec})`
        : `${currentPreset.toUpperCase()} (${inhale1Sec}-${inhale2Sec}-${exhaleSec})`;
    }

    if (currentCycleText) currentCycleText.textContent = String(currentCycle);
    if (totalCyclesText) totalCyclesText.textContent = String(totalCycles);

    if (secondaryCounter) {
      secondaryCounter.textContent = `${inhale1Sec}s In • ${inhale2Sec}s Sharp Sip • ${exhaleSec}s Out`;
    }

    if (statusIndicator) {
      statusIndicator.className = state === 'RUNNING' ? 'w-2 h-2 rounded-full bg-emerald-400 animate-ping' : 'w-2 h-2 rounded-full bg-emerald-400';
    }

    if (state === 'IDLE') {
      if (phaseLabel) {
        phaseLabel.textContent = 'Ready';
        phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400';
      }
      if (breathActionText) {
        breathActionText.textContent = 'Press Start';
        breathActionText.className = 'text-xs font-mono uppercase tracking-widest text-emerald-400 mb-1';
      }
      if (primaryCounter) primaryCounter.textContent = formatTime(0);
      updateProgressRing(0);
      if (iconPlay) iconPlay.classList.remove('hidden');
      if (iconPause) iconPause.classList.add('hidden');
      if (labelMainAction) labelMainAction.textContent = 'Start Session';
      if (btnSkipPhase) btnSkipPhase.classList.add('hidden');
      if (breathHalo) breathHalo.className = 'absolute w-44 h-44 rounded-full bg-gradient-to-tr from-emerald-500/20 via-cyan-500/20 to-teal-500/20 transition-transform duration-700 ease-in-out scale-100 flex items-center justify-center border border-white/5';
      return;
    }

    if (state === 'COMPLETED') {
      if (phaseLabel) {
        phaseLabel.textContent = 'Completed';
        phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400';
      }
      if (breathActionText) {
        breathActionText.textContent = 'Session Complete!';
        breathActionText.className = 'text-xs font-mono uppercase tracking-widest text-emerald-400 mb-1';
      }
      if (primaryCounter) primaryCounter.textContent = formatTime((inhale1Sec + inhale2Sec + exhaleSec) * totalCycles);
      updateProgressRing(100);
      if (iconPlay) iconPlay.classList.remove('hidden');
      if (iconPause) iconPause.classList.add('hidden');
      if (labelMainAction) labelMainAction.textContent = 'Start Again';
      if (btnSkipPhase) btnSkipPhase.classList.add('hidden');
      return;
    }

    const currentPhaseKey = PHASES[currentPhaseIndex];
    const dur = getPhaseDuration(currentPhaseKey);
    const cfg = getPhaseConfig(currentPhaseKey);

    if (phaseLabel) {
      phaseLabel.textContent = cfg.label;
      phaseLabel.className = `uppercase tracking-wider font-semibold ${cfg.labelClass}`;
    }
    if (breathActionText) {
      breathActionText.textContent = cfg.action;
      breathActionText.className = `text-xs font-mono uppercase tracking-widest ${cfg.labelClass} mb-1`;
    }

    const currentSec = Math.min(dur, Math.floor(phaseElapsed));
    if (primaryCounter) primaryCounter.textContent = formatTime(currentSec);

    const percent = Math.min(100, (phaseElapsed / dur) * 100);
    updateProgressRing(percent);

    if (phaseGlow) {
      phaseGlow.className = `absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b ${cfg.glow} via-transparent to-transparent`;
    }

    if (breathHalo) {
      breathHalo.className = `absolute w-44 h-44 rounded-full bg-gradient-to-tr from-emerald-500/20 via-cyan-500/20 to-teal-500/20 transition-transform ease-in-out flex items-center justify-center border border-white/5 ${cfg.haloScale}`;
    }

    if (state === 'RUNNING') {
      if (iconPlay) iconPlay.classList.add('hidden');
      if (iconPause) iconPause.classList.remove('hidden');
      if (labelMainAction) labelMainAction.textContent = 'Pause';
      if (btnSkipPhase) btnSkipPhase.classList.remove('hidden');
    } else if (state === 'PAUSED') {
      if (iconPlay) iconPlay.classList.remove('hidden');
      if (iconPause) iconPause.classList.add('hidden');
      if (labelMainAction) labelMainAction.textContent = 'Resume';
    }
  }

  function startPhase() {
    phaseElapsed = 0;
    audioPlayer.playChime();
    updateUI();
  }

  function tick() {
    if (state !== 'RUNNING') return;
    const currentPhaseKey = PHASES[currentPhaseIndex];
    const dur = getPhaseDuration(currentPhaseKey);

    phaseElapsed += 0.2;

    if (phaseElapsed >= dur) {
      advancePhase();
    } else {
      updateUI();
    }
  }

  function advancePhase() {
    currentPhaseIndex++;
    if (currentPhaseIndex >= PHASES.length) {
      currentPhaseIndex = 0;
      currentCycle++;
      if (currentCycle > totalCycles) {
        completeSession();
        return;
      }
    }
    startPhase();
  }

  function completeSession() {
    state = 'COMPLETED';
    clearInterval(tickTimer);
    tickTimer = null;
    audioPlayer.stop();
    audioPlayer.playChime();

    saveExerciseStats('physiological-sigh', { totalRounds: totalCycles });
    updateUI();
  }

  function startSession() {
    if (state === 'RUNNING') {
      state = 'PAUSED';
      audioPlayer.pause();
      clearInterval(tickTimer);
      tickTimer = null;
      updateUI();
      return;
    }

    if (state === 'PAUSED') {
      state = 'RUNNING';
      audioPlayer.resume();
      tickTimer = setInterval(tick, 200);
      updateUI();
      return;
    }

    // IDLE or COMPLETED
    state = 'RUNNING';
    currentCycle = 1;
    currentPhaseIndex = 0;
    phaseElapsed = 0;

    const musicPath = getSelectedMusicFilePath();
    if (musicPath) {
      audioPlayer.playMusicTrack(
        musicPath,
        audioPlayer.isLoopSong(),
        allTracks,
        SIGH_MUSIC_KEY,
        'hb_sigh_music_updated'
      );
    }

    startPhase();
    tickTimer = setInterval(tick, 200);
    updateUI();
  }

  function resetSession() {
    state = 'IDLE';
    clearInterval(tickTimer);
    tickTimer = null;
    currentCycle = 1;
    currentPhaseIndex = 0;
    phaseElapsed = 0;
    audioPlayer.stop();
    updateUI();
  }

  function skipPhase() {
    if (state !== 'RUNNING' && state !== 'PAUSED') return;
    advancePhase();
  }

  // Event Listeners
  btnMainAction?.addEventListener('click', startSession);
  btnRestart?.addEventListener('click', resetSession);
  btnSkipPhase?.addEventListener('click', skipPhase);

  btnMusic?.addEventListener('click', () => {
    if ((window as any).openSighMusicModal) {
      (window as any).openSighMusicModal();
    }
  });

  // Preset Buttons Listener
  document.querySelectorAll<HTMLButtonElement>('.sigh-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sigh-preset-btn').forEach(b => {
        b.classList.remove('border-emerald-500/50', 'bg-emerald-500/10');
        b.classList.add('border-neutral-800', 'bg-neutral-950/60');
      });
      btn.classList.remove('border-neutral-800', 'bg-neutral-950/60');
      btn.classList.add('border-emerald-500/50', 'bg-emerald-500/10');

      const preset = btn.dataset.sighPreset || 'custom';
      if (preset === 'custom') {
        openCustomModal();
        return;
      }

      currentPreset = preset;
      inhale1Sec = parseInt(btn.dataset.inhale1 || '3', 10);
      inhale2Sec = parseInt(btn.dataset.inhale2 || '1', 10);
      exhaleSec = parseInt(btn.dataset.exhale || '6', 10);
      totalCycles = parseInt(btn.dataset.cycles || '10', 10);

      resetSession();
    });
  });

  // Custom Modal Handlers
  function openCustomModal() {
    if (!customModal) return;
    if (customInhale1Input) customInhale1Input.value = String(inhale1Sec);
    if (customInhale1Val) customInhale1Val.textContent = `${inhale1Sec}s`;

    if (customInhale2Input) customInhale2Input.value = String(inhale2Sec);
    if (customInhale2Val) customInhale2Val.textContent = `${inhale2Sec}s`;

    if (customExhaleInput) customExhaleInput.value = String(exhaleSec);
    if (customExhaleVal) customExhaleVal.textContent = `${exhaleSec}s`;

    if (customCyclesInput) customCyclesInput.value = String(totalCycles);
    if (customCyclesVal) customCyclesVal.textContent = `${totalCycles} Cycles`;

    customModal.classList.remove('hidden');
    customModal.classList.add('flex');
  }

  function closeCustomModalFunc() {
    if (!customModal) return;
    customModal.classList.add('hidden');
    customModal.classList.remove('flex');
  }

  customSettingsBtn?.addEventListener('click', openCustomModal);
  closeCustomModal?.addEventListener('click', closeCustomModalFunc);

  customInhale1Input?.addEventListener('input', () => {
    if (customInhale1Val) customInhale1Val.textContent = `${customInhale1Input.value}s`;
  });
  customInhale2Input?.addEventListener('input', () => {
    if (customInhale2Val) customInhale2Val.textContent = `${customInhale2Input.value}s`;
  });
  customExhaleInput?.addEventListener('input', () => {
    if (customExhaleVal) customExhaleVal.textContent = `${customExhaleInput.value}s`;
  });
  customCyclesInput?.addEventListener('input', () => {
    if (customCyclesVal) customCyclesVal.textContent = `${customCyclesInput.value} Cycles`;
  });

  applyCustom?.addEventListener('click', () => {
    if (customInhale1Input) inhale1Sec = parseInt(customInhale1Input.value, 10);
    if (customInhale2Input) inhale2Sec = parseInt(customInhale2Input.value, 10);
    if (customExhaleInput) exhaleSec = parseInt(customExhaleInput.value, 10);
    if (customCyclesInput) totalCycles = parseInt(customCyclesInput.value, 10);

    currentPreset = 'custom';
    closeCustomModalFunc();
    resetSession();
  });

  window.addEventListener('hb_sigh_music_updated', () => {
    if (state === 'RUNNING') {
      const musicPath = getSelectedMusicFilePath();
      if (musicPath) {
        audioPlayer.playMusicTrack(musicPath, true);
      } else {
        audioPlayer.stop();
      }
    }
  });

  updateUI();
</script>
