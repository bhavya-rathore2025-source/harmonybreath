---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang } = Astro.props;
const currentLang = (lang || getLangFromUrl(Astro.url)) as SupportedLanguage;
const t = useTranslations(currentLang);
const privacyUrl = currentLang === 'en' ? '/privacy/' : `/${currentLang}/privacy/`;
---

<aside
  id="cookie-consent"
  class="fixed bottom-0 left-0 right-0 z-50 hidden transition-all duration-300"
  role="region"
  aria-label={t('cookie.title')}
>
  <div class="max-w-5xl mx-auto p-2.5 sm:p-4">
    <div class="bg-neutral-900/95 border border-neutral-800 rounded-2xl p-3.5 sm:p-4 shadow-2xl backdrop-blur-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex-1 min-w-0 text-xs text-neutral-300 leading-relaxed">
          <p class="font-medium text-white text-xs sm:text-sm mb-0.5">{t('cookie.title')}</p>
          <p>
            {t('cookie.text')}
            <a
              href={privacyUrl}
              class="underline underline-offset-2 text-amber-400 hover:text-amber-300 ml-1 transition-colors whitespace-nowrap"
            >
              {t('footer.privacyPolicy')}
            </a>
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            id="cookie-reject"
            type="button"
            class="flex-1 sm:flex-none px-3.5 py-1.5 text-xs font-medium text-neutral-300 hover:text-white rounded-lg border border-neutral-700 hover:border-neutral-600 transition-colors cursor-pointer text-center whitespace-nowrap active:scale-95"
          >
            {t('cookie.reject')}
          </button>
          <button
            id="cookie-accept"
            type="button"
            class="flex-1 sm:flex-none px-3.5 py-1.5 text-xs font-semibold text-neutral-950 bg-amber-400 hover:bg-amber-300 rounded-lg transition-colors cursor-pointer text-center whitespace-nowrap shadow-sm active:scale-95"
          >
            {t('cookie.accept')}
          </button>
        </div>
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  const STORAGE_KEY = 'hb-cookie-consent';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  function getConsent() {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function setConsent(value) {
    try {
      localStorage.setItem(STORAGE_KEY, value);
      window.dispatchEvent(new CustomEvent('hb-consent', { detail: value }));
    } catch {}
  }

  function clearAnalyticsCookies() {
    try {
      var cookies = document.cookie.split(';');
      for (var i = 0; i < cookies.length; i++) {
        var cookie = cookies[i].trim();
        var eqPos = cookie.indexOf('=');
        var name = eqPos > -1 ? cookie.substr(0, eqPos) : cookie;
        if (name.indexOf('_ga') === 0 || name.indexOf('_gid') === 0 || name.indexOf('_gat') === 0) {
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/';
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=' + window.location.hostname;
          document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;domain=.' + window.location.hostname.replace(/^www\./, '');
        }
      }
    } catch (e) {}
  }

  function applyConsent(consent) {
    var isGranted = consent === 'accepted';
    if (typeof gtag === 'function') {
      gtag('consent', 'update', {
        ad_storage: isGranted ? 'granted' : 'denied',
        analytics_storage: isGranted ? 'granted' : 'denied',
        ad_user_data: isGranted ? 'granted' : 'denied',
        ad_personalization: isGranted ? 'granted' : 'denied',
        functionality_storage: isGranted ? 'granted' : 'denied',
        personalization_storage: isGranted ? 'granted' : 'denied',
        security_storage: 'granted',
      });
    }
    if (typeof dataLayer !== 'undefined') {
      dataLayer.push({ event: 'consent_updated', consent_status: consent });
    }
    if (!isGranted) {
      clearAnalyticsCookies();
    }
  }

  // Check initial state
  var currentConsent = getConsent();
  if (currentConsent === null) {
    if (banner) banner.classList.remove('hidden');
  } else {
    applyConsent(currentConsent);
  }

  if (acceptBtn) {
    acceptBtn.addEventListener('click', function () {
      applyConsent('accepted');
      setConsent('accepted');
      if (banner) banner.classList.add('hidden');
    });
  }

  if (rejectBtn) {
    rejectBtn.addEventListener('click', function () {
      applyConsent('rejected');
      setConsent('rejected');
      if (banner) banner.classList.add('hidden');
    });
  }

  // Global function to reopen cookie settings at any time
  window.openCookieSettings = function () {
    if (banner) {
      banner.classList.remove('hidden');
    }
  };

  // Wire up any trigger buttons with data-open-cookie-settings
  function initTriggers() {
    document.querySelectorAll('[data-open-cookie-settings]').forEach(function (el) {
      if (!el.dataset.cookieBound) {
        el.dataset.cookieBound = 'true';
        el.addEventListener('click', function (e) {
          e.preventDefault();
          window.openCookieSettings();
        });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTriggers);
  } else {
    initTriggers();
  }
</script>
