---
const consentKey = 'hb-cookie-consent';
---

<section id="cookie-consent" class="fixed bottom-0 left-0 right-0 z-50 hidden" aria-label="Cookie consent banner">
  <div class="max-w-5xl mx-auto p-4 sm:p-6">
    <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-4 sm:p-6 shadow-2xl backdrop-blur-xl">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex-1 text-sm text-neutral-300 leading-relaxed">
          <p class="font-medium text-white mb-1">This site uses cookies</p>
          <p>
            We use Google AdSense to show ads. Some ads may be personalized based on your browsing activity.
            You can accept or reject personalized advertising. Read our
            <a href="/privacy" class="text-amber-400 hover:text-amber-300 underline underline-offset-2">Privacy Policy</a>.
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <button id="cookie-reject" class="px-4 py-2 text-sm font-medium text-neutral-300 hover:text-white rounded-lg border border-neutral-700 hover:border-neutral-600 transition-colors cursor-pointer">
            Reject All
          </button>
          <button id="cookie-accept" class="px-4 py-2 text-sm font-medium text-white bg-amber-500 hover:bg-amber-400 rounded-lg transition-colors cursor-pointer">
            Accept All
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const STORAGE_KEY = '{consentKey}';
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const rejectBtn = document.getElementById('cookie-reject');

  function getConsent() {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function setConsent(value) {
    try {
      localStorage.setItem(STORAGE_KEY, value);
      window.dispatchEvent(new CustomEvent('hb-consent', { detail: value }));
    } catch {}
  }

  function applyConsent(consent) {
    if (typeof gtag === 'function') {
      gtag('consent', 'update', {
        ad_storage: consent === 'accepted' ? 'granted' : 'denied',
        ad_user_data: consent === 'accepted' ? 'granted' : 'denied',
        ad_personalization: consent === 'accepted' ? 'granted' : 'denied',
      });
    }
    if (typeof dataLayer !== 'undefined') {
      dataLayer.push({ 'event': 'consent_updated' });
    }
  }

  if (getConsent() === null) {
    banner.classList.remove('hidden');
  } else {
    applyConsent(getConsent());
  }

  acceptBtn.addEventListener('click', function () {
    applyConsent('accepted');
    setConsent('accepted');
    banner.classList.add('hidden');
  });

  rejectBtn.addEventListener('click', function () {
    applyConsent('rejected');
    setConsent('rejected');
    banner.classList.add('hidden');
  });
</script>
