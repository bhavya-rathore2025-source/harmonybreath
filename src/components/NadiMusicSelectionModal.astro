---
import { getLangFromUrl } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';
import { musicI18n } from '../i18n/music';

interface Props {
  lang?: SupportedLanguage;
}

const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const t = musicI18n[lang] || musicI18n.en;
---

<div id="nadi-music-modal" class="fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
  <!-- Hidden JSON dictionary for client script hydration -->
  <script is:inline id="hb-nadi-music-i18n" type="application/json" set:html={JSON.stringify(t)} />

  <div class="relative w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-950/95 shadow-2xl">
    <div class="flex items-center justify-between border-b border-neutral-800 px-4 sm:px-6 py-3 sm:py-4 shrink-0">
      <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span>{t.modalTitle}</span>
      </h2>
      <p class="hidden sm:block text-xs text-neutral-500 font-mono">{t.modalSubtitle}</p>
      <button
        id="close-nadi-music-modal"
        type="button"
        class="p-2 rounded-lg hover:bg-neutral-800 text-neutral-400 hover:text-white transition-colors shrink-0"
        aria-label="Close music selection"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="overflow-y-auto flex-1 p-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pb-3 border-b border-neutral-800 mb-4">
        <div class="text-center sm:text-left text-xs text-neutral-400 font-mono">
          {t.pickInstruction}
        </div>
        <label class="inline-flex items-center gap-2.5 cursor-pointer select-none bg-neutral-900/90 border border-neutral-800 hover:border-neutral-700 px-3 py-1.5 rounded-xl transition-colors shrink-0">
          <span class="text-xs font-medium text-neutral-200">{t.loopSong}</span>
          <span class="text-[10px] text-neutral-500 font-mono hidden xs:inline">{t.playlistHint}</span>
          <div class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="nadi-loop-song-toggle" class="sr-only peer" />
            <div class="w-9 h-5 bg-neutral-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-neutral-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-500"></div>
          </div>
        </label>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="nadi-tracks-container"></div>
    </div>

    <div class="flex items-center justify-between border-t border-neutral-800 px-4 sm:px-6 py-3 sm:py-4 bg-neutral-900/50 shrink-0 gap-3">
      <div class="hidden sm:flex items-center gap-2 text-xs text-neutral-500">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{t.autoSaveHint}</span>
      </div>
      <button
        id="apply-nadi-music"
        type="button"
        class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white font-semibold text-sm transition-colors"
      >
        {t.applyBtn}
      </button>
    </div>
  </div>
</div>

<script>
  import { musicTracks } from '../config/audioConfig';
  import { audioPlayer } from '../utils/audioPlayer';

  const STORAGE_KEY = 'hb_nadi_music_selection';

  const i18nEl = document.getElementById('hb-nadi-music-i18n');
  const t = i18nEl ? JSON.parse(i18nEl.textContent || '{}') : {};

  const allTracks = [
    ...musicTracks.guidedBreathing,
    ...musicTracks.breathOutHold,
    ...musicTracks.recoveryHold,
  ];

  let selectedTrackId = localStorage.getItem(STORAGE_KEY) || allTracks[0]?.id || '';

  const modal = document.getElementById('nadi-music-modal');
  const closeBtn = document.getElementById('close-nadi-music-modal');
  const applyBtn = document.getElementById('apply-nadi-music');
  const container = document.getElementById('nadi-tracks-container');
  const loopToggle = document.getElementById('nadi-loop-song-toggle') as HTMLInputElement | null;

  function syncLoopToggle() {
    if (loopToggle) {
      loopToggle.checked = audioPlayer.isLoopSong();
    }
  }

  loopToggle?.addEventListener('change', () => {
    if (loopToggle) {
      audioPlayer.setLoopSong(loopToggle.checked);
    }
  });

  window.addEventListener('hb_loop_song_changed', syncLoopToggle);

  function getTrackById(id: string) {
    return allTracks.find(t => t.id === id);
  }

  function renderTracks() {
    if (!container) return;
    container.innerHTML = allTracks.map(track => {
      const isSelected = track.id === selectedTrackId;
      const trackMeta = t.tracks?.[track.id] || {};
      const trackName = trackMeta.name || track.name;
      const trackDesc = trackMeta.description || track.description;
      const selectedText = t.selectedBadge || 'Selected';

      return `
        <button
          type="button"
          class="music-track-card relative group p-4 rounded-xl border-2 transition-all duration-200 ${isSelected ? 'border-indigo-400 bg-indigo-400/10' : 'border-neutral-800 bg-neutral-900/50 hover:border-neutral-700'}"
          data-track-id="${track.id}"
          aria-pressed="${isSelected}"
        >
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center ${isSelected ? 'bg-indigo-400/20' : 'bg-neutral-800/50'}">
              <svg class="w-5 h-5 ${isSelected ? 'text-indigo-400' : 'text-neutral-500'}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0 text-left">
              <h4 class="text-sm font-medium text-white truncate">${trackName}</h4>
              <p class="text-xs text-neutral-400 mt-0.5 truncate">${trackDesc}</p>
            </div>
          </div>
          ${isSelected ? `<span class="absolute bottom-2 right-2 text-xs font-mono text-indigo-400">${selectedText}</span>` : ''}
        </button>
      `;
    }).join('');

    container.querySelectorAll('.music-track-card').forEach(card => {
      card.addEventListener('click', () => {
        const trackId = (card as HTMLElement).dataset.trackId;
        if (!trackId) return;

        if (selectedTrackId === trackId) {
          selectedTrackId = '';
          localStorage.removeItem(STORAGE_KEY);
          audioPlayer.stopPreview();
        } else {
          selectedTrackId = trackId;
          localStorage.setItem(STORAGE_KEY, trackId);
          const track = getTrackById(trackId);
          if (track && !audioPlayer.isPlaying()) {
            audioPlayer.previewTrack(track.phase, trackId);
          }
        }
        renderTracks();

        window.dispatchEvent(new CustomEvent('hb_nadi_music_updated', {
          detail: { trackId: selectedTrackId },
        }));
      });
    });
  }

  function openModal() {
    syncLoopToggle();
    renderTracks();
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    document.body.classList.add('modal-open');
  }

  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.body.style.overflow = '';
    document.body.classList.remove('modal-open');
    audioPlayer.stopPreview();
  }

  closeBtn?.addEventListener('click', closeModal);
  applyBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  (window as any).openNadiMusicModal = openModal;
  (window as any).openMusicModal = openModal;
  window.addEventListener('hb_open_nadi_music_modal', openModal);
</script>
