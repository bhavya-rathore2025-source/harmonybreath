---
import type { SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

const translations: Record<SupportedLanguage, {
  title: string;
  desc: string;
  customBtn: string;
  preset1Title: string;
  preset1Desc: string;
  preset2Title: string;
  preset2Desc: string;
  preset3Title: string;
  preset3Desc: string;
  preset4Title: string;
  preset4Desc: string;
  customTitle: string;
  customDesc: string;
}> = {
  en: {
    title: 'Session Presets',
    desc: 'Select cycle count for your 4-7-8 relaxing breath session. Dr. Weil recommends starting with 4 cycles.',
    customBtn: 'Custom Timing & Cycles',
    preset1Title: 'Standard (4 Cycles)',
    preset1Desc: '4 cycles • ~1m 16s',
    preset2Title: 'Calm (8 Cycles)',
    preset2Desc: '8 cycles • ~2m 32s',
    preset3Title: 'Deep (12 Cycles)',
    preset3Desc: '12 cycles • ~3m 48s',
    preset4Title: 'Sleep Prep (16)',
    preset4Desc: '16 cycles • ~5m 04s',
    customTitle: 'Custom',
    customDesc: 'Custom timing & cycles',
  },
  es: {
    title: 'Modos de Sesión',
    desc: 'Selecciona el número de ciclos para tu sesión 4-7-8. El Dr. Weil recomienda iniciar con 4 ciclos.',
    customBtn: 'Tiempos y Ciclos a Medida',
    preset1Title: 'Estándar (4 Ciclos)',
    preset1Desc: '4 ciclos • ~1m 16s',
    preset2Title: 'Calma (8 Ciclos)',
    preset2Desc: '8 ciclos • ~2m 32s',
    preset3Title: 'Profundo (12 Ciclos)',
    preset3Desc: '12 ciclos • ~3m 48s',
    preset4Title: 'Preparar Sueño (16)',
    preset4Desc: '16 ciclos • ~5m 04s',
    customTitle: 'Personalizado',
    customDesc: 'Tiempos y ciclos a medida',
  },
  de: {
    title: 'Sitzungs-Voreinstellungen',
    desc: 'Wählen Sie die Zyklusanzahl für Ihre 4-7-8 Einheit. Dr. Weil empfiehlt, mit 4 Zyklen zu beginnen.',
    customBtn: 'Eigene Zeiten & Zyklen',
    preset1Title: 'Standard (4 Zyklen)',
    preset1Desc: '4 Zyklen • ~1m 16s',
    preset2Title: 'Ruhe (8 Zyklen)',
    preset2Desc: '8 Zyklen • ~2m 32s',
    preset3Title: 'Tief (12 Zyklen)',
    preset3Desc: '12 Zyklen • ~3m 48s',
    preset4Title: 'Schlafvorbereitung (16)',
    preset4Desc: '16 Zyklen • ~5m 04s',
    customTitle: 'Benutzerdefiniert',
    customDesc: 'Individuelle Zeiten & Zyklen',
  },
  fr: {
    title: 'Préréglages de Séance',
    desc: 'Choisissez le nombre de cycles pour votre séance 4-7-8. Le Dr Weil recommande de commencer par 4 cycles.',
    customBtn: 'Temps & Cycles Sur Mesure',
    preset1Title: 'Standard (4 Cycles)',
    preset1Desc: '4 cycles • ~1m 16s',
    preset2Title: 'Calme (8 Cycles)',
    preset2Desc: '8 cycles • ~2m 32s',
    preset3Title: 'Profond (12 Cycles)',
    preset3Desc: '12 cycles • ~3m 48s',
    preset4Title: 'Pré-Sommeil (16)',
    preset4Desc: '16 cycles • ~5m 04s',
    customTitle: 'Personnalisé',
    customDesc: 'Durées et cycles sur mesure',
  },
  pt: {
    title: 'Modos de Sessão',
    desc: 'Selecione a contagem de ciclos para sua sessão 4-7-8. O Dr. Weil recomenda começar com 4 ciclos.',
    customBtn: 'Tempos e Ciclos Personalizados',
    preset1Title: 'Padrão (4 Ciclos)',
    preset1Desc: '4 ciclos • ~1m 16s',
    preset2Title: 'Calma (8 Ciclos)',
    preset2Desc: '8 ciclos • ~2m 32s',
    preset3Title: 'Profundo (12 Ciclos)',
    preset3Desc: '12 ciclos • ~3m 48s',
    preset4Title: 'Preparar Sono (16)',
    preset4Desc: '16 ciclos • ~5m 04s',
    customTitle: 'Personalizado',
    customDesc: 'Tempos e ciclos a medida',
  },
  ja: {
    title: 'セッション・プリセット',
    desc: '4-7-8呼吸のサイクル数を選択してください。ワイル博士はまず4サイクルから始めることを推奨しています。',
    customBtn: '秒数・サイクルを自由設定',
    preset1Title: '標準（4サイクル）',
    preset1Desc: '4サイクル • 約1分16秒',
    preset2Title: '沈静（8サイクル）',
    preset2Desc: '8サイクル • 約2分32秒',
    preset3Title: '深層（12サイクル）',
    preset3Desc: '12サイクル • 約3分48秒',
    preset4Title: '入眠準備（16）',
    preset4Desc: '16サイクル • 約5分04秒',
    customTitle: 'カスタム',
    customDesc: '秒数・サイクルを自由調整',
  },
  it: {
    title: 'Modalità di Sessione',
    desc: 'Seleziona il numero di cicli per la tua sessione 4-7-8. Il Dr. Weil consiglia di iniziare con 4 cicli.',
    customBtn: 'Tempi e Cicli Personalizzati',
    preset1Title: 'Standard (4 Cicli)',
    preset1Desc: '4 cicli • ~1m 16s',
    preset2Title: 'Calma (8 Cicli)',
    preset2Desc: '8 cicli • ~2m 32s',
    preset3Title: 'Profondo (12 Cicli)',
