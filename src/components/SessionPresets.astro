---
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

const presetTranslations: Record<SupportedLanguage, {
  heading: string;
  subheading: string;
  customBtn: string;
  beginner: string;
  intermediate: string;
  advanced: string;
  expert: string;
  custom: string;
  breathsRounds: (b: number, r: number, inc?: boolean) => string;
}> = {
  en: {
    heading: 'Difficulty Presets',
    subheading: 'Select target hold time. Breath count (30) & recovery hold (15s) remain constant.',
    customBtn: 'Custom Preset',
    beginner: 'Beginner',
    intermediate: 'Intermediate',
    advanced: 'Advanced',
    expert: 'Expert',
    custom: 'Custom',
    breathsRounds: (b, r, inc) => `${b} Breaths • ${r} Rounds${inc ? ' (+10s/round)' : ''}`,
  },
  es: {
    heading: 'Modos de Dificultad',
    subheading: 'Selecciona el tiempo objetivo de retención. 30 respiraciones y 15s de recuperación permanecen constantes.',
    customBtn: 'Modo Personalizado',
    beginner: 'Principiante',
    intermediate: 'Intermedio',
    advanced: 'Avanzado',
    expert: 'Experto',
    custom: 'Personalizado',
    breathsRounds: (b, r, inc) => `${b} Respiraciones • ${r} Rondas${inc ? ' (+10s/ronda)' : ''}`,
  },
  de: {
    heading: 'Schwierigkeitsstufen',
    subheading: 'Wähle deine Zielhaltezeit. 30 Atemzüge & 15s Erholungsphase bleiben konstant.',
    customBtn: 'Eigenes Preset',
    beginner: 'Anfänger',
    intermediate: 'Mittelstufe',
    advanced: 'Fortgeschritten',
    expert: 'Experte',
    custom: 'Individuell',
    breathsRounds: (b, r, inc) => `${b} Atemzüge • ${r} Runden${inc ? ' (+10s/Runde)' : ''}`,
  },
  fr: {
    heading: 'Niveaux de Difficulté',
    subheading: 'Sélectionnez le temps d’apnée cible. 30 respirations et 15s de récupération restent constants.',
    customBtn: 'Mode Personnalisé',
    beginner: 'Débutant',
    intermediate: 'Intermédiaire',
    advanced: 'Avancé',
    expert: 'Expert',
    custom: 'Personnalisé',
    breathsRounds: (b, r, inc) => `${b} Souffles • ${r} Cycles${inc ? ' (+10s/cycle)' : ''}`,
  },
  pt: {
    heading: 'Níveis de Dificuldade',
    subheading: 'Selecione o tempo de retenção. 30 respirações e 15s de recuperação permanecem fixos.',
    customBtn: 'Modo Personalizado',
    beginner: 'Iniciante',
    intermediate: 'Intermediário',
    advanced: 'Avançado',
    expert: 'Especialista',
    custom: 'Personalizado',
    breathsRounds: (b, r, inc) => `${b} Respirações • ${r} Rodadas${inc ? ' (+10s/rodada)' : ''}`,
  },
  ja: {
    heading: '難易度プリセット',
    subheading: '目標の息止め時間を選択。呼吸回数（30回）と回復の息止め（15秒）は固定です。',
    customBtn: 'カスタム設定',
    beginner: '初級者',
    intermediate: '中級者',
    advanced: '上級者',
    expert: 'エキスパート',
    custom: 'カスタム',
    breathsRounds: (b, r, inc) => `${b}回の呼吸 • ${r}ラウンド${inc ? '（+10秒/回）' : ''}`,
  },
  it: {
    heading: 'Livelli di Difficoltà',
    subheading: 'Seleziona il tempo target di apnea. 30 respiri e 15s di recupero rimangono costanti.',
    customBtn: 'Personalizzato',
    beginner: 'Principiante',
    intermediate: 'Intermedio',
    advanced: 'Avanzato',
    expert: 'Esperto',
    custom: 'Personalizzato',
    breathsRounds: (b, r, inc) => `${b} Respiri • ${r} Round${inc ? ' (+10s/round)' : ''}`,
  },
};

const p = presetTranslations[lang] || presetTranslations.en;
---

<div class="w-full max-w-4xl mx-auto mb-8">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-4">
    <div>
      <h3 class="text-sm font-mono text-amber-400 uppercase tracking-widest">{p.heading}</h3>
      <p class="text-xs text-neutral-400">{p.subheading}</p>
    </div>
    <button
      id="custom-settings-btn"
      type="button"
      class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-800 bg-neutral-900/80 hover:bg-neutral-800 text-xs font-medium text-neutral-300 hover:text-white transition-colors cursor-pointer"
    >
      <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
      </svg>
      {p.customBtn}
    </button>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 sm:gap-3">
    <!-- Beginner -->
    <button
      data-preset="beginner"
      data-hold="60"
      data-breaths="30"
      data-rounds="3"
      class="preset-btn group relative p-3 sm:p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-cyan-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none cursor-pointer"
    >
      <div class="text-xs font-mono text-cyan-400 mb-1 break-words">{p.beginner}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">60s</div>
      <div class="text-[10px] sm:text-[11px] text-neutral-400 mt-1 leading-tight break-words">{p.breathsRounds(30, 3, false)}</div>
    </button>

    <!-- Intermediate -->
    <button
      data-preset="intermediate"
      data-hold="90"
      data-breaths="30"
      data-rounds="4"
      class="preset-btn group relative p-3 sm:p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-blue-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none cursor-pointer"
    >
      <div class="text-xs font-mono text-blue-400 mb-1 break-words">{p.intermediate}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">90s</div>
      <div class="text-[10px] sm:text-[11px] text-neutral-400 mt-1 leading-tight break-words">{p.breathsRounds(30, 4, true)}</div>
    </button>

    <!-- Advanced -->
    <button
      data-preset="advanced"
      data-hold="120"
      data-breaths="30"
      data-rounds="5"
      class="preset-btn group relative p-3 sm:p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-purple-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none cursor-pointer"
    >
      <div class="text-xs font-mono text-purple-400 mb-1 break-words">{p.advanced}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">120s</div>
      <div class="text-[10px] sm:text-[11px] text-neutral-400 mt-1 leading-tight break-words">{p.breathsRounds(30, 5, true)}</div>
    </button>

    <!-- Expert -->
    <button
      data-preset="expert"
      data-hold="150"
      data-breaths="30"
      data-rounds="5"
      class="preset-btn group relative p-3 sm:p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-pink-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none cursor-pointer"
    >
      <div class="text-xs font-mono text-pink-400 mb-1 break-words">{p.expert}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">150s</div>
      <div class="text-[10px] sm:text-[11px] text-neutral-400 mt-1 leading-tight break-words">{p.breathsRounds(30, 5, true)}</div>
    </button>

    <!-- Custom -->
    <button
      data-preset="custom"
      data-hold="180"
      data-breaths="30"
      data-rounds="3"
      class="preset-btn group relative p-3 sm:p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-amber-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none cursor-pointer col-span-2 sm:col-span-1"
    >
      <div class="text-xs font-mono text-amber-400 mb-1 break-words">{p.custom}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">180s</div>
      <div class="text-[10px] sm:text-[11px] text-neutral-400 mt-1 leading-tight break-words">{p.breathsRounds(30, 3, false)}</div>
    </button>
  </div>
</div>
