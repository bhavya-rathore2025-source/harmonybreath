---
---

<div class="w-full max-w-4xl mx-auto mb-8">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-4">
    <div>
      <h3 class="text-sm font-mono text-cyan-400 uppercase tracking-widest">Difficulty Presets</h3>
      <p class="text-xs text-neutral-400">Select target hold time. Breath count (30) & recovery hold (15s) remain constant.</p>
    </div>
    <button
      id="custom-settings-btn"
      type="button"
      class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-neutral-800 bg-neutral-900/80 hover:bg-neutral-800 text-xs font-medium text-neutral-300 hover:text-white transition-colors"
    >
      <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
      </svg>
      Custom Preset
    </button>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
    <!-- Beginner -->
    <button
      data-preset="beginner"
      data-hold="60"
      data-breaths="30"
      data-rounds="3"
      class="preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-cyan-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none"
    >
      <div class="text-xs font-mono text-cyan-400 mb-1">Beginner</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">60s</div>
      <div class="text-[11px] text-neutral-400 mt-1">30 Breaths • 3 Rounds</div>
    </button>

    <!-- Intermediate -->
    <button
      data-preset="intermediate"
      data-hold="90"
      data-breaths="30"
      data-rounds="4"
      class="preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-blue-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none"
    >
      <div class="text-xs font-mono text-blue-400 mb-1">Intermediate</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">90s</div>
      <div class="text-[11px] text-neutral-400 mt-1">30 Breaths • 4 Rounds (+10s/round)</div>
    </button>

    <!-- Advanced -->
    <button
      data-preset="advanced"
      data-hold="120"
      data-breaths="30"
      data-rounds="5"
      class="preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-purple-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none"
    >
      <div class="text-xs font-mono text-purple-400 mb-1">Advanced</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">120s</div>
      <div class="text-[11px] text-neutral-400 mt-1">30 Breaths • 5 Rounds (+10s/round)</div>
    </button>

    <!-- Expert -->
    <button
      data-preset="expert"
      data-hold="150"
      data-breaths="30"
      data-rounds="5"
      class="preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-pink-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none"
    >
      <div class="text-xs font-mono text-pink-400 mb-1">Expert</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">150s</div>
      <div class="text-[11px] text-neutral-400 mt-1">30 Breaths • 5 Rounds (+10s/round)</div>
    </button>

    <!-- Custom -->
    <button
      data-preset="custom"
      data-hold="180"
      data-breaths="30"
      data-rounds="3"
      class="preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-amber-500/50 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none"
    >
      <div class="text-xs font-mono text-amber-400 mb-1">Custom</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">180s</div>
      <div class="text-[11px] text-neutral-400 mt-1">30 Breaths • 3 Rounds</div>
    </button>
  </div>
</div>
