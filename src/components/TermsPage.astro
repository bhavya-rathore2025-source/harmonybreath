---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { termsI18n } from '../i18n/terms';
import { getHreflangLinks } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const content = termsI18n[lang] || termsI18n.en;

const siteUrl = 'https://harmonybreath.com';
const canonicalUrl = lang === 'en' ? `${siteUrl}/terms/` : `${siteUrl}/${lang}/terms/`;
const homeUrl = lang === 'en' ? `${siteUrl}/` : `${siteUrl}/${lang}/`;
const contactUrl = lang === 'en' ? '/contact/' : `/${lang}/contact/`;
const hreflangLinks = getHreflangLinks('terms', siteUrl);

const homeNames: Record<SupportedLanguage, string> = {
  en: 'Home',
  es: 'Inicio',
  de: 'Startseite',
  fr: 'Accueil',
  pt: 'Início',
  ja: 'ホーム',
  it: 'Home',
};

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": content.metaTitle,
    "description": content.metaDescription,
    "url": canonicalUrl,
    "inLanguage": lang,
    "isPartOf": {
      "@type": "WebSite",
      "name": "HarmonyBreath",
      "url": siteUrl
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": homeNames[lang] || 'Home',
          "item": homeUrl
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": content.breadcrumbName,
          "item": canonicalUrl
        }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "HarmonyBreath",
    "url": siteUrl,
    "logo": `${siteUrl}/favicon-96x96.png`,
    "description": "Free, privacy-first guided breathing timers and breathwork platform."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": homeNames[lang] || 'Home',
        "item": homeUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": content.breadcrumbName,
        "item": canonicalUrl
      }
    ]
  }
];
---

<Layout
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.keywords}
  canonicalUrl={canonicalUrl}
  lang={lang}
  hreflangLinks={hreflangLinks}
  schemaData={pageSchemaData}
>
  <Header lang={lang} />

  <main class="flex-1 hero-gradient-mesh relative selection:bg-amber-500/30 selection:text-amber-200">
    <section class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
      <div class="text-center space-y-4 mb-12">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-400 text-xs font-mono uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          {content.badge}
        </span>
        <h1 class="text-3xl sm:text-5xl font-bold text-white tracking-tight break-words">
          {content.title}
        </h1>
        <p class="text-neutral-400 max-w-2xl mx-auto text-sm font-sans font-light break-words">
          {content.lastUpdated}
        </p>
      </div>

      <div class="max-w-3xl mx-auto space-y-6 text-sm sm:text-base text-neutral-300 leading-relaxed font-sans font-light break-words overflow-hidden [&_h2]:text-white [&_h2]:text-xl [&_h2]:sm:text-2xl [&_h2]:font-bold [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-white [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-8 [&_h3]:mb-3 [&_strong]:text-white [&_strong]:font-medium [&_ul]:list-disc [&_ul]:list-inside [&_ul]:space-y-2 [&_ul]:text-neutral-400">
        <h2>{content.acceptanceTitle}</h2>
        <p>
          {content.acceptanceText}
        </p>

        <h2>{content.educationalTitle}</h2>
        <p>
          {content.educationalTextBeforeBold}<strong>{content.educationalBoldText}</strong>{content.educationalTextAfterBold}
        </p>

        <h2>{content.userRespTitle}</h2>
        <p>{content.userRespIntro}</p>
        <ul>
          {content.userRespPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>

        <h2>{content.medicalTitle}</h2>
        <div class="p-4 sm:p-5 rounded-2xl border border-amber-500/30 bg-amber-500/10 text-amber-200/90 text-sm leading-relaxed space-y-2 my-4">
          <p>
            <strong class="text-amber-400 font-semibold tracking-wide uppercase mr-1">{content.medicalWarningLabel}</strong>
            {content.medicalWarningText}
          </p>
        </div>

        <h2>{content.ipTitle}</h2>
        <p>
          {content.ipText}
        </p>

        <h2>{content.liabilityTitle}</h2>
        <p>
          {content.liabilityText}
        </p>

        <h2>{content.noAccountTitle}</h2>
        <p>
          {content.noAccountText}
        </p>

        <h2>{content.governingLawTitle}</h2>
        <p>
          {content.governingLawText}
        </p>

        <h2>{content.contactTitle}</h2>
        <p>
          {content.contactTextBefore}
          <a href={contactUrl} class="text-amber-400 hover:text-amber-300 underline underline-offset-2 break-all sm:break-normal">{content.contactLinkText}</a>
          {content.contactTextAfter}
        </p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
