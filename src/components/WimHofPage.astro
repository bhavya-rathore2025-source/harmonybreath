---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BreathingTimer from '../components/BreathingTimer.astro';
import SessionPresets from '../components/SessionPresets.astro';
import AnalyticsPanel from '../components/AnalyticsPanel.astro';
import ExploreOtherTechniques from '../components/ExploreOtherTechniques.astro';
import Footer from '../components/Footer.astro';
import { wimHofI18n } from '../i18n/wim-hof';
import { getHreflangLinks } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const content = wimHofI18n[lang] || wimHofI18n.en;

const siteUrl = 'https://harmonybreath.com';
const fullCanonicalUrl = `${siteUrl}${content.canonicalPath}`;
const hreflangLinks = getHreflangLinks('wim-hof', siteUrl);

const datePublished = '2026-07-25';
const dateModified = '2026-08-15';

const breadcrumb = [
  { name: 'Home', url: '/' },
  { name: content.breadcrumbName, url: content.canonicalPath },
];

const pageSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": `HarmonyBreath — ${content.heroTitle.replace('\n', ' ')}`,
    "alternateName": "HarmonyBreath Guided Wim Hof Method App",
    "description": content.metaDescription,
    "url": fullCanonicalUrl,
    "applicationCategory": "HealthApplication",
    "operatingSystem": "Any (Web Browser)",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "featureList": [
      "Guided three-phase Wim Hof method timer with real-time visual halo cues",
      "Beginner to Expert difficulty presets with adjustable retention holds",
      "Fully customizable breath count, retention, cycle speed, and rounds",
      "Audio cues and ambient soundscape player",
      "Private browser-local session analytics with zero data tracking"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": `HarmonyBreath ${content.breadcrumbName} Timer`,
    "description": content.metaDescription,
    "browserRequirements": "Requires JavaScript",
    "applicationCategory": "HealthApplication",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": content.metaTitle,
    "description": content.metaDescription,
    "datePublished": datePublished,
    "dateModified": dateModified,
    "author": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "publisher": {
      "@type": "Organization",
      "name": "HarmonyBreath",
      "url": "https://harmonybreath.com"
    },
    "mainEntityOfPage": fullCanonicalUrl,
    "citation": [
      "https://www.pnas.org/doi/10.1073/pnas.1322174111",
      "https://pubmed.ncbi.nlm.nih.gov/35213875/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": content.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer,
      }
    }))
  }
];
---

<Layout 
  title={content.metaTitle}
  description={content.metaDescription}
  keywords={content.keywords}
  canonicalUrl={fullCanonicalUrl}
  image="https://harmonybreath.com/og-image.png"
  imageAlt={`HarmonyBreath Guided ${content.breadcrumbName} Timer Interface`}
  ogType="article"
  schemaData={pageSchemaData}
  breadcrumb={breadcrumb}
  lang={lang}
  hreflangLinks={hreflangLinks}
>
  <Header />

  <main class="flex-1 bg-[#06080d] text-white relative selection:bg-cyan-500/30 selection:text-cyan-200">
    <!-- Fixed Persistent Atmospheric Background Image -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
      <img 
        src="/wim_hof_hero_bg.jpg" 
        alt="Wim Hof Method breathwork ice and meditation atmosphere visual" 
        class="w-full h-full object-cover object-center filter brightness-[0.75] contrast-110 saturate-110 scale-105"
      />
      <!-- Page-wide Gradient & Radial Ambient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/50 to-[#06080d]/95"></div>
      <div class="absolute inset-0 bg-radial from-cyan-500/15 via-transparent to-transparent"></div>
      <div class="absolute inset-0 noise-overlay opacity-15"></div>
    </div>

    <!-- Scrolling Page Content Container -->
    <div class="relative z-10 w-full">
      <!-- Hero Header Section -->
      <section class="w-full max-w-6xl mx-auto px-4 sm:px-6 pt-6 pb-12 flex flex-col items-center">
        <!-- Floating Glass Nav Pill Bar -->
        <header class="w-full max-w-4xl mx-auto mb-10 sm:mb-14">
          <nav class="flex flex-wrap items-center justify-between gap-3 p-2 sm:px-4 sm:py-2.5 rounded-2xl sm:rounded-full border border-white/15 bg-neutral-950/80 backdrop-blur-2xl shadow-2xl shadow-cyan-950/30">
            <!-- Brand Badge -->
            <div class="flex items-center gap-2.5 px-3 py-1">
              <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse shadow-[0_0_12px_#38bdf8] shrink-0"></span>
              <span class="text-xs sm:text-sm font-bold tracking-wider text-white uppercase font-mono">
                {content.breadcrumbName}
              </span>
            </div>

            <!-- Jump Links (Pills) -->
            <div class="hidden md:flex items-center gap-1 text-xs font-mono font-medium text-neutral-300">
              <a href="#timer-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.timer}</a>
              <a href="#presets" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.presets}</a>
              <a href="#analytics" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.stats}</a>
              <a href="#guide" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.guide}</a>
              <a href="#safety" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.safety}</a>
              <a href="#about-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.about}</a>
              <a href="#faq-section" class="px-3.5 py-1.5 rounded-full hover:bg-white/10 hover:text-white transition-all">{content.jumpLinks.faq}</a>
            </div>

            <!-- Header Action Buttons -->
            <div class="flex items-center gap-2">
              <a 
                href="#timer-section" 
                class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold text-neutral-950 bg-white hover:bg-neutral-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.25)] shrink-0"
              >
                <span>{content.startPracticeBtn}</span>
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </nav>
        </header>

        <!-- Hero Headline & Subtitle -->
        <div class="text-center space-y-6 max-w-3xl mx-auto w-full px-2">
          <div class="inline-flex max-w-full flex-wrap justify-center items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md text-white text-[11px] sm:text-xs font-mono tracking-wide">
            <svg class="w-3.5 h-3.5 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span class="break-words text-center">{content.badge}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.14] sm:leading-[1.08] text-balance drop-shadow-xl whitespace-pre-line break-words">
            {content.heroTitle}
          </h1>

          <p class="max-w-2xl mx-auto text-sm sm:text-lg text-neutral-300 font-light leading-relaxed text-pretty break-words">
            {content.heroSubtitle}
          </p>

          <!-- Authorship & Quick Metadata -->
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-neutral-400 pt-2">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              100% Free & Private
            </span>
            <span class="text-neutral-600">•</span>
            <span>By HarmonyBreath Editorial</span>
            <span class="text-neutral-600">•</span>
            <span>Published {datePublished} · Updated {dateModified}</span>
          </div>
        </div>
      </section>

      <!-- Main Interactive Breathing Timer Component -->
      <div id="timer-section" class="relative z-10 max-w-4xl mx-auto px-4 scroll-mt-20">
        <BreathingTimer lang={lang} />
      </div>

      <!-- Difficulty Presets -->
      <div id="presets" class="scroll-mt-20">
        <SessionPresets lang={lang} />
      </div>

      <!-- Analytics Stats Panel -->
      <div id="analytics" class="scroll-mt-20">
        <AnalyticsPanel exerciseId="wim-hof" lang={lang} />
      </div>

      <!-- Step-by-Step Technique Guide -->
      <section id="guide" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900 scroll-mt-20">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400">{content.techniqueGuide.tag}</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl text-balance">
            {content.techniqueGuide.title}
          </h3>
          <p class="text-sm text-neutral-400">
            {content.techniqueGuide.desc}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {content.techniqueGuide.phases.map((phase, idx) => (
            <div class={`reveal relative p-6 sm:p-7 rounded-3xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md group hover:border-cyan-500/40 hover:bg-neutral-900/40 hover:-translate-y-0.5 transition-all duration-300 ${
              idx === 1 ? 'md:mt-14' : idx === 2 ? 'md:-mt-14' : ''
            }`}>
              <div class="w-11 h-11 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 font-mono font-bold flex items-center justify-center mb-4 text-sm">
                {phase.number}
              </div>
              <h4 class="text-lg font-bold text-white mb-2">{phase.title}</h4>
              <p class="text-xs text-neutral-400 leading-relaxed mb-4 text-pretty">
                {phase.desc}
              </p>
              <ul class="text-xs font-mono text-neutral-500 space-y-1">
                {phase.specs.map((spec) => (
                  <li>{spec}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Breathing Pace Progression Explanation -->
        <div class="reveal mb-12 p-6 sm:p-8 rounded-3xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
          <h4 class="text-sm font-mono text-cyan-400 uppercase tracking-widest mb-4">{content.techniqueGuide.paceTitle}</h4>
          <p class="text-xs text-neutral-400 leading-relaxed mb-6 text-pretty">
            {content.techniqueGuide.paceDesc}
          </p>
          <div class="space-y-4">
            {content.techniqueGuide.rounds.map((round) => (
              <div class="p-4 rounded-xl bg-neutral-900/50 border border-neutral-800">
                <div class="flex items-center gap-2 mb-2">
                  <span class="px-2 py-0.5 rounded text-xs font-mono font-bold bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">{round.badge}</span>
                  <span class="text-xs text-neutral-400">{round.title}</span>
                </div>
                <p class="text-xs text-neutral-300 leading-relaxed">
                  <strong class="text-white">{round.timing}</strong>
                </p>
                <p class="text-xs text-neutral-500 mt-1">
                  {round.desc}
                </p>
              </div>
            ))}

            <!-- Custom Sessions Note -->
            <div class="p-4 rounded-xl bg-neutral-900/50 border border-cyan-500/20">
              <p class="text-xs text-neutral-400 leading-relaxed">
                <strong class="text-cyan-400">{content.techniqueGuide.customNoteTitle}</strong> {content.techniqueGuide.customNoteDesc}
              </p>
            </div>
          </div>
        </div>

        <!-- Benefits Banner -->
        <div class="reveal relative p-8 rounded-3xl border border-neutral-800 bg-gradient-to-r from-neutral-950 via-neutral-900 to-neutral-950 overflow-hidden">
          <div class="noise-overlay absolute inset-0 opacity-[0.03] pointer-events-none"></div>
          <h4 class="relative text-sm font-mono text-cyan-400 uppercase tracking-widest mb-4">{content.techniqueGuide.benefitsTag}</h4>
          <div class="relative grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-medium text-neutral-300">
            {content.techniqueGuide.benefitsList.map((benefit) => (
              <div class="flex items-center gap-3 p-3 rounded-xl bg-neutral-900/50 border border-neutral-800/80">
                <span class="w-2 h-2 rounded-full bg-cyan-400 shrink-0"></span>
                {benefit}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Safety Precautions & Contraindications -->
      <section id="safety" class="w-full max-w-4xl mx-auto py-12 px-4 border-t border-neutral-900 scroll-mt-20">
        <div class="reveal bg-red-950/20 border border-red-500/30 rounded-2xl p-6 sm:p-8 backdrop-blur-md">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-red-500/20 border border-red-500/30 text-red-400 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold text-white">{content.safety.title}</h3>
              <p class="text-xs text-neutral-400">{content.safety.subtitle}</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-neutral-300">
            <div>
              <h4 class="font-bold text-red-400 uppercase tracking-wider mb-2 font-mono">{content.safety.neverTitle}</h4>
              <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
                {content.safety.neverItems.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>

            <div>
              <h4 class="font-bold text-emerald-400 uppercase tracking-wider mb-2 font-mono">{content.safety.alwaysTitle}</h4>
              <ul class="space-y-1.5 text-neutral-400 list-disc list-inside">
                {content.safety.alwaysItems.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-red-500/20 text-[11px] text-neutral-400 leading-relaxed font-mono">
            {content.safety.disclaimer}
          </div>
        </div>
      </section>

      <!-- SEO Content Section about the tool -->
      <section id="about-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900/80 scroll-mt-20">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400">{content.about.tag}</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl text-balance">
            {content.about.title}
          </h3>
          <p class="text-sm text-neutral-400">
            {content.about.subtitle}
          </p>
        </div>

        <div class="space-y-8 text-sm text-neutral-300 leading-relaxed text-pretty">
          <div class="reveal p-4 rounded-xl border border-neutral-800 bg-neutral-900/50 text-xs text-neutral-300 font-sans flex items-start gap-3 backdrop-blur-md">
            <span class="shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </span>
            <div>
              <strong class="text-white font-medium">{content.about.disclosureTitle}</strong> {content.about.disclosureText}
            </div>
          </div>

          <div class="reveal p-6 rounded-2xl border border-cyan-500/20 bg-neutral-950/60 backdrop-blur-md shadow-[0_0_30px_rgba(80,227,194,0.04)]">
            <p class="mb-4">
              {content.about.introP1}
            </p>
            <p>
              {content.about.introP2}
            </p>
          </div>

          <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
            <h4 class="text-lg font-bold text-white mb-3">{content.about.whatIsTitle}</h4>
            <p class="mb-4">
              {content.about.whatIsP1}
            </p>
            <p>
              {content.about.whatIsP2}
            </p>
          </div>

          <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
            <h4 class="text-lg font-bold text-white mb-3">{content.about.scienceTitle}</h4>
            <p class="mb-4">
              {content.about.scienceP1}
            </p>
            <ul class="space-y-2 list-disc list-inside text-neutral-400">
              {content.about.sciencePoints.map((point) => (
                <li><strong class="text-white">{point.label}</strong> {point.text}</li>
              ))}
            </ul>
          </div>

          <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
            <h4 class="text-lg font-bold text-white mb-3">{content.about.featuresTitle}</h4>
            <p class="mb-4">
              {content.about.featuresP1}
            </p>
            <ul class="space-y-2 list-disc list-inside text-neutral-400">
              {content.about.featuresList.map((feat) => (
                <li><strong class="text-white">{feat.label}</strong> {feat.text}</li>
              ))}
            </ul>
          </div>

          <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
            <h4 class="text-lg font-bold text-white mb-3">{content.about.benefitsTitle}</h4>
            <p class="mb-4">
              {content.about.benefitsP1}
            </p>
            <ul class="space-y-2 list-disc list-inside text-neutral-400">
              {content.about.benefitsList.map((ben) => (
                <li>{ben}</li>
              ))}
            </ul>
            <p class="mt-4">
              {content.about.benefitsP2}
            </p>
          </div>

          <div class="reveal p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md">
            <h4 class="text-lg font-bold text-white mb-3">{content.about.howToUseTitle}</h4>
            <p class="mb-4">
              {content.about.howToUseP1}
            </p>
            <p class="mb-4">
              {content.about.howToUseP2}
            </p>
            <p>
              {content.about.howToUseP3}
            </p>
          </div>

          <div class="reveal pt-6 border-t border-neutral-800">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider font-mono mb-3">{content.about.referencesTitle}</h3>
            <ol class="space-y-1.5 text-xs text-neutral-500 font-mono list-decimal list-inside">
              <li>Kox, M., van Eijk, L. T., Zwaag, J., et al. (2014). Voluntary activation of the sympathetic nervous system and attenuation of the innate immune response in humans. <em class="text-neutral-400">PNAS</em>, 111(20), 7379-7384. <a href="https://www.pnas.org/doi/10.1073/pnas.1322174111" target="_blank" rel="noopener" class="text-cyan-400 hover:underline">[PubMed / DOI]</a></li>
              <li>Zwaag, J., et al. (2022). The Effects of Cold Exposure Training and a Breathing Exercise on the Inflammatory Response in Humans: A Pilot Study. <em class="text-neutral-400">Psychosomatic Medicine</em>, 84(4), 457–467. <a href="https://pubmed.ncbi.nlm.nih.gov/35213875/" target="_blank" rel="noopener" class="text-cyan-400 hover:underline">[PubMed]</a></li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Editorial Team Bio -->
      <section class="w-full max-w-4xl mx-auto px-4 py-10">
        <div class="max-w-3xl mx-auto reveal rounded-2xl border border-neutral-800 bg-neutral-950/60 p-6 sm:p-8 font-sans">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-full border border-cyan-400/30 bg-cyan-400/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h2 class="text-sm sm:text-base font-bold text-white">{content.editorialBio.title}</h2>
              <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
                {content.editorialBio.desc}
              </p>
              <p class="text-xs font-mono text-neutral-500">
                {content.editorialBio.disclaimer}
              </p>
              <a href="/about/" class="focus-ring inline-flex items-center gap-1.5 text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors">
                {content.editorialBio.linkText}
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Explore Other Techniques -->
      <ExploreOtherTechniques current="wim-hof" accent="cyan" lang={lang} />

      <!-- FAQ Section with JSON-LD SEO -->
      <section id="faq-section" class="w-full max-w-4xl mx-auto py-16 px-4 border-t border-neutral-900 scroll-mt-20">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
          <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400">FAQ</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl text-balance">
            {content.faqs.length > 0 ? (lang === 'es' ? 'Preguntas Frecuentes sobre la Respiración Wim Hof' : lang === 'de' ? 'Häufig gestellte Fragen zur Wim-Hof-Atmung' : lang === 'fr' ? 'Foire Aux Questions sur la Respiration Wim Hof' : lang === 'pt' ? 'Perguntas Frequentes sobre a Respiração Wim Hof' : lang === 'ja' ? 'ヴィム・ホフ呼吸法に関するよくある質問' : lang === 'it' ? 'Domande Frequenti sulla Respirazione Wim Hof' : 'Frequently Asked Questions About Wim Hof Breathing') : 'Frequently Asked Questions'}
          </h3>
          <p class="text-sm text-neutral-400">
            {lang === 'es' ? 'Respuestas claras sobre la técnica, beneficios y precauciones para tu práctica.' : lang === 'de' ? 'Wichtige Antworten zu Technik, Wirkung und sicherer Durchführung.' : lang === 'fr' ? 'Tout ce qu’il faut savoir pour pratiquer en toute sécurité.' : lang === 'pt' ? 'Tudo o que você precisa saber para praticar com confiança e segurança.' : lang === 'ja' ? '実践方法や効果、安全上の留意点についてお答えします。' : lang === 'it' ? 'Tutto ciò che serve per praticare con consapevolezza e sicurezza.' : 'Everything you need to know about the Wim Hof method, its benefits, and how to practice safely.'}
          </p>
        </div>

        <div class="reveal space-y-4">
          {content.faqs.map((faq, idx) => (
            <details class="group p-6 rounded-2xl border border-neutral-800 bg-neutral-950/60 backdrop-blur-md open:border-cyan-500/30 hover:border-neutral-700 transition-all duration-300" open={idx === 0}>
              <summary class="flex items-center justify-between cursor-pointer list-none text-white font-bold text-base text-pretty">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="mt-4 text-sm text-neutral-300 leading-relaxed">
                <div>
                  <p>{faq.answer}</p>
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduceMotion) {
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach((el) => observer.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('reveal-visible'));
    }
  }
</script>
