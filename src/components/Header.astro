---
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-900 bg-black/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-400 via-blue-600 to-purple-600 p-[1px] shadow-lg shadow-cyan-500/10 group-hover:scale-105 transition-transform duration-300">
        <div class="w-full h-full bg-black rounded-full flex items-center justify-center">
          <svg class="w-4 h-4 text-cyan-400 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-lg tracking-tight text-white flex items-center gap-1.5">
          Harmony<span class="gradient-text-develop">Breath</span>
        </span>
      </div>
    </a>

    <!-- Nav Items -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-neutral-400">
      <a href="/" class="hover:text-white transition-colors duration-200">Home</a>
      <a href="/#techniques" class="hover:text-white transition-colors duration-200">Techniques</a>
      <a href="/wim-hof" class="hover:text-white text-cyan-400 transition-colors duration-200 flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Wim Hof Method
      </a>
      <a href="/#benefits" class="hover:text-white transition-colors duration-200">Benefits & Science</a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-6">
      <!-- Main Audio Volume Control -->
      <div class="relative" id="main-audio-control">
        <button
          id="sound-toggle-btn"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-800 text-xs font-mono text-neutral-300 hover:text-white transition-all"
          title="Audio Volume"
          aria-expanded="false"
          aria-controls="main-volume-slider"
        >
          <svg id="sound-on-icon" class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          </svg>
          <svg id="sound-off-icon" class="w-3.5 h-3.5 text-neutral-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
          </svg>
          <span id="sound-label">Audio</span>
        </button>
        <div
          id="main-volume-slider"
          class="absolute top-full left-1/2 -translate-x-1/2 mt-2 hidden flex-col items-center gap-1.5 bg-neutral-950 border border-neutral-800 rounded-xl p-3 shadow-2xl min-w-[140px] z-50"
          role="group"
          aria-label="Main audio volume"
        >
          <label for="main-volume-input" class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider">Audio Volume</label>
          <input
            type="range"
            id="main-volume-input"
            min="0"
            max="100"
            step="5"
            value="80"
            class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
            aria-label="Main audio volume"
          />
          <div class="flex justify-between text-[10px] text-neutral-500 font-mono w-full">
            <span>0%</span>
            <span id="main-volume-value" class="text-cyan-400 font-bold">80%</span>
            <span>100%</span>
          </div>
        </div>
      </div>

<!-- Breath Sound Volume Control -->
      <div class="relative" id="breath-sound-control">
        <button
          id="breath-sound-toggle-btn"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-800 text-xs font-mono text-neutral-300 hover:text-white transition-all"
          title="Breath Sound Volume"
          aria-expanded="false"
          aria-controls="breath-volume-slider"
        >
          <svg id="breath-sound-on-icon" class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <svg id="breath-sound-off-icon" class="w-3.5 h-3.5 text-neutral-500 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M12 3v2m0 14v2M5 12H3" />
          </svg>
          <span id="breath-sound-label">Breath Sounds</span>
        </button>
        <div
          id="breath-volume-slider"
          class="absolute top-full left-1/2 -translate-x-1/2 mt-2 hidden flex-col items-center gap-1.5 bg-neutral-950 border border-neutral-800 rounded-xl p-3 shadow-2xl min-w-[140px] z-50"
          role="group"
          aria-label="Breath sound volume"
        >
          <label for="breath-volume-input" class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider">Breath Volume</label>
          <input
            type="range"
            id="breath-volume-input"
            min="0"
            max="100"
            step="5"
            value="70"
            class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-amber-400"
            aria-label="Breath sound volume"
          />
          <div class="flex justify-between text-[10px] text-neutral-500 font-mono w-full">
            <span>0%</span>
            <span id="breath-volume-value" class="text-amber-400 font-bold">70%</span>
            <span>100%</span>
          </div>
        </div>
      </div>

      <!-- Choose Music Button -->
      <button
        id="choose-music-btn"
        type="button"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 hover:bg-cyan-500/20 hover:border-cyan-500/50 text-xs font-semibold transition-all"
        aria-label="Choose music for breathing phases"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span>Choose your Music</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { audioPlayer } from '../utils/audioPlayer';

  // Main Audio Volume Control
  const mainAudioControl = document.getElementById('main-audio-control') as HTMLElement | null;
  const mainVolumeBtn = document.getElementById('sound-toggle-btn') as HTMLButtonElement | null;
  const mainVolumeSlider = document.getElementById('main-volume-slider') as HTMLElement | null;
  const mainVolumeInput = document.getElementById('main-volume-input') as HTMLInputElement | null;
  const mainVolumeValue = document.getElementById('main-volume-value') as HTMLElement | null;
  const soundOnIcon = document.getElementById('sound-on-icon') as HTMLElement | null;
  const soundOffIcon = document.getElementById('sound-off-icon') as HTMLElement | null;
  const soundLabel = document.getElementById('sound-label') as HTMLElement | null;

  let mainVolume = parseInt(localStorage.getItem('hb_main_volume') || '80', 10);
  let isMainMuted = mainVolume === 0;

  function updateMainAudioUI() {
    const vol = mainVolume / 100;
    audioPlayer.setVolume(vol);
    audioPlayer.setMuted(isMainMuted);

    if (mainVolumeInput) mainVolumeInput.value = String(mainVolume);
    if (mainVolumeValue) mainVolumeValue.textContent = `${mainVolume}%`;

    if (isMainMuted || mainVolume === 0) {
      soundOnIcon?.classList.add('hidden');
      soundOffIcon?.classList.remove('hidden');
      if (soundLabel) soundLabel.textContent = 'Muted';
    } else {
      soundOnIcon?.classList.remove('hidden');
      soundOffIcon?.classList.add('hidden');
      if (soundLabel) soundLabel.textContent = 'Audio';
    }
  }

  updateMainAudioUI();

  mainVolumeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = mainVolumeBtn.getAttribute('aria-expanded') === 'true';
    mainVolumeBtn?.setAttribute('aria-expanded', String(!isExpanded));
    mainVolumeSlider?.classList.toggle('hidden');
    mainVolumeSlider?.classList.toggle('flex');
  });

  mainVolumeInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    mainVolume = parseInt(target.value, 10);
    isMainMuted = mainVolume === 0;
    localStorage.setItem('hb_main_volume', String(mainVolume));
    updateMainAudioUI();
  });

  // Click outside to close slider
  document.addEventListener('click', (e) => {
    if (!mainAudioControl?.contains(e.target as Node)) {
      mainVolumeSlider?.classList.add('hidden');
      mainVolumeSlider?.classList.remove('flex');
      mainVolumeBtn?.setAttribute('aria-expanded', 'false');
    }
    const breathControl = document.getElementById('breath-sound-control');
    if (!breathControl?.contains(e.target as Node)) {
      document.getElementById('breath-volume-slider')?.classList.add('hidden');
      document.getElementById('breath-volume-slider')?.classList.remove('flex');
      document.getElementById('breath-sound-toggle-btn')?.setAttribute('aria-expanded', 'false');
    }
  });

  // Breath Sound Volume Control
  const breathVolumeBtn = document.getElementById('breath-sound-toggle-btn') as HTMLButtonElement | null;
  const breathVolumeSlider = document.getElementById('breath-volume-slider') as HTMLElement | null;
  const breathVolumeInput = document.getElementById('breath-volume-input') as HTMLInputElement | null;
  const breathVolumeValue = document.getElementById('breath-volume-value') as HTMLElement | null;
  const breathSoundOnIcon = document.getElementById('breath-sound-on-icon') as HTMLElement | null;
  const breathSoundOffIcon = document.getElementById('breath-sound-off-icon') as HTMLElement | null;
  const breathSoundLabel = document.getElementById('breath-sound-label') as HTMLElement | null;

  let breathVolume = parseInt(localStorage.getItem('hb_breath_volume') || '70', 10);
  let isBreathMuted = breathVolume === 0;

  function updateBreathSoundUI() {
    const vol = breathVolume / 100;
    audioPlayer.setBreathSoundVolume(vol);
    audioPlayer.setBreathSoundMuted(isBreathMuted);

    if (breathVolumeInput) breathVolumeInput.value = String(breathVolume);
    if (breathVolumeValue) breathVolumeValue.textContent = `${breathVolume}%`;

    if (isBreathMuted || breathVolume === 0) {
      breathSoundOnIcon?.classList.add('hidden');
      breathSoundOffIcon?.classList.remove('hidden');
      if (breathSoundLabel) breathSoundLabel.textContent = 'Breath Off';
    } else {
      breathSoundOnIcon?.classList.remove('hidden');
      breathSoundOffIcon?.classList.add('hidden');
      if (breathSoundLabel) breathSoundLabel.textContent = 'Breath Sounds';
    }
  }

  updateBreathSoundUI();

  breathVolumeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = breathVolumeBtn.getAttribute('aria-expanded') === 'true';
    breathVolumeBtn?.setAttribute('aria-expanded', String(!isExpanded));
    breathVolumeSlider?.classList.toggle('hidden');
    breathVolumeSlider?.classList.toggle('flex');
  });

  breathVolumeInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    breathVolume = parseInt(target.value, 10);
    isBreathMuted = breathVolume === 0;
    localStorage.setItem('hb_breath_volume', String(breathVolume));
    updateBreathSoundUI();
  });

  // Choose Music Button
  const chooseMusicBtn = document.getElementById('choose-music-btn') as HTMLButtonElement | null;
  chooseMusicBtn?.addEventListener('click', () => {
    if (typeof window.openMusicModal === 'function') {
      window.openMusicModal();
    }
  });
</script>
