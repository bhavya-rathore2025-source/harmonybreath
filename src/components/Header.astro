---
import LanguagePicker from './LanguagePicker.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang: propLang } = Astro.props;
const currentLang = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const homeUrl = currentLang === 'en' ? '/' : `/${currentLang}/`;
const techniquesUrl = currentLang === 'en' ? '/#techniques' : `/${currentLang}/#techniques`;
const aboutUrl = currentLang === 'en' ? '/about/' : `/${currentLang}/about/`;
const contactUrl = currentLang === 'en' ? '/contact/' : `/${currentLang}/contact/`;
---

<header class="sticky top-0 z-50 w-full border-b border-neutral-900 bg-neutral-950/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-amber-400 via-amber-600 to-amber-700 p-[1px] shadow-lg shadow-amber-500/10 group-hover:scale-105 transition-transform duration-300">
        <div class="w-full h-full bg-black rounded-full flex items-center justify-center">
          <svg class="w-4 h-4 text-amber-400 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-lg tracking-tight text-white flex items-center gap-1.5">
          Harmony<span class="text-amber-400">Breath</span>
        </span>
      </div>
    </a>

    <!-- Nav Items -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-neutral-400">
      <a href={homeUrl} class="hover:text-white transition-colors duration-200">{t('nav.home')}</a>
      <a href={techniquesUrl} class="hover:text-white transition-colors duration-200">{t('nav.techniques')}</a>
      <a href={aboutUrl} class="hover:text-white transition-colors duration-200">{t('nav.about')}</a>
      <a href={contactUrl} class="hover:text-white transition-colors duration-200">{t('nav.contact')}</a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-1.5 sm:gap-4 lg:gap-6">
      <!-- Combined Volume Control -->
      <div class="relative" id="volume-control">
        <button
          id="volume-toggle-btn"
          type="button"
          class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-800 text-xs font-mono text-neutral-300 hover:text-white transition-all"
          title="Volume Settings"
          aria-expanded="false"
          aria-controls="volume-slider-panel"
        >
          <svg id="volume-icon" class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          </svg>
          <span id="volume-label" class="hidden sm:inline">Volume</span>
        </button>
        <div
          id="volume-slider-panel"
          class="absolute top-full left-1/2 -translate-x-1/2 mt-2 hidden flex-col gap-3 bg-neutral-950 border border-neutral-800 rounded-xl p-3 shadow-2xl min-w-[180px] z-50"
          role="group"
          aria-label="Volume controls"
        >
          <!-- Audio Volume -->
          <div class="space-y-1">
            <label for="main-volume-input" class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider">Audio Volume</label>
            <input
              type="range"
              id="main-volume-input"
              min="0"
              max="100"
              step="5"
              value="80"
              class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
              aria-label="Main audio volume"
            />
            <div class="flex justify-between text-[10px] text-neutral-500 font-mono w-full">
              <span>0%</span>
              <span id="main-volume-value" class="text-cyan-400 font-bold">80%</span>
              <span>100%</span>
            </div>
          </div>
          <!-- Breath Sound Volume -->
          <div id="breath-volume-section" class="space-y-1">
            <label for="breath-volume-input" class="text-[10px] font-mono text-neutral-400 uppercase tracking-wider">Breath Volume</label>
            <input
              type="range"
              id="breath-volume-input"
              min="0"
              max="100"
              step="5"
              value="70"
              class="w-full h-1.5 bg-neutral-800 rounded-lg appearance-none cursor-pointer accent-amber-400"
              aria-label="Breath sound volume"
            />
            <div class="flex justify-between text-[10px] text-neutral-500 font-mono w-full">
              <span>0%</span>
              <span id="breath-volume-value" class="text-amber-400 font-bold">70%</span>
              <span>100%</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Music Button -->
      <button
        id="choose-music-btn"
        type="button"
        class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-neutral-800 bg-neutral-900/60 hover:bg-neutral-800 text-xs font-mono text-neutral-300 hover:text-white transition-all"
        aria-label="Choose music for breathing phases"
      >
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span class="hidden sm:inline">Music</span>
      </button>

      <!-- Language Picker -->
      <LanguagePicker />
    </div>
  </div>
</header>

<script>
  import { audioPlayer } from '../utils/audioPlayer';

  const hidePages = ['/', '/about', '/contact', '/privacy', '/terms', '/quotes'];
  const rawPath = window.location.pathname;
  const currentPath = rawPath.replace(/\/$/, '') || '/';
  const isHomePage = currentPath === '/' || /^\/(es|de|fr|pt|ja|it)$/.test(currentPath);
  const isHidePage = hidePages.includes(currentPath) || /^\/(es|de|fr|pt|ja|it)\/(about|contact|privacy|terms|quotes)$/.test(currentPath);
  if (isHomePage || isHidePage) {
    const volumeControl = document.getElementById('volume-control');
    const musicBtn = document.getElementById('choose-music-btn');
    if (volumeControl) volumeControl.classList.add('hidden');
    if (musicBtn) musicBtn.classList.add('hidden');
  }

  const isNoBreathSoundPage = currentPath.includes('box-breathing') || currentPath.includes('4-7-8-breathing') || currentPath.includes('diaphragmatic-breathing') || currentPath.includes('nadi-shodhana') || currentPath.includes('physiological-sigh');
  const breathVolumeSection = document.getElementById('breath-volume-section');
  if (isNoBreathSoundPage && breathVolumeSection) {
    breathVolumeSection.classList.add('hidden');
  }

  // Volume Control
  const volumeControl = document.getElementById('volume-control') as HTMLElement | null;
  const volumeBtn = document.getElementById('volume-toggle-btn') as HTMLButtonElement | null;
  const volumePanel = document.getElementById('volume-slider-panel') as HTMLElement | null;
  const volumeLabel = document.getElementById('volume-label') as HTMLElement | null;
  const mainVolumeInput = document.getElementById('main-volume-input') as HTMLInputElement | null;
  const mainVolumeValue = document.getElementById('main-volume-value') as HTMLElement | null;
  const breathVolumeInput = document.getElementById('breath-volume-input') as HTMLInputElement | null;
  const breathVolumeValue = document.getElementById('breath-volume-value') as HTMLElement | null;

  let mainVolume = parseInt(localStorage.getItem('hb_main_volume') || '80', 10);
  let breathVolume = parseInt(localStorage.getItem('hb_breath_volume') || '70', 10);
  let isMainMuted = mainVolume === 0;

  function updateMainAudioUI() {
    const vol = mainVolume / 100;
    audioPlayer.setVolume(vol);
    audioPlayer.setMuted(isMainMuted);

    if (mainVolumeInput) mainVolumeInput.value = String(mainVolume);
    if (mainVolumeValue) mainVolumeValue.textContent = `${mainVolume}%`;

    if (isMainMuted || mainVolume === 0) {
      if (volumeLabel) volumeLabel.textContent = 'Muted';
    } else {
      if (volumeLabel) volumeLabel.textContent = 'Volume';
    }
  }

  function updateBreathSoundUI() {
    const vol = breathVolume / 100;
    audioPlayer.setBreathSoundVolume(vol);
    audioPlayer.setBreathSoundMuted(breathVolume === 0);

    if (breathVolumeInput) breathVolumeInput.value = String(breathVolume);
    if (breathVolumeValue) breathVolumeValue.textContent = `${breathVolume}%`;
  }

  updateMainAudioUI();
  updateBreathSoundUI();

  volumeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = volumeBtn.getAttribute('aria-expanded') === 'true';
    volumeBtn?.setAttribute('aria-expanded', String(!isExpanded));
    volumePanel?.classList.toggle('hidden');
    volumePanel?.classList.toggle('flex');
  });

  mainVolumeInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    mainVolume = parseInt(target.value, 10);
    isMainMuted = mainVolume === 0;
    localStorage.setItem('hb_main_volume', String(mainVolume));
    updateMainAudioUI();
  });

  breathVolumeInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    breathVolume = parseInt(target.value, 10);
    localStorage.setItem('hb_breath_volume', String(breathVolume));
    updateBreathSoundUI();
  });

  // Click outside to close panel
  document.addEventListener('click', (e) => {
    if (!volumeControl?.contains(e.target as Node)) {
      volumePanel?.classList.add('hidden');
      volumePanel?.classList.remove('flex');
      volumeBtn?.setAttribute('aria-expanded', 'false');
    }
  });

  // Choose Music Button
  const chooseMusicBtn = document.getElementById('choose-music-btn') as HTMLButtonElement | null;
  chooseMusicBtn?.addEventListener('click', () => {
    if (typeof (window as any).openMusicModal === 'function') {
      (window as any).openMusicModal();
    }
  });
</script>
