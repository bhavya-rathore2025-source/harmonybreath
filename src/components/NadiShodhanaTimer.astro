---
import NadiCustomSettingsModal from './NadiCustomSettingsModal.astro';
import NadiMusicSelectionModal from './NadiMusicSelectionModal.astro';
---

<section id="nadi-timer-section" class="w-full max-w-4xl mx-auto py-8 px-4">
  <div class="relative w-full bg-neutral-950/80 border border-white/15 rounded-3xl p-6 sm:p-10 shadow-2xl backdrop-blur-2xl overflow-hidden shadow-purple-950/20">
    <!-- Background phase glow -->
    <div id="nadi-phase-glow" class="absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-indigo-500/20 via-transparent to-transparent"></div>

    <!-- Header Status Row -->
    <div class="relative z-10 flex items-center justify-between border-b border-neutral-800/60 pb-6 mb-8">
      <div class="flex items-center gap-3">
        <span id="nadi-preset-badge" class="px-3 py-1 rounded-full text-xs font-mono font-medium border border-indigo-400/30 bg-indigo-400/10 text-indigo-400">
          Beginner 4–4 (19 Cycles)
        </span>
        <span id="nadi-cycle-badge" class="text-xs font-mono text-neutral-400">
          Cycle <span id="nadi-current-cycle-text" class="text-white font-bold">1</span> of <span id="nadi-total-cycles-text" class="text-white font-bold">19</span>
        </span>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-neutral-400">
        <span id="nadi-status-indicator" class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
        <span id="nadi-phase-label" class="uppercase tracking-wider font-semibold text-indigo-400">Ready</span>
      </div>
    </div>

    <!-- Nostril State Indicator Visualizer -->
    <div class="relative z-10 grid grid-cols-2 gap-4 max-w-md mx-auto mb-8">
      <!-- LEFT NOSTRIL CARD -->
      <div id="nadi-left-nostril-card" class="p-4 rounded-2xl border border-neutral-800 bg-neutral-900/60 transition-all duration-500 flex flex-col items-center text-center">
        <div class="flex items-center gap-1.5 mb-2">
          <span class="text-xs font-mono uppercase tracking-wider text-neutral-400">Left Nostril</span>
          <span id="nadi-left-finger-tag" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400">Ring Finger</span>
        </div>
        <div id="nadi-left-status-icon" class="w-12 h-12 rounded-full flex items-center justify-center bg-neutral-800/80 text-neutral-400 transition-all duration-500 mb-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-8-8h16" />
          </svg>
        </div>
        <div id="nadi-left-status-text" class="text-xs font-mono font-bold text-neutral-400">
          Open
        </div>
      </div>

      <!-- RIGHT NOSTRIL CARD -->
      <div id="nadi-right-nostril-card" class="p-4 rounded-2xl border border-neutral-800 bg-neutral-900/60 transition-all duration-500 flex flex-col items-center text-center">
        <div class="flex items-center gap-1.5 mb-2">
          <span class="text-xs font-mono uppercase tracking-wider text-neutral-400">Right Nostril</span>
          <span id="nadi-right-finger-tag" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400">Thumb</span>
        </div>
        <div id="nadi-right-status-icon" class="w-12 h-12 rounded-full flex items-center justify-center bg-neutral-800/80 text-neutral-400 transition-all duration-500 mb-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-8-8h16" />
          </svg>
        </div>
        <div id="nadi-right-status-text" class="text-xs font-mono font-bold text-neutral-400">
          Open
        </div>
      </div>
    </div>

    <!-- Main Breathing Visualizer Circle -->
    <div class="relative z-10 flex flex-col items-center justify-center my-4">
      <div class="relative w-64 h-64 sm:w-72 sm:h-72 flex items-center justify-center">
        <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="44" stroke="currentColor" stroke-width="3" class="text-neutral-900" fill="none" />
          <circle
            id="nadi-progress-circle"
            cx="50"
            cy="50"
            r="44"
            stroke="url(#nadi-gradient-accent)"
            stroke-width="3.5"
            stroke-dasharray="276.46"
            stroke-dashoffset="0"
            stroke-linecap="round"
            class="transition-all duration-300"
            fill="none"
          />
          <defs>
            <linearGradient id="nadi-gradient-accent" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#6366f1" />
              <stop offset="50%" stop-color="#8b5cf6" />
              <stop offset="100%" stop-color="#ec4899" />
            </linearGradient>
          </defs>
        </svg>

        <div id="nadi-breath-halo" class="absolute w-44 h-44 rounded-full bg-gradient-to-tr from-indigo-500/20 via-purple-500/20 to-pink-500/20 transition-transform duration-[4000ms] ease-in-out scale-100 flex items-center justify-center border border-white/5"></div>

        <div class="relative z-20 flex flex-col items-center text-center px-4">
          <div id="nadi-breath-action-text" class="text-xs sm:text-sm font-mono uppercase tracking-widest text-indigo-400 mb-1 font-bold">
            Press Start
          </div>

          <div id="nadi-primary-counter" class="text-5xl sm:text-6xl font-bold tracking-normal font-mono-numbers text-white">
            00:00
          </div>

          <div id="nadi-secondary-counter" class="text-xs font-mono text-neutral-400 mt-2 max-w-[200px] truncate">
            In 4s • Out 4s • No Hold
          </div>
        </div>
      </div>

      <!-- Subtext Instruction Guidance -->
      <div id="nadi-instruction-guidance" class="mt-6 text-center text-xs sm:text-sm text-neutral-300 font-sans bg-neutral-900/60 border border-neutral-800 px-6 py-2.5 rounded-full shadow-inner max-w-lg">
        Sit comfortably upright with your right hand near your nose.
      </div>
    </div>

    <!-- Session Action Buttons -->
    <div class="relative z-10 flex flex-wrap items-center justify-center gap-4 mt-8 pt-6 border-t border-neutral-800/60">
      <button
        id="nadi-btn-main-action"
        type="button"
        class="flex items-center gap-2 px-8 py-3.5 rounded-full bg-indigo-500 text-white font-semibold text-sm hover:bg-indigo-400 transition-all transform active:scale-95 shadow-xl shadow-indigo-500/20"
      >
        <svg id="nadi-icon-play" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="nadi-icon-pause" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <span id="nadi-label-main-action">Start Session</span>
      </button>

      <button
        id="nadi-btn-skip-phase"
        type="button"
        class="hidden flex items-center gap-2 px-6 py-3.5 rounded-full bg-neutral-900 border border-neutral-750 text-neutral-200 hover:text-white hover:bg-neutral-800 text-xs font-mono font-medium transition-all"
      >
        <span id="nadi-label-skip-phase">Skip Step</span>
        <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
        </svg>
      </button>

      <button
        id="nadi-btn-restart"
        type="button"
        class="flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all"
        title="Restart Session"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset</span>
      </button>

      <button
        id="nadi-btn-music"
        type="button"
        class="flex items-center gap-2 px-5 py-3.5 rounded-full bg-neutral-900/80 border border-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-800 text-xs font-mono transition-all"
        title="Soundscape Music"
      >
        <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
        </svg>
        <span>Music</span>
      </button>
    </div>
  </div>

  <NadiCustomSettingsModal />
  <NadiMusicSelectionModal />
</section>

<script>
  import { audioPlayer } from '../utils/audioPlayer';
  import { saveExerciseStats } from '../utils/stats';

  // Config and state
  let config = {
    inhale: 4,
    hold: 0,
    exhale: 4,
    cycles: 19,
    presetName: 'Beginner 4–4'
  };

  type PhaseType = 'left-inhale' | 'hold-1' | 'right-exhale' | 'right-inhale' | 'hold-2' | 'left-exhale' | 'completed' | 'idle';

  let currentPhase: PhaseType = 'idle';
  let currentCycle = 1;
  let elapsedPhaseSec = 0;
  let timerInterval: any = null;
  let isRunning = false;

  // DOM references
  const presetBadge = document.getElementById('nadi-preset-badge');
  const currentCycleText = document.getElementById('nadi-current-cycle-text');
  const totalCyclesText = document.getElementById('nadi-total-cycles-text');
  const phaseLabel = document.getElementById('nadi-phase-label');
  const statusIndicator = document.getElementById('nadi-status-indicator');

  const leftNostrilCard = document.getElementById('nadi-left-nostril-card');
  const rightNostrilCard = document.getElementById('nadi-right-nostril-card');
  const leftStatusIcon = document.getElementById('nadi-left-status-icon');
  const rightStatusIcon = document.getElementById('nadi-right-status-icon');
  const leftStatusText = document.getElementById('nadi-left-status-text');
  const rightStatusText = document.getElementById('nadi-right-status-text');
  const leftFingerTag = document.getElementById('nadi-left-finger-tag');
  const rightFingerTag = document.getElementById('nadi-right-finger-tag');

  const progressCircle = document.getElementById('nadi-progress-circle') as SVGCircleElement | null;
  const breathHalo = document.getElementById('nadi-breath-halo');
  const actionText = document.getElementById('nadi-breath-action-text');
  const primaryCounter = document.getElementById('nadi-primary-counter');
  const secondaryCounter = document.getElementById('nadi-secondary-counter');
  const instructionGuidance = document.getElementById('nadi-instruction-guidance');
  const phaseGlow = document.getElementById('nadi-phase-glow');

  const btnMainAction = document.getElementById('nadi-btn-main-action');
  const iconPlay = document.getElementById('nadi-icon-play');
  const iconPause = document.getElementById('nadi-icon-pause');
  const labelMainAction = document.getElementById('nadi-label-main-action');
  const btnSkipPhase = document.getElementById('nadi-btn-skip-phase');
  const btnRestart = document.getElementById('nadi-btn-restart');
  const btnMusic = document.getElementById('nadi-btn-music');

  const CIRCLE_CIRCUMFERENCE = 276.46;

  function updateNostrilVisuals(leftState: 'open' | 'inhale' | 'exhale' | 'closed', rightState: 'open' | 'inhale' | 'exhale' | 'closed') {
    // Left nostril styling
    if (leftNostrilCard && leftStatusIcon && leftStatusText && leftFingerTag) {
      if (leftState === 'inhale') {
        leftNostrilCard.className = 'p-4 rounded-2xl border-2 border-indigo-400 bg-indigo-500/20 transition-all duration-500 flex flex-col items-center text-center shadow-lg shadow-indigo-500/10 scale-105';
        leftStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-indigo-400 text-black font-bold mb-2 animate-pulse';
        leftStatusIcon.innerHTML = `<svg class="w-6 h-6 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>`;
        leftStatusText.textContent = 'INHALING';
        leftStatusText.className = 'text-xs font-mono font-bold text-indigo-400';
        leftFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-semibold';
      } else if (leftState === 'exhale') {
        leftNostrilCard.className = 'p-4 rounded-2xl border-2 border-emerald-400 bg-emerald-500/20 transition-all duration-500 flex flex-col items-center text-center shadow-lg shadow-emerald-500/10 scale-105';
        leftStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-emerald-400 text-black font-bold mb-2 animate-bounce';
        leftStatusIcon.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>`;
        leftStatusText.textContent = 'EXHALING';
        leftStatusText.className = 'text-xs font-mono font-bold text-emerald-400';
        leftFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-semibold';
      } else if (leftState === 'closed') {
        leftNostrilCard.className = 'p-4 rounded-2xl border border-neutral-800 bg-neutral-950/80 opacity-60 transition-all duration-500 flex flex-col items-center text-center scale-95';
        leftStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-neutral-800 text-red-400 mb-2';
        leftStatusIcon.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;
        leftStatusText.textContent = 'CLOSED (Ring Finger)';
        leftStatusText.className = 'text-xs font-mono font-bold text-red-400';
        leftFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-red-500/20 text-red-300 font-semibold';
      } else {
        leftNostrilCard.className = 'p-4 rounded-2xl border border-neutral-800 bg-neutral-900/60 transition-all duration-500 flex flex-col items-center text-center';
        leftStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-neutral-800/80 text-neutral-400 mb-2';
        leftStatusIcon.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-8-8h16"/></svg>`;
        leftStatusText.textContent = 'Open';
        leftStatusText.className = 'text-xs font-mono font-bold text-neutral-400';
        leftFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400';
      }
    }

    // Right nostril styling
    if (rightNostrilCard && rightStatusIcon && rightStatusText && rightFingerTag) {
      if (rightState === 'inhale') {
        rightNostrilCard.className = 'p-4 rounded-2xl border-2 border-indigo-400 bg-indigo-500/20 transition-all duration-500 flex flex-col items-center text-center shadow-lg shadow-indigo-500/10 scale-105';
        rightStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-indigo-400 text-black font-bold mb-2 animate-pulse';
        rightStatusIcon.innerHTML = `<svg class="w-6 h-6 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>`;
        rightStatusText.textContent = 'INHALING';
        rightStatusText.className = 'text-xs font-mono font-bold text-indigo-400';
        rightFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-semibold';
      } else if (rightState === 'exhale') {
        rightNostrilCard.className = 'p-4 rounded-2xl border-2 border-emerald-400 bg-emerald-500/20 transition-all duration-500 flex flex-col items-center text-center shadow-lg shadow-emerald-500/10 scale-105';
        rightStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-emerald-400 text-black font-bold mb-2 animate-bounce';
        rightStatusIcon.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>`;
        rightStatusText.textContent = 'EXHALING';
        rightStatusText.className = 'text-xs font-mono font-bold text-emerald-400';
        rightFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-semibold';
      } else if (rightState === 'closed') {
        rightNostrilCard.className = 'p-4 rounded-2xl border border-neutral-800 bg-neutral-950/80 opacity-60 transition-all duration-500 flex flex-col items-center text-center scale-95';
        rightStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-neutral-800 text-red-400 mb-2';
        rightStatusIcon.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>`;
        rightStatusText.textContent = 'CLOSED (Thumb)';
        rightStatusText.className = 'text-xs font-mono font-bold text-red-400';
        rightFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-red-500/20 text-red-300 font-semibold';
      } else {
        rightNostrilCard.className = 'p-4 rounded-2xl border border-neutral-800 bg-neutral-900/60 transition-all duration-500 flex flex-col items-center text-center';
        rightStatusIcon.className = 'w-12 h-12 rounded-full flex items-center justify-center bg-neutral-800/80 text-neutral-400 mb-2';
        rightStatusIcon.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-8-8h16"/></svg>`;
        rightStatusText.textContent = 'Open';
        rightStatusText.className = 'text-xs font-mono font-bold text-neutral-400';
        rightFingerTag.className = 'text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-800 text-neutral-400';
      }
    }
  }

  let lastPhase: PhaseType | '' = '';

  function triggerHaloPhaseAnimation(phase: PhaseType) {
    if (!breathHalo) return;
    const dur = getPhaseDuration(phase);

    switch (phase) {
      case 'idle':
        breathHalo.className = 'absolute w-44 h-44 rounded-full bg-gradient-to-tr from-indigo-500/20 via-purple-500/20 to-pink-500/20 flex items-center justify-center border border-white/5';
        breathHalo.style.transitionProperty = 'transform';
        breathHalo.style.transitionDuration = '500ms';
        breathHalo.style.transitionTimingFunction = 'ease-in-out';
        breathHalo.style.transform = 'scale(1.0)';
        break;

      case 'left-inhale':
      case 'right-inhale':
        breathHalo.className = 'absolute w-44 h-44 rounded-full bg-indigo-500/30 flex items-center justify-center border border-indigo-400/20';
        breathHalo.style.transitionProperty = 'transform';
        breathHalo.style.transitionDuration = `${dur * 1000}ms`;
        breathHalo.style.transitionTimingFunction = 'ease-in-out';
        breathHalo.style.transform = 'scale(1.35)';
        break;

      case 'hold-1':
      case 'hold-2':
        breathHalo.className = 'absolute w-44 h-44 rounded-full bg-amber-500/20 flex items-center justify-center border border-amber-400/20';
        breathHalo.style.transitionProperty = 'transform';
        breathHalo.style.transitionDuration = `${dur * 1000}ms`;
        breathHalo.style.transitionTimingFunction = 'ease-in-out';
        breathHalo.style.transform = 'scale(1.35)';
        break;

      case 'right-exhale':
      case 'left-exhale':
        breathHalo.className = 'absolute w-44 h-44 rounded-full bg-emerald-500/30 flex items-center justify-center border border-emerald-400/20';
        breathHalo.style.transitionProperty = 'transform';
        breathHalo.style.transitionDuration = `${dur * 1000}ms`;
        breathHalo.style.transitionTimingFunction = 'ease-in-out';
        breathHalo.style.transform = 'scale(0.85)';
        break;

      case 'completed':
        breathHalo.className = 'absolute w-44 h-44 rounded-full bg-emerald-500/30 flex items-center justify-center border border-emerald-400/30';
        breathHalo.style.transitionProperty = 'transform';
        breathHalo.style.transitionDuration = '700ms';
        breathHalo.style.transitionTimingFunction = 'ease-in-out';
        breathHalo.style.transform = 'scale(1.05)';
        break;
    }
  }

  function updateUI() {
    if (totalCyclesText) totalCyclesText.textContent = String(config.cycles);
    if (currentCycleText) currentCycleText.textContent = String(currentCycle);

    if (currentPhase !== lastPhase) {
      triggerHaloPhaseAnimation(currentPhase);
      lastPhase = currentPhase;
    }

    const timingSummary = config.hold > 0
      ? `In ${config.inhale}s • Hold ${config.hold}s • Out ${config.exhale}s`
      : `In ${config.inhale}s • Out ${config.exhale}s • No Hold`;
    if (secondaryCounter) secondaryCounter.textContent = timingSummary;

    // Progress circle stroke offset
    let totalPhaseDuration = config.inhale;
    if (currentPhase === 'hold-1' || currentPhase === 'hold-2') totalPhaseDuration = config.hold;
    else if (currentPhase === 'right-exhale' || currentPhase === 'left-exhale') totalPhaseDuration = config.exhale;

    const progress = totalPhaseDuration > 0 ? Math.min(1, elapsedPhaseSec / totalPhaseDuration) : 0;
    const dashOffset = CIRCLE_CIRCUMFERENCE * (1 - progress);
    if (progressCircle) {
      progressCircle.style.strokeDashoffset = String(dashOffset);
    }

    // Format counter text (increasing / elapsed time)
    const m = Math.floor(elapsedPhaseSec / 60);
    const s = elapsedPhaseSec % 60;
    if (primaryCounter) {
      primaryCounter.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    // Phase-specific visuals & instructions
    switch (currentPhase) {
      case 'idle':
        if (actionText) actionText.textContent = 'PRESS START';
        if (phaseLabel) phaseLabel.textContent = 'READY';
        if (instructionGuidance) instructionGuidance.textContent = 'Sit comfortably upright with your right hand near your nose.';
        if (phaseGlow) phaseGlow.className = 'absolute inset-0 opacity-20 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-indigo-500/20 via-transparent to-transparent';
        updateNostrilVisuals('open', 'open');
        break;

      case 'left-inhale':
        if (actionText) { actionText.textContent = 'LEFT INHALE'; actionText.className = 'text-xs sm:text-sm font-mono uppercase tracking-widest text-indigo-400 mb-1 font-bold'; }
        if (phaseLabel) { phaseLabel.textContent = 'LEFT INHALE'; phaseLabel.className = 'uppercase tracking-wider font-semibold text-indigo-400'; }
        if (instructionGuidance) instructionGuidance.textContent = '👉 Close right nostril with THUMB. Inhale gently through left nostril.';
        if (phaseGlow) phaseGlow.className = 'absolute inset-0 opacity-30 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-indigo-500/30 via-indigo-900/10 to-transparent';
        updateNostrilVisuals('inhale', 'closed');
        break;

      case 'hold-1':
      case 'hold-2':
        if (actionText) { actionText.textContent = 'HOLD BREATH'; actionText.className = 'text-xs sm:text-sm font-mono uppercase tracking-widest text-amber-400 mb-1 font-bold'; }
        if (phaseLabel) { phaseLabel.textContent = 'RETENTION HOLD'; phaseLabel.className = 'uppercase tracking-wider font-semibold text-amber-400'; }
        if (instructionGuidance) instructionGuidance.textContent = '🔒 Close both nostrils gently with thumb and ring finger.';
        if (phaseGlow) phaseGlow.className = 'absolute inset-0 opacity-30 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-amber-500/20 via-transparent to-transparent';
        updateNostrilVisuals('closed', 'closed');
        break;

      case 'right-exhale':
        if (actionText) { actionText.textContent = 'RIGHT EXHALE'; actionText.className = 'text-xs sm:text-sm font-mono uppercase tracking-widest text-emerald-400 mb-1 font-bold'; }
        if (phaseLabel) { phaseLabel.textContent = 'RIGHT EXHALE'; phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400'; }
        if (instructionGuidance) instructionGuidance.textContent = '👉 Keep left nostril closed with RING FINGER. Exhale through right nostril.';
        if (phaseGlow) phaseGlow.className = 'absolute inset-0 opacity-30 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-emerald-500/30 via-emerald-900/10 to-transparent';
        updateNostrilVisuals('closed', 'exhale');
        break;

      case 'right-inhale':
        if (actionText) { actionText.textContent = 'RIGHT INHALE'; actionText.className = 'text-xs sm:text-sm font-mono uppercase tracking-widest text-indigo-400 mb-1 font-bold'; }
        if (phaseLabel) { phaseLabel.textContent = 'RIGHT INHALE'; phaseLabel.className = 'uppercase tracking-wider font-semibold text-indigo-400'; }
        if (instructionGuidance) instructionGuidance.textContent = '👉 Keep left nostril closed. Inhale gently through right nostril.';
        if (phaseGlow) phaseGlow.className = 'absolute inset-0 opacity-30 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-indigo-500/30 via-indigo-900/10 to-transparent';
        updateNostrilVisuals('closed', 'inhale');
        break;

      case 'left-exhale':
        if (actionText) { actionText.textContent = 'LEFT EXHALE'; actionText.className = 'text-xs sm:text-sm font-mono uppercase tracking-widest text-emerald-400 mb-1 font-bold'; }
        if (phaseLabel) { phaseLabel.textContent = 'LEFT EXHALE'; phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400'; }
        if (instructionGuidance) instructionGuidance.textContent = '👉 Close right nostril with THUMB. Exhale slowly through left nostril.';
        if (phaseGlow) phaseGlow.className = 'absolute inset-0 opacity-30 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-emerald-500/30 via-emerald-900/10 to-transparent';
        updateNostrilVisuals('exhale', 'closed');
        break;

      case 'completed':
        if (actionText) { actionText.textContent = 'SESSION COMPLETE'; actionText.className = 'text-xs sm:text-sm font-mono uppercase tracking-widest text-emerald-400 mb-1 font-bold'; }
        if (phaseLabel) { phaseLabel.textContent = 'FINISHED'; phaseLabel.className = 'uppercase tracking-wider font-semibold text-emerald-400'; }
        if (instructionGuidance) instructionGuidance.textContent = '✨ Wonderful practice! Rest and observe your calm, balanced breathing.';
        if (phaseGlow) phaseGlow.className = 'absolute inset-0 opacity-40 pointer-events-none transition-all duration-1000 bg-gradient-to-b from-emerald-500/40 via-transparent to-transparent';
        updateNostrilVisuals('open', 'open');
        break;
    }
  }

  function playPhaseAudio(phase: PhaseType) {
    if (phase !== 'idle') {
      audioPlayer.playChime();
    }
  }

  function getPhaseDuration(phase: PhaseType): number {
    if (phase === 'left-inhale' || phase === 'right-inhale') return config.inhale;
    if (phase === 'hold-1' || phase === 'hold-2') return config.hold;
    if (phase === 'right-exhale' || phase === 'left-exhale') return config.exhale;
    return 0;
  }

  function advancePhase() {
    elapsedPhaseSec = 0;

    switch (currentPhase) {
      case 'idle':
        currentPhase = 'left-inhale';
        break;

      case 'left-inhale':
        if (config.hold > 0) {
          currentPhase = 'hold-1';
        } else {
          currentPhase = 'right-exhale';
        }
        break;

      case 'hold-1':
        currentPhase = 'right-exhale';
        break;

      case 'right-exhale':
        currentPhase = 'right-inhale';
        break;

      case 'right-inhale':
        if (config.hold > 0) {
          currentPhase = 'hold-2';
        } else {
          currentPhase = 'left-exhale';
        }
        break;

      case 'hold-2':
        currentPhase = 'left-exhale';
        break;

      case 'left-exhale':
        if (currentCycle < config.cycles) {
          currentCycle++;
          currentPhase = 'left-inhale';
        } else {
          currentPhase = 'completed';
          stopTimer();
          saveExerciseStats('nadi-shodhana', { totalRounds: config.cycles });
        }
        break;
    }

    playPhaseAudio(currentPhase);
    updateUI();
  }

  function tick() {
    elapsedPhaseSec++;
    const totalPhaseDuration = getPhaseDuration(currentPhase);
    if (elapsedPhaseSec >= totalPhaseDuration) {
      advancePhase();
    } else {
      updateUI();
    }
  }

  function startTimer() {
    if (isRunning) return;
    isRunning = true;

    if (currentPhase === 'idle' || currentPhase === 'completed') {
      currentCycle = 1;
      currentPhase = 'left-inhale';
      lastPhase = '';
      elapsedPhaseSec = 0;
      playPhaseAudio(currentPhase);
    }

    if (iconPlay) iconPlay.classList.add('hidden');
    if (iconPause) iconPause.classList.remove('hidden');
    if (labelMainAction) labelMainAction.textContent = 'Pause Session';
    if (btnSkipPhase) btnSkipPhase.classList.remove('hidden');
    if (statusIndicator) statusIndicator.className = 'w-2 h-2 rounded-full bg-indigo-400 animate-ping';

    // Start background music if selected
    const savedTrackId = localStorage.getItem('hb_nadi_music_selection');
    if (savedTrackId) {
      audioPlayer.playMusicTrack(savedTrackId);
    }

    updateUI();
    timerInterval = setInterval(tick, 1000);
  }

  function stopTimer() {
    isRunning = false;
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }

    if (iconPlay) iconPlay.classList.remove('hidden');
    if (iconPause) iconPause.classList.add('hidden');
    if (labelMainAction) labelMainAction.textContent = currentPhase === 'completed' ? 'Start Again' : 'Resume Session';
    if (statusIndicator) statusIndicator.className = 'w-2 h-2 rounded-full bg-neutral-600';

    audioPlayer.stop();
  }

  function resetSession() {
    stopTimer();
    currentPhase = 'idle';
    lastPhase = '';
    currentCycle = 1;
    elapsedPhaseSec = 0;
    if (btnSkipPhase) btnSkipPhase.classList.add('hidden');
    if (labelMainAction) labelMainAction.textContent = 'Start Session';
    updateUI();
  }

  // Event Listeners
  btnMainAction?.addEventListener('click', () => {
    if (isRunning) stopTimer();
    else startTimer();
  });

  btnSkipPhase?.addEventListener('click', () => {
    if (isRunning || currentPhase !== 'idle') {
      advancePhase();
    }
  });

  btnRestart?.addEventListener('click', resetSession);

  btnMusic?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('hb_open_nadi_music_modal'));
  });

  window.addEventListener('hb_nadi_preset_changed', (e: any) => {
    const detail = e.detail || {};
    config.inhale = detail.inhale || 4;
    config.hold = detail.hold || 0;
    config.exhale = detail.exhale || 4;
    config.cycles = detail.cycles || 19;
    config.presetName = detail.preset === 'beginner' ? 'Beginner 4–4'
      : detail.preset === 'relaxed' ? 'Relaxed 5–5'
      : detail.preset === 'equal' ? 'Equal Rhythm 6–6'
      : detail.preset === 'retention' ? 'With Retention 4-4-4'
      : 'Custom Rhythm';

    if (presetBadge) presetBadge.textContent = `${config.presetName} (${config.cycles} Cycles)`;
    resetSession();
  });

  // Initial UI Render
  updateUI();
</script>
