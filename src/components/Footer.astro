---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

interface Props {
  lang?: SupportedLanguage;
}

const { lang: propLang } = Astro.props;
const currentLang = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const homeUrl = currentLang === 'en' ? '/' : `/${currentLang}/`;
const techniquesUrl = currentLang === 'en' ? '/#techniques' : `/${currentLang}/#techniques`;
const aboutUrl = currentLang === 'en' ? '/about/' : `/${currentLang}/about/`;
---

<footer class="relative z-10 w-full border-t border-white/10 bg-neutral-950/90 backdrop-blur-xl py-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/10">
      <a href={homeUrl} class="flex items-center gap-2 group">
        <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-amber-400 via-amber-600 to-amber-700 p-[1px] group-hover:scale-105 transition-transform">
          <div class="w-full h-full bg-black rounded-full flex items-center justify-center">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          </div>
        </div>
        <span class="font-bold text-white text-base">Harmony<span class="text-amber-400">Breath</span></span>
      </a>

      <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-neutral-300 font-mono">
        <a href={homeUrl} class="hover:text-white transition-colors">{t('nav.home')}</a>
        <a href={techniquesUrl} class="hover:text-white transition-colors">{t('nav.techniques')}</a>
        <a href={aboutUrl} class="hover:text-white transition-colors">{t('nav.about')}</a>
        <a href="/contact/" class="hover:text-white transition-colors">{t('nav.contact')}</a>
        <a href="/privacy/" class="hover:text-white transition-colors">Privacy</a>
        <a href="/terms/" class="hover:text-white transition-colors">Terms</a>
      </div>

      <div class="text-xs font-mono text-neutral-400">
        harmonybreath.com
      </div>
    </div>

    <div class="pt-8 text-center text-xs font-mono text-neutral-400 space-y-2">
      <p class="text-neutral-300 font-medium">© {new Date().getFullYear()} HarmonyBreath Platform. Educational & Wellness Tool Only.</p>
      <p class="max-w-2xl mx-auto text-neutral-400 font-light">Not intended to diagnose, treat, cure, or prevent any medical condition. Always practice safely sitting or lying down.</p>
      <div class="flex items-center justify-center gap-4 pt-2 text-xs">
        <a href="/privacy/" class="text-neutral-300 hover:text-white transition-colors underline underline-offset-4">Privacy Policy</a>
        <span class="text-neutral-600">|</span>
        <a href="/terms/" class="text-neutral-300 hover:text-white transition-colors underline underline-offset-4">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>
