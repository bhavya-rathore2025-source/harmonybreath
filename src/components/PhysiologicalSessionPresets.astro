const t = presetsI18n[lang] || presetsI18n.en;
---

<div class="w-full max-w-4xl mx-auto mb-8 px-4">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
    <div>
      <h3 class="text-sm font-mono text-emerald-400 uppercase tracking-widest font-semibold">{t.title}</h3>
      <p class="text-xs text-neutral-400 break-words">{t.desc}</p>
    </div>
    <button
      id="sigh-custom-settings-btn"
      type="button"
      class="flex items-center gap-1.5 px-3.5 py-2 rounded-lg border border-neutral-800 bg-neutral-900/80 hover:bg-neutral-800 text-xs font-medium text-neutral-300 hover:text-white transition-colors shrink-0"
    >
      <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
      </svg>
      <span>{t.customBtn}</span>
    </button>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
    <!-- Preset 1: Quick Reset (3-1-6, 10 cycles) -->
    <button
      data-sigh-preset="quick"
      data-preset-name={t.quickReset}
      data-inhale1="3"
      data-inhale2="1"
      data-exhale="6"
      data-cycles="10"
      class="sigh-preset-btn group relative p-4 rounded-xl border border-emerald-500/50 bg-emerald-500/10 text-left transition-all duration-200 focus:outline-none col-span-1"
    >
      <div class="text-xs font-mono text-emerald-400 mb-1 truncate">{t.quickReset}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">3-1-6</div>
      <div class="text-[11px] text-neutral-400 mt-1 break-words">{t.quickResetMeta}</div>
    </button>

    <!-- Preset 2: Relaxation (4-1-7, 15 cycles) -->
    <button
      data-sigh-preset="relax"
      data-preset-name={t.relaxation}
      data-inhale1="4"
      data-inhale2="1"
      data-exhale="7"
      data-cycles="15"
      class="sigh-preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-emerald-500/40 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none col-span-1"
    >
      <div class="text-xs font-mono text-cyan-400 mb-1 truncate">{t.relaxation}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">4-1-7</div>
      <div class="text-[11px] text-neutral-400 mt-1 break-words">{t.relaxationMeta}</div>
    </button>

    <!-- Preset 3: Gentle (3-1-5, 12 cycles) -->
    <button
      data-sigh-preset="gentle"
      data-preset-name={t.gentle}
      data-inhale1="3"
      data-inhale2="1"
      data-exhale="5"
      data-cycles="12"
      class="sigh-preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-emerald-500/40 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none col-span-1"
    >
      <div class="text-xs font-mono text-teal-400 mb-1 truncate">{t.gentle}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">3-1-5</div>
      <div class="text-[11px] text-neutral-400 mt-1 break-words">{t.gentleMeta}</div>
    </button>

    <!-- Preset 4: 5-Min Protocol (4-1-7, 25 cycles) -->
    <button
      data-sigh-preset="protocol"
      data-preset-name={t.protocol}
      data-inhale1="4"
      data-inhale2="1"
      data-exhale="7"
      data-cycles="25"
      class="sigh-preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-emerald-500/40 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none col-span-1"
    >
      <div class="text-xs font-mono text-purple-400 mb-1 truncate">{t.protocol}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers">4-1-7</div>
      <div class="text-[11px] text-neutral-400 mt-1 break-words">{t.protocolMeta}</div>
    </button>

    <!-- Custom -->
    <button
      data-sigh-preset="custom"
      data-preset-name={t.custom}
      data-inhale1="3"
      data-inhale2="1"
      data-exhale="6"
      data-cycles="10"
      class="sigh-preset-btn group relative p-4 rounded-xl border border-neutral-800 bg-neutral-950/60 hover:border-emerald-500/40 hover:bg-neutral-900/60 text-left transition-all duration-200 focus:outline-none col-span-2 sm:col-span-1"
    >
      <div class="text-xs font-mono text-amber-400 mb-1 truncate">{t.custom}</div>
      <div class="text-2xl font-bold text-white font-mono-numbers flex items-center gap-1">
        <svg class="w-6 h-6 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div class="text-[11px] text-neutral-400 mt-1 break-words">{t.customMeta}</div>
    </button>
  </div>
</div>
