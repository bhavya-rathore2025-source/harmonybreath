---
import type { SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;

const presetsI18n: Record<SupportedLanguage, {
  title: string;
  desc: string;
  customBtn: string;
  quickReset: string;
  quickResetMeta: string;
  relaxation: string;
  relaxationMeta: string;
  gentle: string;
  gentleMeta: string;
  protocol: string;
  protocolMeta: string;
  custom: string;
  customMeta: string;
}> = {
  en: {
    title: 'Session Presets',
    desc: 'Select preset timings & duration for your Physiological Sigh session based on your goals.',
    customBtn: 'Custom Timing & Cycles',
    quickReset: 'Quick Reset',
    quickResetMeta: '10 cycles • ~1m 40s',
    relaxation: 'Relaxation',
    relaxationMeta: '15 cycles • ~3m 00s',
    gentle: 'Gentle',
    gentleMeta: '12 cycles • ~1m 48s',
    protocol: '5-Min Protocol',
    protocolMeta: '25 cycles • ~5m 00s',
    custom: 'Custom',
    customMeta: 'Custom timing & cycles',
  },
  es: {
    title: 'Modos de Sesión',
    desc: 'Selecciona tiempos y duración predeterminados para tu sesión de Suspiro Fisiológico.',
    customBtn: 'Tiempos y Ciclos Personalizados',
    quickReset: 'Reseteo Rápido',
    quickResetMeta: '10 ciclos • ~1m 40s',
    relaxation: 'Relajación',
    relaxationMeta: '15 ciclos • ~3m 00s',
    gentle: 'Suave',
    gentleMeta: '12 ciclos • ~1m 48s',
    protocol: 'Protocolo 5 Min',
    protocolMeta: '25 ciclos • ~5m 00s',
    custom: 'Personalizado',
    customMeta: 'Tiempos y ciclos a medida',
  },
  de: {
    title: 'Sitzungs-Voreinstellungen',
    desc: 'Wähle Rhythmus und Dauer für deinen Physiologischen Seufzer passend zu deinen Zielen.',
    customBtn: 'Individuelle Zeiten & Zyklen',
    quickReset: 'Schnell-Reset',
    quickResetMeta: '10 Zyklen • ~1m 40s',
    relaxation: 'Entspannung',
    relaxationMeta: '15 Zyklen • ~3m 00s',
    gentle: 'Sanft',
    gentleMeta: '12 Zyklen • ~1m 48s',
    protocol: '5-Min-Protokoll',
    protocolMeta: '25 Zyklen • ~5m 00s',
    custom: 'Benutzerdefiniert',
    customMeta: 'Individuelle Zeiten & Zyklen',
  },
  fr: {
    title: 'Préréglages de Séance',
    desc: 'Choisissez les temps et la durée pour votre séance de Soupir Physiologique selon vos besoins.',
    customBtn: 'Temps et Cycles Personnalisés',
    quickReset: 'Reset Rapide',
    quickResetMeta: '10 cycles • ~1m 40s',
    relaxation: 'Relaxation',
    relaxationMeta: '15 cycles • ~3m 00s',
    gentle: 'Doux',
    gentleMeta: '12 cycles • ~1m 48s',
    protocol: 'Protocole 5 Min',
    protocolMeta: '25 cycles • ~5m 00s',
    custom: 'Personnalisé',
    customMeta: 'Rythme et cycles sur-mesure',
  },
  pt: {
    title: 'Modos de Sessão',
    desc: 'Selecione tempos e duração para sua sessão de Suspiro Fisiológico com base em seus objetivos.',
    customBtn: 'Tempos e Ciclos Personalizados',
    quickReset: 'Reset Rápido',
    quickResetMeta: '10 ciclos • ~1m 40s',
    relaxation: 'Relaxamento',
    relaxationMeta: '15 ciclos • ~3m 00s',
    gentle: 'Suave',
    gentleMeta: '12 ciclos • ~1m 48s',
    protocol: 'Protocolo 5 Min',
    protocolMeta: '25 ciclos • ~5m 00s',
    custom: 'Personalizado',
    customMeta: 'Tempos e ciclos à sua escolha',
  },
  ja: {
    title: 'セッションプリセット',
    desc: '目的に応じた「生理的ため息」の呼吸リズムとサイクル数を選択してください。',
    customBtn: '秒数・サイクルのカスタム設定',
    quickReset: 'クイックリセット',
    quickResetMeta: '10サイクル • 約1分40秒',
    relaxation: 'リラクゼーション',
    relaxationMeta: '15サイクル • 約3分00秒',
    gentle: 'ジェントル（穏やか）',
    gentleMeta: '12サイクル • 約1分48秒',
    protocol: '5分間プロトコル',
    protocolMeta: '25サイクル • 約5分00秒',
    custom: 'カスタム',
    customMeta: '秒数とサイクルを自由設定',
  },
  it: {
    title: 'Predefiniti di Sessione',
    desc: 'Scegli tempi e durata preimpostati per la tua sessione di Sospiro Fisiologico.',
    customBtn: 'Tempi e Cicli Personalizzati',
    quickReset: 'Reset Rapido',
    quickResetMeta: '10 cicli • ~1m 40s',
    relaxation: 'Rilassamento',
    relaxationMeta: '15 cicli • ~3m 00s',
